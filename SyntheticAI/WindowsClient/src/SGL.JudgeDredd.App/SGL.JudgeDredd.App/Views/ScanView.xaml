<UserControl x:Class="SGL.JudgeDredd.App.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:enums="clr-namespace:SGL.JudgeDredd.Core.Enums;assembly=SGL.JudgeDredd.Core"
             xmlns:loc="clr-namespace:SGL.JudgeDredd.Shared.Localization;assembly=SGL.JudgeDredd.Shared"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page title -->
        <TextBlock Grid.Row="0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[scan.title]}"
                   Style="{StaticResource HeadingTextStyle}"
                   Margin="0,0,0,20"/>

        <!-- Controls row -->
        <Border Grid.Row="1" Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16">
            <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Scan Type:"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>

                <ComboBox Grid.Column="1"
                          SelectedItem="{Binding SelectedScanType}"
                          VerticalAlignment="Center">
                    <enums:ScanType>Quick</enums:ScanType>
                    <enums:ScanType>Extended</enums:ScanType>
                    <enums:ScanType>Custom</enums:ScanType>
                </ComboBox>

                <CheckBox Grid.Column="2" Content="Scan with LLM"
                          IsChecked="{Binding UseLlmScan}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          VerticalAlignment="Center" Margin="16,0,0,0"
                          ToolTip="Enable AI-powered deep threat analysis using the local LLM model. Files are scanned normally plus analyzed by the LLM for suspicious behavior patterns."/>

                <Button Grid.Column="4"
                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[scan.start]}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding StartScanCommand}"
                        Margin="0,0,8,0"/>

                <Button Grid.Column="5"
                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[scan.stop]}"
                        Style="{StaticResource DangerButtonStyle}"
                        Command="{Binding StopScanCommand}"/>
            </Grid>

            <!-- Extended Scan folder picker -->
            <Border Margin="0,12,0,0"
                    Visibility="{Binding IsExtendedScanSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Additional Folders to Scan (Extended mode scans Quick Scan paths + these folders):"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ListBox Grid.Column="0" ItemsSource="{Binding ExtendedScanFolders}"
                                 MaxHeight="120" MinHeight="40"
                                 Background="{StaticResource CardBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="X" FontSize="10" Width="22" Height="22"
                                                Style="{StaticResource DangerButtonStyle}" Margin="8,0,0,0"
                                                Command="{Binding DataContext.RemoveExtendedFolderCommand,
                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Grid.Column="1" Content="Add Folder" Margin="8,0,0,0"
                                Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Top"
                                Command="{Binding AddExtendedFolderCommand}" Width="100"/>
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>
        </Border>

        <!-- Progress section -->
        <Border Grid.Row="2" Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding CurrentFile}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Column="1"
                               Foreground="{StaticResource SecondaryBrush}"
                               FontSize="12">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0:F1}% ({1}/{2})">
                                <Binding Path="ProgressPercent"/>
                                <Binding Path="ScannedFiles"/>
                                <Binding Path="TotalFiles"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>

                <ProgressBar Value="{Binding ProgressPercent}"
                             Maximum="100" Height="10"
                             Foreground="{StaticResource PrimaryBrush}"/>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[common.status]}" Style="{StaticResource SecondaryTextStyle}"/>
                        <TextBlock Text="{Binding ScanStatus}"
                                   Foreground="{StaticResource SecondaryBrush}"
                                   FontWeight="SemiBold" FontSize="12"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Scanned: " Style="{StaticResource SecondaryTextStyle}"/>
                        <TextBlock Text="{Binding ScannedFiles}"
                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[scan.threatsFound]}" Style="{StaticResource SecondaryTextStyle}"/>
                        <TextBlock Text="{Binding ThreatsFound}"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontWeight="Bold" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Real-time scanned files list (visible during scan) -->
        <Border Grid.Row="3" Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16"
                MaxHeight="160"
                Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Files Being Scanned" Style="{StaticResource SubheadingTextStyle}" Margin="0,0,0,8"/>
                <ListBox ItemsSource="{Binding RecentScannedFiles}"
                         Background="Transparent"
                         BorderThickness="0"
                         MaxHeight="120"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" FontFamily="Consolas"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Section label -->
        <TextBlock Grid.Row="4" Text="Scan Results"
                   Style="{StaticResource SubheadingTextStyle}"
                   Margin="0,0,0,8"/>

        <!-- Results DataGrid -->
        <DataGrid Grid.Row="5"
                  ItemsSource="{Binding Results}"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.CanContentScroll="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File Name" Binding="{Binding FileName}"
                                    Width="200"/>
                <DataGridTextColumn Header="File Path" Binding="{Binding FilePath}"
                                    Width="*"/>
                <DataGridTextColumn Header="Threat" Binding="{Binding ThreatName}"
                                    Width="140"/>
                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}"
                                    Width="80"/>
                <DataGridTextColumn Header="Detection" Binding="{Binding DetectionMethod}"
                                    Width="100"/>
                <DataGridTextColumn Header="Score" Binding="{Binding HeuristicScore, StringFormat='{}{0:F2}'}"
                                    Width="60"/>
                <DataGridTemplateColumn Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[common.actions]}" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[nav.quarantine]}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="8,2" FontSize="11"
                                        Command="{Binding DataContext.QuarantineCommand,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,4,0"/>
                                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[common.delete]}"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Padding="8,2" FontSize="11"
                                        Command="{Binding DataContext.DeleteThreatCommand,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,4,0"/>
                                <Button Content="Ignore"
                                        Padding="8,2" FontSize="11"
                                        Command="{Binding DataContext.IgnoreThreatCommand,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- POST-SCAN ACTION WINDOW OVERLAY                            -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="7" Panel.ZIndex="100"
              Visibility="{Binding IsPostScanWindowVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!-- Semi-transparent backdrop -->
            <Border Background="#CC000000" />

            <!-- Action window -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    BorderThickness="1" CornerRadius="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="700" MaxWidth="900" MaxHeight="500"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Content="X"
                                Style="{StaticResource IconButtonStyle}"
                                Width="32" Height="32" FontSize="14" FontWeight="Bold"
                                Foreground="{StaticResource DangerBrush}"
                                Command="{Binding DismissPostScanWindowCommand}"/>
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[scan.complete]}"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource DangerBrush}"/>
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                       Margin="0,4,0,0">
                                <Run Text="Select an action for each threat. You can also close this window and manage threats in the results table."/>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>

                    <!-- Threat list -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBrush}"
                                            CornerRadius="4" Padding="12,8" Margin="0,0,0,8"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1">
                                        <DockPanel>
                                            <!-- Action buttons on the right -->
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[common.delete]}"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Padding="10,4" FontSize="11" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.DeleteThreatCommand,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Ignore"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="10,4" FontSize="11" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.IgnoreThreatCommand,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Monitor"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="10,4" FontSize="11" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.WatchWithAiCommand,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[nav.quarantine]}"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Padding="10,4" FontSize="11"
                                                        Command="{Binding DataContext.QuarantineThreatCommand,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>

                                            <!-- Threat info on the left -->
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FilePath}" FontSize="12"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                                                <TextBlock FontSize="11" Margin="0,2,0,0"
                                                           Foreground="{StaticResource WarningBrush}">
                                                    <Run Text="{Binding ThreatName, Mode=OneWay}"/>
                                                    <Run Text=" — "/>
                                                    <Run Text="{Binding Severity, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="2" Margin="0,12,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[common.close]}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="20,6" FontSize="12"
                                    Command="{Binding DismissPostScanWindowCommand}"/>
                            <TextBlock VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="{Binding Results.Count, Mode=OneWay}"/>
                                <Run Text=" threat(s) detected"/>
                            </TextBlock>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
