<UserControl x:Class="SGL.JudgeDredd.App.Views.YaraRuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SGL.JudgeDredd.App.ViewModels"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1100"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- HEADER                                                         -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="20"
                            Background="{StaticResource SecondaryBrush}" Margin="0,0,12,0">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="YARA Rule Engine" Style="{StaticResource HeadingTextStyle}"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Pattern-matching engine active" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Import" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ImportRulesCommand}" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="Export" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ExportRulesCommand}" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="+ New Rule" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding NewRuleCommand}" Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- STATS BAR                                                      -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,16">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                <StackPanel HorizontalAlignment="Center" Margin="8">
                    <TextBlock Text="TOTAL RULES" FontSize="10"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalRules}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="4,0">
                <StackPanel HorizontalAlignment="Center" Margin="8">
                    <TextBlock Text="ENABLED" FontSize="10"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding EnabledRules}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="4,0">
                <StackPanel HorizontalAlignment="Center" Margin="8">
                    <TextBlock Text="MATCHES" FontSize="10"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalMatches}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
                <StackPanel HorizontalAlignment="Center" Margin="8">
                    <TextBlock Text="LAST SCAN" FontSize="10"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding LastScanTime}" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource SecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- MAIN CONTENT: RULE LIST (left) + EDITOR (right)               -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─── RULE LIST (LEFT PANEL) ────────────────────────────── -->
            <Border Grid.Column="0" Style="{StaticResource SurfaceBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Rules" Style="{StaticResource SubheadingTextStyle}" Margin="0,0,0,8"/>

                    <!-- Search box -->
                    <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" FontSize="12" Margin="0,0,0,8"
                             Background="{StaticResource CardBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}"/>

                    <!-- Rule items -->
                    <ListBox Grid.Row="2" x:Name="RuleList"
                             ItemsSource="{Binding Rules}"
                             SelectedItem="{Binding SelectedRule}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:YaraRule}">
                                <Border Background="{StaticResource CardBrush}"
                                        CornerRadius="{StaticResource DefaultCornerRadius}"
                                        Padding="10,8" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <!-- Rule name -->
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="170"/>

                                                <!-- Severity badge -->
                                                <Border Padding="5,1" CornerRadius="3" Margin="6,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="High">
                                                                    <Setter Property="Background" Value="#FFFF6D00"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Medium">
                                                                    <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Low">
                                                                    <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                                    <Setter Property="Background" Value="{StaticResource TextSecondaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Severity}" FontSize="9" FontWeight="Bold"
                                                               Foreground="White"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Description -->
                                            <TextBlock Text="{Binding Description}" FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="220"/>

                                            <!-- Match count -->
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="Matches: "/><Run Text="{Binding MatchCount, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Right side: enabled checkbox + edit button -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding IsEnabled}" ToolTip="Enable/Disable"
                                                      Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                            <Button Content="Edit" Padding="6,2" FontSize="10"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding DataContext.EditRuleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ─── RULE EDITOR (RIGHT PANEL) ─────────────────────────── -->
            <Border Grid.Column="2" Style="{StaticResource SurfaceBorderStyle}">
                <Grid>
                    <!-- Placeholder when not editing -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="Select a rule to edit, or create a new one."
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Editor panel -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="4">
                            <TextBlock Text="Rule Editor" Style="{StaticResource SubheadingTextStyle}" Margin="0,0,0,12"/>

                            <!-- Validation error -->
                            <Border Background="#33FF1744" CornerRadius="{StaticResource DefaultCornerRadius}"
                                    Padding="10,6" Margin="0,0,0,10"
                                    BorderBrush="{StaticResource DangerBrush}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditorValidation}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding EditorValidation}" FontSize="11"
                                           Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Rule name -->
                            <TextBlock Text="Rule Name" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="12" Margin="0,0,0,10"
                                     FontFamily="Consolas"
                                     Background="{StaticResource CardBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"/>

                            <!-- Description -->
                            <TextBlock Text="Description" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditorDescription, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"
                                     AcceptsReturn="False" MinHeight="40"
                                     Background="{StaticResource CardBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"/>

                            <!-- Author + Severity row -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Author" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditorAuthor, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8,6" FontSize="12"
                                             Background="{StaticResource CardBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Severity" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding SeverityValues}"
                                              SelectedItem="{Binding EditorSeverity}" FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <!-- Tags -->
                            <TextBlock Text="Tags (space-separated)" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditorTags, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="12" Margin="0,0,0,12"
                                     Background="{StaticResource CardBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"/>

                            <!-- ─── STRINGS SECTION ─────────────────────── -->
                            <Border Background="{StaticResource CardBrush}"
                                    CornerRadius="{StaticResource DefaultCornerRadius}"
                                    Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Strings" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Button Content="+ Add String" Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding AddStringCommand}"
                                                Padding="8,3" FontSize="10" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding EditorStrings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:YaraStringEntry}">
                                                <Border Background="{StaticResource SurfaceBrush}"
                                                        CornerRadius="{StaticResource DefaultCornerRadius}"
                                                        Padding="8,6" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Row 1: Identifier, Type, Value -->
                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="70"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBox Grid.Column="0"
                                                                     Text="{Binding Identifier, UpdateSourceTrigger=PropertyChanged}"
                                                                     FontFamily="Consolas" FontSize="11" Padding="4,3"
                                                                     Margin="0,0,4,0"
                                                                     Background="{StaticResource CardBrush}"
                                                                     Foreground="{StaticResource SecondaryBrush}"/>

                                                            <ComboBox Grid.Column="1"
                                                                      ItemsSource="{Binding DataContext.StringTypeValues, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      SelectedItem="{Binding Type}"
                                                                      FontSize="11" Margin="0,0,4,0"/>

                                                            <TextBox Grid.Column="2"
                                                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                     FontFamily="Consolas" FontSize="11" Padding="4,3"
                                                                     Margin="0,0,4,0"
                                                                     Background="{StaticResource CardBrush}"
                                                                     Foreground="{StaticResource TextPrimaryBrush}"/>

                                                            <Button Grid.Column="3" Content="X" Padding="4,2" FontSize="9"
                                                                    Command="{Binding DataContext.RemoveStringCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </Grid>

                                                        <!-- Row 2: Options (nocase, wide, ascii) -->
                                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                                            <CheckBox Content="nocase" IsChecked="{Binding IsNocase}"
                                                                      FontSize="10" Margin="0,0,12,0"
                                                                      Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <CheckBox Content="wide" IsChecked="{Binding IsWide}"
                                                                      FontSize="10" Margin="0,0,12,0"
                                                                      Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <CheckBox Content="ascii" IsChecked="{Binding IsAscii}"
                                                                      FontSize="10"
                                                                      Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- ─── CONDITION SECTION ───────────────────── -->
                            <Border Background="{StaticResource CardBrush}"
                                    CornerRadius="{StaticResource DefaultCornerRadius}"
                                    Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Condition" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>

                                    <TextBox Text="{Binding EditorCondition, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas" FontSize="12" Padding="8,6" Margin="0,0,0,8"
                                             Background="{StaticResource SurfaceBrush}"
                                             Foreground="{StaticResource SecondaryBrush}"/>

                                    <TextBlock Text="Presets:" FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <WrapPanel>
                                        <Button Content="any of them" FontSize="10" Padding="8,3" Margin="0,0,6,4"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding SetConditionCommand}" CommandParameter="any of them"/>
                                        <Button Content="all of them" FontSize="10" Padding="8,3" Margin="0,0,6,4"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding SetConditionCommand}" CommandParameter="all of them"/>
                                        <Button Content="2 of them" FontSize="10" Padding="8,3" Margin="0,0,6,4"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding SetConditionCommand}" CommandParameter="2 of them"/>
                                        <Button Content="3 of them" FontSize="10" Padding="8,3" Margin="0,0,6,4"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding SetConditionCommand}" CommandParameter="3 of them"/>
                                        <Button Content="$s1 and $s2" FontSize="10" Padding="8,3" Margin="0,0,6,4"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding SetConditionCommand}" CommandParameter="$s1 and $s2"/>
                                        <Button Content="$s1 or $s2" FontSize="10" Padding="8,3" Margin="0,0,6,4"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding SetConditionCommand}" CommandParameter="$s1 or $s2"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- ─── ACTION BUTTONS ──────────────────────── -->
                            <Grid Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Content="Save Rule" Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding SaveRuleCommand}" Padding="14,7" Margin="0,0,8,0"/>
                                    <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding CancelEditCommand}" Padding="14,7"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" Padding="14,7"
                                        Command="{Binding DeleteRuleCommand}"
                                        CommandParameter="{Binding SelectedRule}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EditorIsNew}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="Delete Rule" Foreground="{StaticResource DangerBrush}" FontSize="13" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- TEST SECTION                                                   -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Test Rules" Style="{StaticResource SubheadingTextStyle}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding TestFilePath, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" FontSize="12" Margin="0,0,8,0"
                             Background="{StaticResource CardBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}"/>

                    <Button Grid.Column="1" Content="Test Selected" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding TestRuleCommand}" Padding="12,6" Margin="0,0,8,0" FontSize="12"/>
                    <Button Grid.Column="2" Content="Test All Rules" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding TestAllRulesCommand}" Padding="12,6" FontSize="12"/>
                </Grid>

                <!-- Test result display -->
                <Border Background="{StaticResource CardBrush}"
                        CornerRadius="{StaticResource DefaultCornerRadius}"
                        Padding="10,8" Margin="0,8,0,0"
                        MinHeight="30">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TestResult}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding TestResult}" FontFamily="Consolas" FontSize="11"
                               Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- LOG                                                            -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}"
                CornerRadius="{StaticResource DefaultCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Engine Log" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="12,8,0,4"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding Log}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="4,1"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
