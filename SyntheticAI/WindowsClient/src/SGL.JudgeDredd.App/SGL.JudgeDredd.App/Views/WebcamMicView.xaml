<UserControl x:Class="SGL.JudgeDredd.App.Views.WebcamMicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="900"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SuspiciousRowStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSuspicious}" Value="True">
                    <Setter Property="Background" Value="#33FF4444"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAllowed}" Value="True">
                    <Setter Property="Background" Value="#1A00CC66"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AccessStatus}" Value="Blocked">
                    <Setter Property="Background" Value="#33FF8800"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======== Row 0: Header ======== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="20"
                        Background="{StaticResource PrimaryBrush}" Margin="0,0,12,0">
                    <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Webcam &amp; Microphone Protection"
                               Style="{StaticResource HeadingTextStyle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WebcamProtectionEnabled}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding MonitorStatus}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <Button Content="Refresh" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding RefreshCommand}" Padding="16,8"
                    HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- ======== Row 1: Protection Toggles + Webcam Control ======== -->
        <Border Grid.Row="1" Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Webcam Protection Toggle -->
                <Border Grid.Column="0" Padding="16,10"
                        Background="{StaticResource CardBrush}"
                        CornerRadius="{StaticResource DefaultCornerRadius}" Margin="0,0,6,0">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Webcam Protection" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock FontSize="11" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="DISABLED"/>
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WebcamProtectionEnabled}" Value="True">
                                                <Setter Property="Text" Value="ENABLED"/>
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <ToggleButton IsChecked="{Binding WebcamProtectionEnabled, Mode=OneWay}"
                                      Command="{Binding ToggleWebcamProtectionCommand}"
                                      HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Margin="0,2,0,0"/>
                    </Grid>
                </Border>

                <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource SurfaceBrush}" Margin="6,4"/>

                <!-- Microphone Protection Toggle -->
                <Border Grid.Column="2" Padding="16,10"
                        Background="{StaticResource CardBrush}"
                        CornerRadius="{StaticResource DefaultCornerRadius}" Margin="6,0,6,0">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Microphone Protection" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock FontSize="11" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="DISABLED"/>
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MicProtectionEnabled}" Value="True">
                                                <Setter Property="Text" Value="ENABLED"/>
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <ToggleButton IsChecked="{Binding MicProtectionEnabled, Mode=OneWay}"
                                      Command="{Binding ToggleMicProtectionCommand}"
                                      HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Margin="0,2,0,0"/>
                    </Grid>
                </Border>

                <Rectangle Grid.Column="3" Width="1" Fill="{StaticResource SurfaceBrush}" Margin="6,4"/>

                <!-- Webcam Hardware On/Off -->
                <Border Grid.Column="4" Padding="16,10"
                        Background="{StaticResource CardBrush}"
                        CornerRadius="{StaticResource DefaultCornerRadius}" Margin="6,0,0,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8B8;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Webcam Hardware" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Button Padding="12,4" FontSize="11" Margin="0,4,0,0"
                                Command="{Binding ToggleWebcamDeviceCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Setter Property="Content" Value="Disable Webcam"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWebcamDisabled}" Value="True">
                                            <Setter Property="Content" Value="Enable Webcam"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ======== Row 2: Stats Cards ======== -->
        <Border Grid.Row="2" Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center" Margin="8,4">
                    <TextBlock Text="WEBCAM ACCESSES" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding WebcamAccessCount}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="8,4">
                    <TextBlock Text="MIC ACCESSES" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding MicAccessCount}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Margin="8,4">
                    <TextBlock Text="BLOCKED" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding BlockedAccessCount}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="3" HorizontalAlignment="Center" Margin="8,4">
                    <TextBlock Text="ACTIVE DEVICES" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ActiveDevices}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======== Row 3: Connected Devices ======== -->
        <Border Grid.Row="3" Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Connected Devices" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock FontSize="12" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,12,0">
                            <Run Text="Webcams: "/><Run Text="{Binding ConnectedWebcams, Mode=OneWay}" FontWeight="Bold"/>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{StaticResource WarningBrush}">
                            <Run Text="Mics: "/><Run Text="{Binding ConnectedMicrophones, Mode=OneWay}" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding ConnectedDevicesList}" FontFamily="Consolas" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ======== Row 4: Webcam Preview ======== -->
        <Border Grid.Row="4" Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Webcam Live Preview" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Padding="14,6" FontSize="11"
                            Command="{Binding TogglePreviewCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Setter Property="Content" Value="Open Preview"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPreviewActive}" Value="True">
                                        <Setter Property="Content" Value="Close Preview"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Preview area -->
                <Border Background="#FF111111" CornerRadius="6" MinHeight="200" MaxHeight="300" Margin="0,4,0,4">
                    <Grid>
                        <!-- Placeholder when no preview -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPreviewActive}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                                       Foreground="#44FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        </StackPanel>

                        <!-- Live image when preview is active -->
                        <Image Source="{Binding WebcamPreviewImage}" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding IsPreviewActive, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>

                <TextBlock Text="{Binding PreviewStatusText}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ======== Row 5: Info Card ======== -->
        <Border Grid.Row="5" Padding="12,8" Background="{StaticResource SurfaceBrush}"
                CornerRadius="{StaticResource DefaultCornerRadius}" Margin="0,0,0,12"
                BorderBrush="{StaticResource WarningBrush}" BorderThickness="1">
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                Monitors processes accessing your webcam and microphone via Windows registry consent stores,
                WMI device queries, and DLL module analysis. Suspicious or unrecognized applications are flagged in red.
                Use Block to terminate unauthorized access, Allow to whitelist trusted applications,
                or Disable Webcam to block all camera access at the hardware level.
            </TextBlock>
        </Border>

        <!-- ======== Row 6: Section Header ======== -->
        <TextBlock Grid.Row="6" Text="Device Access Monitor"
                   Style="{StaticResource SubheadingTextStyle}" Margin="0,0,0,8"/>

        <!-- ======== Row 7: Device Access List ======== -->
        <Border Grid.Row="7" Background="{StaticResource SurfaceBrush}"
                CornerRadius="{StaticResource DefaultCornerRadius}" Margin="0,0,0,12"
                MinHeight="120" MaxHeight="350">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DeviceAccesses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,1" Padding="12,8"
                                    Style="{StaticResource SuspiciousRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Device type icon -->
                                    <Border Grid.Column="0" Width="32" Height="32"
                                            CornerRadius="16" Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSuspicious}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="White" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE714;"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DeviceType}" Value="Microphone">
                                                            <Setter Property="Text" Value="&#xE720;"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DeviceType}" Value="Both">
                                                            <Setter Property="Text" Value="&#xE8B7;"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Process info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock FontSize="13" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSuspicious}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="{Binding ProcessName, Mode=OneWay}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding Pid, Mode=OneWay, StringFormat='(PID {0}'}" FontSize="10"
                                                 Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Run Text=")" FontSize="10"
                                                 Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="{Binding DeviceType, Mode=OneWay}"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding StartTime, Mode=OneWay, StringFormat='{}{0:HH:mm:ss}'}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="400">
                                            <Run Text="Path: " FontWeight="SemiBold"/><Run Text="{Binding ExecutablePath, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="400">
                                            <Run Text="Network: " FontWeight="SemiBold"/><Run Text="{Binding NetworkConnections, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="10" Margin="0,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSuspicious}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="Data Flow: " FontWeight="SemiBold"/><Run Text="{Binding DataDirection, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Suspicious badge -->
                                    <Border Grid.Column="2" Padding="8,3" CornerRadius="8"
                                            Margin="0,0,8,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsSuspicious, Converter={StaticResource BoolToVis}}"
                                            Background="#44FF4444">
                                        <TextBlock Text="SUSPICIOUS" FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource DangerBrush}"/>
                                    </Border>

                                    <!-- Status badge -->
                                    <Border Grid.Column="3" Padding="8,3" CornerRadius="8"
                                            Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#4400CC66"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AccessStatus}" Value="Blocked">
                                                        <Setter Property="Background" Value="#44FF8800"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AccessStatus}" Value="Recent">
                                                        <Setter Property="Background" Value="#44888888"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="9" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    <Setter Property="Text" Value="{Binding AccessStatus}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AccessStatus}" Value="Blocked">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AccessStatus}" Value="Recent">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Block button -->
                                    <Button Grid.Column="4" Content="Block"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="10,4" FontSize="11" Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.BlockAppCommand,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>

                                    <!-- Allow button -->
                                    <Button Grid.Column="5" Content="Allow"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="10,4" FontSize="11"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.AllowAppCommand,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ======== Row 8: Access Log Header ======== -->
        <TextBlock Grid.Row="8" Text="Access Log"
                   Style="{StaticResource SubheadingTextStyle}" Margin="0,0,0,6"/>

        <!-- ======== Row 9: Access Log ======== -->
        <Border Grid.Row="9" Background="{StaticResource SurfaceBrush}"
                CornerRadius="{StaticResource DefaultCornerRadius}" Height="160">
            <ListBox ItemsSource="{Binding AccessLog}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="NoWrap" Margin="4,1"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Focusable" Value="False"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
