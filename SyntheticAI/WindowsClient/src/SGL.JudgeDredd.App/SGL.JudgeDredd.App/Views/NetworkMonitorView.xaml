<UserControl x:Class="SGL.JudgeDredd.App.Views.NetworkMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="NETWORK MONITORING ENGINE" FontSize="18" FontWeight="Bold" Foreground="#F0E6D0"/>
            <TextBlock Text="Real-time monitoring of TCP/UDP connections, interfaces, and DNS cache" Foreground="#A89880" Margin="0,4,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Refresh Network" Command="{Binding RefreshNetworkCommand}" Background="#4A3D2A" Foreground="#F0E6D0" BorderBrush="#5A4D3A" Padding="15,8" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding RefreshStatus}" Foreground="#a6e3a1" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,15">
            <Border Background="#3A3020" CornerRadius="8" Padding="15,10" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Total Connections" Foreground="#A89880" FontSize="11"/><TextBlock Text="{Binding TotalConnections}" FontSize="20" Foreground="#FFD700"/></StackPanel>
            </Border>
            <Border Background="#3A3020" CornerRadius="8" Padding="15,10" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Established" Foreground="#A89880" FontSize="11"/><TextBlock Text="{Binding EstablishedConnections}" FontSize="20" Foreground="#a6e3a1"/></StackPanel>
            </Border>
            <Border Background="#3A3020" CornerRadius="8" Padding="15,10" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Listening" Foreground="#A89880" FontSize="11"/><TextBlock Text="{Binding ListeningPorts}" FontSize="20" Foreground="#f9e2af"/></StackPanel>
            </Border>
            <Border Background="#3A3020" CornerRadius="8" Padding="15,10" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Suspicious" Foreground="#A89880" FontSize="11"/><TextBlock Text="{Binding SuspiciousConnections}" FontSize="20" Foreground="#f38ba8"/></StackPanel>
            </Border>
            <Border Background="#3A3020" CornerRadius="8" Padding="15,10" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Interfaces" Foreground="#A89880" FontSize="11"/><TextBlock Text="{Binding InterfaceCount}" FontSize="20" Foreground="#E0B030"/></StackPanel>
            </Border>
        </WrapPanel>

        <TabControl Grid.Row="2" Background="Transparent" BorderBrush="#3A3020">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="#3A3020"/>
                    <Setter Property="Foreground" Value="#F0E6D0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Background="#3A3020" Padding="12,6" Margin="0,0,2,0" CornerRadius="6,6,0,0">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#4A3D2A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabItem Header="Connections">
                <DataGrid ItemsSource="{Binding ActiveConnections}" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="#1A1610" Foreground="#F0E6D0" BorderBrush="#3A3020" RowBackground="#1A1610" AlternatingRowBackground="#151210"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3A3020">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#3A3020"/><Setter Property="Foreground" Value="#F0E6D0"/>
                            <Setter Property="Padding" Value="8,6"/><Setter Property="BorderBrush" Value="#4A3D2A"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Local Addr" Binding="{Binding LocalAddress}" Width="130"/>
                        <DataGridTextColumn Header="L.Port" Binding="{Binding LocalPort}" Width="60"/>
                        <DataGridTextColumn Header="Remote Addr" Binding="{Binding RemoteAddress}" Width="130"/>
                        <DataGridTextColumn Header="R.Port" Binding="{Binding RemotePort}" Width="60"/>
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100"/>
                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="70"/>
                        <DataGridCheckBoxColumn Header="Sus." Binding="{Binding IsSuspicious}" Width="50"/>
                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Interfaces">
                <DataGrid ItemsSource="{Binding Interfaces}" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="#1A1610" Foreground="#F0E6D0" BorderBrush="#3A3020" RowBackground="#1A1610" AlternatingRowBackground="#151210"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3A3020">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#3A3020"/><Setter Property="Foreground" Value="#F0E6D0"/>
                            <Setter Property="Padding" Value="8,6"/><Setter Property="BorderBrush" Value="#4A3D2A"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="130"/>
                        <DataGridTextColumn Header="Speed" Binding="{Binding Speed}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="DNS Cache">
                <DataGrid ItemsSource="{Binding DnsCache}" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="#1A1610" Foreground="#F0E6D0" BorderBrush="#3A3020" RowBackground="#1A1610" AlternatingRowBackground="#151210"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3A3020">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#3A3020"/><Setter Property="Foreground" Value="#F0E6D0"/>
                            <Setter Property="Padding" Value="8,6"/><Setter Property="BorderBrush" Value="#4A3D2A"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Host Name" Binding="{Binding HostName}" Width="300"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding RecordType}" Width="80"/>
                        <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
