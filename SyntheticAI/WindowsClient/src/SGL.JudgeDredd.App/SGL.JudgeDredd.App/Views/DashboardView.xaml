<UserControl x:Class="SGL.JudgeDredd.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:SGL.JudgeDredd.Shared.Localization;assembly=SGL.JudgeDredd.Shared"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Page title -->
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[nav.dashboard]}"
                       Style="{StaticResource HeadingTextStyle}"
                       Margin="0,0,0,20"/>

            <!-- Server Status -->
            <Border CornerRadius="6" Padding="10,6" Margin="0,0,0,12"
                    Background="{StaticResource SurfaceBrush}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#22C55E"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServerOnline}" Value="False">
                                        <Setter Property="Fill" Value="#EF4444"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ServerStatusText}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Admin Broadcast Banner -->
            <Border CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                    Background="#1A3B82F6" BorderBrush="#3B82F6" BorderThickness="1"
                    Visibility="{Binding HasBroadcast, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="ADMIN BROADCAST" FontSize="10" FontWeight="Bold"
                               Foreground="#FFD700" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding BroadcastMessage}" FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Broadcast Notification with Countdown Timer -->
            <Border CornerRadius="6" Padding="14,10" Margin="0,0,0,12"
                    Background="#1AFF6B00" BorderBrush="#FF6B00" BorderThickness="1.5"
                    Visibility="{Binding HasBroadcastNotification, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="ADMIN NOTIFICATION" FontSize="10" FontWeight="Bold"
                                       Foreground="#FF9F43" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding BroadcastAdminName, StringFormat='from {0}'}"
                                       FontSize="10" Foreground="#A89880"/>
                            <TextBlock Text="{Binding BroadcastPostedAt, StringFormat=' at {0}'}"
                                       FontSize="10" Foreground="#A89880"/>
                        </StackPanel>
                        <TextBlock Text="{Binding BroadcastNotificationMessage}" FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Countdown display -->
                    <Border Grid.Column="1" Background="#2AFF6B00" CornerRadius="8"
                            Padding="14,8" VerticalAlignment="Center" Margin="12,0,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="COUNTDOWN" FontSize="9" FontWeight="Bold"
                                       Foreground="#FF9F43" HorizontalAlignment="Center"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding BroadcastCountdownText}" FontSize="18"
                                       FontWeight="Bold" Foreground="#FF6B00"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Admin Broadcast Send (Server Mode Only) -->
            <Border CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                    Background="{StaticResource SurfaceBrush}"
                    Visibility="{Binding IsServerMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Send Broadcast Message" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding AdminBroadcastInput, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource CardBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource SurfaceBrush}"
                                 Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[chat.send]}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SendBroadcastCommand}"
                                Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[chat.clear]}"
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding ClearBroadcastCommand}"
                                VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Stat cards row -->
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,20">
                <!-- Files scanned -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0"
                        ToolTipService.InitialShowDelay="800" ToolTipService.ShowDuration="10000">
                    <Border.ToolTip>
                        <ToolTip MaxWidth="280">
                            <TextBlock TextWrapping="Wrap" Text="Total number of files analyzed by the scan engine during this session. Includes Quick, Extended, and Custom scans as well as real-time file monitoring detections."/>
                        </ToolTip>
                    </Border.ToolTip>
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[scan.filesScanned]}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding FilesScannedToday}"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource SecondaryBrush}"/>
                        <TextBlock Text="today"
                                   Style="{StaticResource SecondaryTextStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Threats blocked -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="6,0"
                        ToolTipService.InitialShowDelay="800" ToolTipService.ShowDuration="10000">
                    <Border.ToolTip>
                        <ToolTip MaxWidth="280">
                            <TextBlock TextWrapping="Wrap" Text="Total threats neutralized since application start. Includes signature matches, heuristic detections, AI-flagged suspicious files, and real-time protection blocks."/>
                        </ToolTip>
                    </Border.ToolTip>
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[dashboard.totalthreats]}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding ThreatsBlocked}"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}"/>
                        <TextBlock Text="total"
                                   Style="{StaticResource SecondaryTextStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Firewall rules -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="6,0"
                        ToolTipService.InitialShowDelay="800" ToolTipService.ShowDuration="10000">
                    <Border.ToolTip>
                        <ToolTip MaxWidth="280">
                            <TextBlock TextWrapping="Wrap" Text="Number of active Windows Firewall rules currently enforced. Includes inbound and outbound rules across Domain, Private, and Public profiles. Manage rules in the Firewall tab."/>
                        </ToolTip>
                    </Border.ToolTip>
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[firewall.rules]}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding FirewallRulesActive}"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="active"
                                   Style="{StaticResource SecondaryTextStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Uptime -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="12,0,0,0"
                        ToolTipService.InitialShowDelay="800" ToolTipService.ShowDuration="10000">
                    <Border.ToolTip>
                        <ToolTip MaxWidth="280">
                            <TextBlock TextWrapping="Wrap" Text="Elapsed time since SyntheticAI started this session. The longer the uptime, the more continuous protection your system has received. Restarts when the application is closed and reopened."/>
                        </ToolTip>
                    </Border.ToolTip>
                    <StackPanel>
                        <TextBlock Text="UPTIME"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Uptime}"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}"/>
                        <TextBlock Text="session"
                                   Style="{StaticResource SecondaryTextStyle}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Threat level banner -->
            <Border Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,20"
                    ToolTipService.InitialShowDelay="800" ToolTipService.ShowDuration="10000">
                <Border.ToolTip>
                    <ToolTip MaxWidth="300">
                        <TextBlock TextWrapping="Wrap" Text="Current system threat assessment based on recent scan results, real-time detections, and security monitor alerts. Low = no threats detected. Medium = minor concerns found. High = active threats requiring attention. Critical = immediate action needed."/>
                    </ToolTip>
                </Border.ToolTip>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[dashboard.threatlevel]}"
                                   Style="{StaticResource SubheadingTextStyle}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ThreatLevel}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[dashboard.quickscan]}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding QuickScanCommand}"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsScanRunning, Converter={StaticResource InverseBoolToVisConverter}}"/>

                    <Button Grid.Column="2"
                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[scan.extended]}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding FullScanCommand}"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsScanRunning, Converter={StaticResource InverseBoolToVisConverter}}"/>

                    <Button Grid.Column="3"
                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[scan.stop]}"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding CancelScanCommand}"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsScanRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- Scan progress section (visible during scan) -->
            <Border Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,20"
                    Visibility="{Binding IsScanRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <!-- Scan type header -->
                    <TextBlock Text="{Binding ScanType}"
                               Style="{StaticResource SubheadingTextStyle}"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,0,12"/>

                    <!-- Progress bar -->
                    <ProgressBar Value="{Binding ScanProgressPercent}" Maximum="100"
                                 Height="18" Margin="0,0,0,8"/>

                    <!-- Status row: scanned/total + ETA -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding ScanStatusText}"
                                   Style="{StaticResource SecondaryTextStyle}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ScanEta}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold"/>
                    </Grid>

                    <!-- Threats found during scan -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[scan.threatsFound]}"
                                   Style="{StaticResource SecondaryTextStyle}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ScanThreatsFound}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}"/>
                    </Grid>

                    <!-- Current file being scanned -->
                    <TextBlock Text="Currently scanning:"
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,4,0,2"/>
                    <TextBlock Text="{Binding CurrentScanFile}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" TextTrimming="CharacterEllipsis"
                               MaxHeight="32"/>
                </StackPanel>
            </Border>

            <!-- Scan log section (visible after scan completes) -->
            <Border Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,20"
                    Visibility="{Binding HasScanLog, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Scan Report"
                               Style="{StaticResource SubheadingTextStyle}"
                               Foreground="{StaticResource SuccessBrush}"
                               Margin="0,0,0,8"/>

                    <Border Background="{StaticResource CardBrush}"
                            CornerRadius="{StaticResource DefaultCornerRadius}"
                            Padding="12" MaxHeight="300">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ScanLogText}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Scan event log entries -->
                    <TextBlock Text="Scan Events"
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,12,0,4"/>
                    <Border Background="{StaticResource CardBrush}"
                            CornerRadius="{StaticResource DefaultCornerRadius}"
                            Padding="8" MaxHeight="150">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ScanLogEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Recent alerts -->
            <TextBlock Text="Recent Alerts"
                       Style="{StaticResource SubheadingTextStyle}"
                       Margin="0,0,0,12"/>

            <Border Style="{StaticResource SurfaceBorderStyle}" MinHeight="120">
                <ItemsControl ItemsSource="{Binding RecentAlerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}"
                                    CornerRadius="{StaticResource DefaultCornerRadius}"
                                    Padding="12,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Severity indicator -->
                                    <Ellipse Grid.Column="0" Width="10" Height="10"
                                             Fill="{StaticResource WarningBrush}"
                                             VerticalAlignment="Center" Margin="0,0,12,0"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Description}"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DetectedAt, StringFormat='{}{0:HH:mm}'}"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                    <!-- Empty state -->
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <TextBlock Text="No recent alerts. System is clean."
                                                           Foreground="{StaticResource SuccessBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="14" Margin="0,20"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
