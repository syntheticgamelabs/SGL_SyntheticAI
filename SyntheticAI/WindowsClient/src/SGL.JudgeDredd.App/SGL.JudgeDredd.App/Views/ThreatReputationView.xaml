<UserControl x:Class="SGL.JudgeDredd.App.Views.ThreatReputationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="THREAT REPUTATION LOOKUP" FontSize="18" FontWeight="Bold" Foreground="#F0E6D0"/>
            <TextBlock Text="Check files, hashes, IPs, and domains against threat intelligence databases" Foreground="#A89880" Margin="0,4,0,0"/>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding LookupTarget, UpdateSourceTrigger=PropertyChanged}"
                         Background="#3A3020" Foreground="#F0E6D0" BorderBrush="#5A4D3A" Padding="10,8" Margin="0,0,10,0"
                         ToolTip="Enter a file path, directory path, SHA256 hash, IP address, or domain name"/>
                <Button Grid.Column="1" Content="Lookup" Command="{Binding LookupFileCommand}" Background="#4A3D2A" Foreground="#F0E6D0" BorderBrush="#5A4D3A" Padding="15,8" Margin="0,0,5,0"/>
                <Button Grid.Column="2" Content="Scan Dir" Command="{Binding ScanDirectoryCommand}" Background="#4A3D2A" Foreground="#F0E6D0" BorderBrush="#5A4D3A" Padding="15,8"/>
            </Grid>
            <TextBlock Text="{Binding LookupStatus}" Foreground="#a6e3a1" Margin="0,8,0,0"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,15">
            <Border Background="#3A3020" CornerRadius="8" Padding="15,10" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Total Lookups" Foreground="#A89880" FontSize="11"/><TextBlock Text="{Binding TotalLookups}" FontSize="20" Foreground="#FFD700"/></StackPanel>
            </Border>
            <Border Background="#3A3020" CornerRadius="8" Padding="15,10" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Threats Found" Foreground="#A89880" FontSize="11"/><TextBlock Text="{Binding ThreatsFound}" FontSize="20" Foreground="#f38ba8"/></StackPanel>
            </Border>
            <Border Background="#3A3020" CornerRadius="8" Padding="15,10" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Clean" Foreground="#A89880" FontSize="11"/><TextBlock Text="{Binding CleanResults}" FontSize="20" Foreground="#a6e3a1"/></StackPanel>
            </Border>
        </WrapPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#1A1610" Foreground="#F0E6D0" BorderBrush="#3A3020" RowBackground="#1A1610" AlternatingRowBackground="#151210"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3A3020">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#3A3020"/><Setter Property="Foreground" Value="#F0E6D0"/>
                    <Setter Property="Padding" Value="8,6"/><Setter Property="BorderBrush" Value="#4A3D2A"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="250"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80"/>
                <DataGridTextColumn Header="Verdict" Binding="{Binding Verdict}" Width="100"/>
                <DataGridTextColumn Header="Score" Binding="{Binding ThreatScore}" Width="60"/>
                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
                <DataGridTextColumn Header="Checked" Binding="{Binding CheckedAt, StringFormat=HH:mm:ss}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
