<UserControl x:Class="SGL.JudgeDredd.App.Views.ShareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">

            <!-- Header -->
            <TextBlock Text="Share SyntheticAI"
                       Style="{StaticResource HeadingTextStyle}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Generate a QR code for friends to download and install SyntheticAI on any platform"
                       Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,0,0,24"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Info and Controls -->
                <StackPanel Grid.Column="0" Margin="0,0,24,0">

                    <!-- Share Type Selector -->
                    <Border Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Share Type"
                                       Style="{StaticResource SubheadingTextStyle}"
                                       Margin="0,0,0,12"/>
                            <ComboBox ItemsSource="{Binding ShareTypes}"
                                      SelectedItem="{Binding SelectedShareType}"
                                      FontSize="14"
                                      Padding="8,6"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <!-- Download URL -->
                    <Border Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Download Link"
                                       Style="{StaticResource SubheadingTextStyle}"
                                       Margin="0,0,0,12"/>
                            <TextBox Text="{Binding DownloadUrl, Mode=OneWay}"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Copy Link"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding CopyDownloadLinkCommand}"
                                        Padding="16,6"
                                        Margin="0,0,8,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Info Box -->
                    <Border Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16" Padding="20">
                        <StackPanel>
                            <TextBlock Text="How It Works"
                                       Style="{StaticResource SubheadingTextStyle}"
                                       Margin="0,0,0,12"/>
                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" FontSize="13" LineHeight="22">
                                <Run FontWeight="SemiBold">1.</Run>
                                <Run> Click 'Generate QR Code' to create the download QR</Run>
                                <LineBreak/>
                                <Run FontWeight="SemiBold">2.</Run>
                                <Run> Your friend scans the QR code with their phone camera</Run>
                                <LineBreak/>
                                <Run FontWeight="SemiBold">3.</Run>
                                <Run> The APK downloads automatically to their phone</Run>
                                <LineBreak/>
                                <Run FontWeight="SemiBold">4.</Run>
                                <Run> They open the APK to install SyntheticAI Mobile Security</Run>
                            </TextBlock>
                            <TextBlock Text="{Binding DownloadSizeText, StringFormat='APK Size: {0}'}"
                                       Foreground="{StaticResource WarningBrush}"
                                       FontWeight="SemiBold" FontSize="13"
                                       Margin="0,12,0,0"/>
                            <TextBlock Text="Note: The server must be running and the APK must be stored in the server's data/mobile/ folder for downloads to work."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" FontSize="11"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <Border Style="{StaticResource SurfaceBorderStyle}" Padding="20">
                        <StackPanel>
                            <Button Content="Generate QR Code"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding GenerateQrCodeCommand}"
                                    IsEnabled="{Binding IsGenerating, Converter={StaticResource InverseBoolToVisConverter}}"
                                    Padding="24,10"
                                    FontSize="15"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,12"/>
                            <Button Content="Save QR Code Image..."
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding SaveQrCodeCommand}"
                                    Padding="16,6"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{StaticResource SecondaryBrush}"
                                       TextWrapping="Wrap" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: QR Code Display -->
                <Border Grid.Column="1"
                        Style="{StaticResource SurfaceBorderStyle}"
                        Padding="20"
                        Width="400"
                        VerticalAlignment="Top">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="QR Code"
                                   Style="{StaticResource SubheadingTextStyle}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16"/>

                        <!-- QR Code Image -->
                        <Border Background="White" CornerRadius="8" Padding="8"
                                HorizontalAlignment="Center"
                                Visibility="{Binding HasQrCode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Image Source="{Binding QrCodeImage}"
                                   Width="340" Height="380"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <!-- Placeholder when no QR -->
                        <Border Background="{StaticResource CardBrush}" CornerRadius="8"
                                Width="340" Height="340"
                                HorizontalAlignment="Center"
                                Visibility="{Binding HasQrCode, Converter={StaticResource InverseBoolToVisConverter}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="QR" FontSize="48" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Click Generate to create QR code"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" HorizontalAlignment="Center"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Scan with any phone camera"
                                   Foreground="{StaticResource SecondaryBrush}"
                                   FontSize="12" HorizontalAlignment="Center"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
