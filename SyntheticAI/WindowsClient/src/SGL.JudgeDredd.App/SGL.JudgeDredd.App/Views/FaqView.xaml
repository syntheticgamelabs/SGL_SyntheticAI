<UserControl x:Class="SGL.JudgeDredd.App.Views.FaqView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <!-- Header -->
            <TextBlock Text="Frequently Asked Questions"
                       FontSize="24" FontWeight="Bold"
                       Foreground="#FFD700"
                       Margin="0,0,0,16" />

            <!-- Ask Question Section -->
            <Border Background="#3A3020" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Ask a Question" FontSize="14" FontWeight="SemiBold"
                               Foreground="#F0E6D0" Margin="0,0,0,8" />
                    <TextBox Text="{Binding QuestionText, UpdateSourceTrigger=PropertyChanged}"
                             Background="#1A1610" Foreground="#F0E6D0"
                             BorderBrush="#4A3D2A" BorderThickness="1"
                             Padding="8" MinHeight="60"
                             AcceptsReturn="True" TextWrapping="Wrap" />
                    <Button Content="Submit Question"
                            Command="{Binding AskQuestionCommand}"
                            Background="#FFD700" Foreground="#1A1610"
                            FontWeight="Bold" Padding="16,8"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Right"
                            Cursor="Hand" />
                </StackPanel>
            </Border>

            <!-- Refresh Button -->
            <Button Content="Refresh FAQ"
                    Command="{Binding LoadFaqCommand}"
                    Background="#4A3D2A" Foreground="#F0E6D0"
                    Padding="12,6" Margin="0,0,0,16"
                    HorizontalAlignment="Left"
                    Cursor="Hand" />

            <!-- FAQ List -->
            <ItemsControl ItemsSource="{Binding FaqItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#3A3020" CornerRadius="10"
                                Padding="14" Margin="0,4">
                            <StackPanel>
                                <TextBlock Text="{Binding Question}"
                                           Foreground="#FFD700"
                                           FontSize="15" FontWeight="Bold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding AnswerDisplay}"
                                           Foreground="#F0E6D0"
                                           FontSize="14" Margin="0,6,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding MetadataDisplay}"
                                           Foreground="#6C7086"
                                           FontSize="11" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Status -->
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#6C7086" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
