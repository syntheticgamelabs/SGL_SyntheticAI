<UserControl x:Class="SGL.JudgeDredd.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SGL.JudgeDredd.Shared.Localization;assembly=SGL.JudgeDredd.Shared"
             Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                MaxWidth="420" MaxHeight="520" Padding="40"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <!-- Logo -->
                <TextBlock Text="SGL" FontSize="48" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="SyntheticAI Security" FontSize="14"
                           Foreground="{StaticResource SecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <!-- Error Message -->
                <Border Background="#44FF4444" CornerRadius="4" Padding="10" Margin="0,0,0,16"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                </Border>

                <!-- Success Message -->
                <Border Background="#4400FF00" CornerRadius="4" Padding="10" Margin="0,0,0,16"
                        Visibility="{Binding HasSuccess, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}"
                               FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                </Border>

                <!-- Username -->
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[login.username]}" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" Padding="10,8" Margin="0,0,0,16"
                         Background="{StaticResource CardBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         CaretBrush="{StaticResource TextPrimaryBrush}"/>

                <!-- Password -->
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[login.password]}" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" Margin="0,0,0,6"/>
                <PasswordBox x:Name="PasswordBox" FontSize="14" Padding="10,8" Margin="0,0,0,24"
                             Background="{StaticResource CardBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             PasswordChanged="PasswordBox_PasswordChanged"/>

                <!-- Login Button -->
                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[login.signin]}" Height="42" FontSize="15"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding LoginCommand}"
                        Margin="0,0,0,16"/>

                <!-- Create Account Link -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Don't have an account? "
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                               VerticalAlignment="Center"/>
                    <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[login.register]}" FontSize="12" Cursor="Hand"
                            Command="{Binding NavigateToRegisterActionCommand}"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock x:Name="LinkText" TextDecorations="Underline"
                                           Foreground="{StaticResource PrimaryBrush}">
                                    <ContentPresenter/>
                                </TextBlock>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="LinkText" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
