<UserControl x:Class="SGL.JudgeDredd.App.Views.ServerDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Page title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Server Dashboard"
                       Style="{StaticResource HeadingTextStyle}"/>
            <TextBlock Text="{Binding ListenAddress, StringFormat='Listening on {0}'}"
                       Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,4,0,0"/>
            <TextBlock Text="{Binding PublicUrl, StringFormat='Server Address: {0}'}"
                       Style="{StaticResource SecondaryTextStyle}"
                       Foreground="{StaticResource AccentBrush}"
                       FontWeight="SemiBold"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Summary cards -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="5" Margin="0,0,0,16">
            <!-- Online Clients -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="ONLINE CLIENTS"
                               Style="{StaticResource SecondaryTextStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding OnlineClientCount}"
                               FontSize="32" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Total Registered -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="4,0,8,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="REGISTERED"
                               Style="{StaticResource SecondaryTextStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalRegisteredClients}"
                               FontSize="32" FontWeight="Bold"
                               Foreground="{StaticResource SecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Threats Detected -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="4,0,8,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="THREATS"
                               Style="{StaticResource SecondaryTextStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalThreatsDetected}"
                               FontSize="32" FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Files Scanned -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="4,0,8,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="FILES SCANNED"
                               Style="{StaticResource SecondaryTextStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalFilesScanned}"
                               FontSize="32" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Server Uptime -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="4,0,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="UPTIME"
                               Style="{StaticResource SecondaryTextStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ServerUptime}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource ForegroundBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Connected clients table -->
        <Border Grid.Row="2" Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Connected Clients"
                               Style="{StaticResource SubheadingTextStyle}"/>
                    <Button Content="Refresh"
                            Command="{Binding RefreshDataCommand}"
                            Margin="16,0,0,0"
                            Padding="12,4"
                            Background="{StaticResource AccentBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding ConnectedClients}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="Transparent"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#10FFFFFF"
                          Foreground="{StaticResource ForegroundBrush}"
                          HorizontalGridLinesBrush="#20FFFFFF"
                          ColumnHeaderHeight="36">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#20FFFFFF"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="100"/>
                        <DataGridTextColumn Header="Machine" Binding="{Binding MachineName}" Width="120"/>
                        <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="80"/>
                        <DataGridTextColumn Header="Version" Binding="{Binding ClientVersion}" Width="70"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70"/>
                        <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeen}" Width="80"/>
                        <DataGridTextColumn Header="RTP" Binding="{Binding RealTimeProtection}" Width="65"/>
                        <DataGridTextColumn Header="LLM" Binding="{Binding LlmLoaded}" Width="45"/>
                        <DataGridTextColumn Header="Threats" Binding="{Binding ThreatsDetected}" Width="65"/>
                        <DataGridTextColumn Header="Scanned" Binding="{Binding FilesScanned}" Width="70"/>
                        <DataGridTextColumn Header="Uptime" Binding="{Binding Uptime}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Server log -->
        <Border Grid.Row="3" Style="{StaticResource SurfaceBorderStyle}" MaxHeight="180">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Server Log"
                           Style="{StaticResource SubheadingTextStyle}"
                           Margin="0,0,0,8"/>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding ServerLog}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         FontFamily="Consolas"
                         FontSize="11"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
