<UserControl x:Class="SGL.JudgeDredd.App.Views.TestSpeedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Test Speed" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,20"/>

        <!-- Speed Test Controls -->
        <Border Grid.Row="1" Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="INTERNET SPEED TEST" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" DockPanel.Dock="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Run Speed Test" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding RunSpeedTestCommand}" Margin="0,0,8,0"/>
                        <Button Content="Stop" Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding StopSpeedTestCommand}"/>
                    </StackPanel>
                </DockPanel>

                <TextBlock Text="{Binding TestStatus}" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" Margin="0,0,0,8"/>
                <ProgressBar Value="{Binding TestProgress}" Maximum="100" Height="6"
                             Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16"/>

                <!-- Speed Results -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Download -->
                    <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="DOWNLOAD" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding DownloadSpeed, StringFormat='{}{0:F2}'}"
                                       Foreground="{StaticResource SuccessBrush}"
                                       FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Mbps" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Upload -->
                    <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="UPLOAD" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding UploadSpeed, StringFormat='{}{0:F2}'}"
                                       Foreground="{StaticResource SecondaryBrush}"
                                       FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Mbps" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Ping -->
                    <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="PING" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding PingLatency, StringFormat='{}{0:F0}'}"
                                       Foreground="{StaticResource WarningBrush}"
                                       FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="ms" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Connection Info -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Local IP" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding LocalIp}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Public IP" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding PublicIp}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ISP" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding Isp}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Server" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding ServerUsed}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Network Check Section -->
        <Border Grid.Row="2" Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="NETWORK CHECK" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" DockPanel.Dock="Left"/>
                    <Button Content="Check Network" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CheckNetworkCommand}" HorizontalAlignment="Right"/>
                </DockPanel>
                <TextBlock Text="{Binding NetworkCheckStatus}" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" Margin="0,0,0,8"/>
            </StackPanel>
        </Border>

        <!-- Traceroute Results -->
        <Border Grid.Row="3" Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="ROUTE TRACE" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <DataGrid ItemsSource="{Binding TraceResults}" IsReadOnly="True"
                          AutoGenerateColumns="False" CanUserSortColumns="False" MaxHeight="300">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Hop" Binding="{Binding HopNumber}" Width="50"/>
                        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="150"/>
                        <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="*"/>
                        <DataGridTextColumn Header="Latency" Binding="{Binding LatencyMs, StringFormat='{}{0} ms'}" Width="80"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- Network Log -->
        <Border Grid.Row="4" Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="NETWORK LOG" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <ListBox ItemsSource="{Binding NetworkLog}" MaxHeight="300"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
