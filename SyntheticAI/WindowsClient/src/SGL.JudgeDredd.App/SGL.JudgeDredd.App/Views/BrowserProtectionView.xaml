<UserControl x:Class="SGL.JudgeDredd.App.Views.BrowserProtectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────────── -->
        <Border Grid.Row="0" Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Shield icon + Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                               Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Browser Protection" Style="{StaticResource HeadingTextStyle}"
                                   Margin="0"/>
                        <TextBlock Text="{Binding MonitorStatus}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status indicator -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,16,0">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProtectionEnabled}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="PROTECTED"/>
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProtectionEnabled}" Value="False">
                                        <Setter Property="Text" Value="DISABLED"/>
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Scan Now" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ScanBrowsersCommand}" Padding="16,8" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ToggleProtectionCommand}" Padding="16,8">
                        <Button.Content>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Disable"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProtectionEnabled}" Value="False">
                                                <Setter Property="Text" Value="Enable"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Stats cards ────────────────────────────────────────── -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,16">
            <!-- Browsers Monitored -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                <StackPanel HorizontalAlignment="Center" Margin="8">
                    <TextBlock Text="BROWSERS MONITORED" FontSize="10"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding BrowsersMonitored}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Threats Blocked -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="4,0">
                <StackPanel HorizontalAlignment="Center" Margin="8">
                    <TextBlock Text="THREATS BLOCKED" FontSize="10"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ThreatsBlocked}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Malicious URLs -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="4,0">
                <StackPanel HorizontalAlignment="Center" Margin="8">
                    <TextBlock Text="MALICIOUS URLs" FontSize="10"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding MaliciousUrlsBlocked}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Trackers Blocked -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
                <StackPanel HorizontalAlignment="Center" Margin="8">
                    <TextBlock Text="TRACKERS BLOCKED" FontSize="10"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TrackersBlocked}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ── Monitoring Settings ──────────────────────────────────── -->
        <Border Grid.Row="2" Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Monitoring Settings" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <Button Content="Run Diagnostics" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RunDiagnosticsCommand}" Padding="12,4" FontSize="11"/>
                </StackPanel>

                <UniformGrid Grid.Row="1" Rows="1" Columns="5">
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <CheckBox IsChecked="{Binding DnsMonitorEnabled}" VerticalAlignment="Center"/>
                        <TextBlock Text="DNS Monitor" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <CheckBox IsChecked="{Binding ExtensionScanEnabled}" VerticalAlignment="Center"/>
                        <TextBlock Text="Extension Scan" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <CheckBox IsChecked="{Binding HijackDetectionEnabled}" VerticalAlignment="Center"/>
                        <TextBlock Text="Hijack Detection" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding ProxyMonitorEnabled}" VerticalAlignment="Center"/>
                        <TextBlock Text="Proxy Monitor" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding ScreenRecordingProtection}" VerticalAlignment="Center"/>
                        <TextBlock Text="Screen Recording" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- ── Screen Recording Status ──────────────────────────────── -->
        <Border Grid.Row="3" Padding="10,6" Background="{StaticResource SurfaceBrush}"
                CornerRadius="{StaticResource DefaultCornerRadius}" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Screen Recording: " FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ScreenRecordingStatus}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Margin="12,0,0,0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="DETECTED"/>
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ScreenCaptureAttempts}" Value="0">
                                    <Setter Property="Text" Value="CLEAR"/>
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ── Proxy warning ──────────────────────────────────────── -->
        <Border Grid.Row="4" Padding="12,8" Background="{StaticResource SurfaceBrush}"
                CornerRadius="{StaticResource DefaultCornerRadius}" Margin="0,0,0,12"
                BorderThickness="1"
                Visibility="{Binding ProxyTampered, Converter={StaticResource BoolToVis}}">
            <Border.BorderBrush>
                <SolidColorBrush Color="#FFE53935"/>
            </Border.BorderBrush>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBlock Text="{Binding ProxyStatus}" FontSize="12"
                           Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ── Active browsers section ────────────────────────────── -->
        <Grid Grid.Row="5" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Active Browsers"
                       Style="{StaticResource SubheadingTextStyle}" Margin="0,0,0,8"/>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding ActiveBrowsers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}"
                                CornerRadius="{StaticResource DefaultCornerRadius}"
                                Padding="14,10" Margin="0,0,8,8" MinWidth="170">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Browser icon placeholder -->
                                <Border Grid.Column="0" Width="36" Height="36"
                                        CornerRadius="18" Margin="0,0,10,0"
                                        Background="{StaticResource SurfaceBrush}">
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="18" Foreground="{StaticResource PrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BrowserName}" FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Status}" FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text=" | " FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding MemoryUsage}" FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <!-- Empty state -->
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Style.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate>
                                            <Border Background="{StaticResource CardBrush}"
                                                    CornerRadius="{StaticResource DefaultCornerRadius}"
                                                    Padding="16,12">
                                                <TextBlock Text="No browsers detected. Click Scan Now to check."
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="12" HorizontalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
            </ItemsControl>
        </Grid>

        <!-- ── Threats section label ──────────────────────────────── -->
        <Grid Grid.Row="6" Margin="0,0,0,8">
            <TextBlock Text="Detected Threats" Style="{StaticResource SubheadingTextStyle}"
                       VerticalAlignment="Center"/>
            <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding RefreshCommand}" HorizontalAlignment="Right"
                    Padding="12,4" FontSize="12"/>
        </Grid>

        <!-- ── Threats list ───────────────────────────────────────── -->
        <Border Grid.Row="7" Style="{StaticResource SurfaceBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DetectedThreats}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}"
                                    CornerRadius="{StaticResource DefaultCornerRadius}"
                                    Padding="16,12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Risk level indicator bar -->
                                    <Border Grid.Column="0" Width="4" CornerRadius="2"
                                            Margin="0,0,14,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="{StaticResource WarningBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RiskLevel}"
                                                                 Value="Critical">
                                                        <Setter Property="Background"
                                                                Value="{StaticResource DangerBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RiskLevel}"
                                                                 Value="High">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <SolidColorBrush Color="#FFFF7043"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RiskLevel}"
                                                                 Value="Medium">
                                                        <Setter Property="Background"
                                                                Value="{StaticResource WarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RiskLevel}"
                                                                 Value="Low">
                                                        <Setter Property="Background"
                                                                Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <!-- Threat details -->
                                    <StackPanel Grid.Column="1">
                                        <Grid Margin="0,0,0,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ThreatType}"
                                                           FontWeight="SemiBold" FontSize="14"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text=" - " FontSize="14"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding BrowserName}" FontSize="14"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>

                                            <!-- Risk badge -->
                                            <Border HorizontalAlignment="Right" Padding="8,2"
                                                    CornerRadius="8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <SolidColorBrush Color="#33FFC107"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RiskLevel}"
                                                                         Value="Critical">
                                                                <Setter Property="Background">
                                                                    <Setter.Value>
                                                                        <SolidColorBrush Color="#33F44336"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RiskLevel}"
                                                                         Value="High">
                                                                <Setter Property="Background">
                                                                    <Setter.Value>
                                                                        <SolidColorBrush Color="#33FF7043"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RiskLevel}"
                                                                         Value="Low">
                                                                <Setter Property="Background">
                                                                    <Setter.Value>
                                                                        <SolidColorBrush Color="#334CAF50"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding RiskLevel}" FontSize="11"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource WarningBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RiskLevel}"
                                                                             Value="Critical">
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource DangerBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RiskLevel}"
                                                                             Value="High">
                                                                    <Setter Property="Foreground">
                                                                        <Setter.Value>
                                                                            <SolidColorBrush Color="#FFFF7043"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RiskLevel}"
                                                                             Value="Low">
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="{Binding Url}"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   FontSize="12" FontFamily="Consolas"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,4"/>

                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Margin="0,0,0,4"/>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="{Binding DetectedAt, StringFormat='Detected: {0:yyyy-MM-dd HH:mm:ss}'}"/>
                                            <TextBlock Text=" | Blocked" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVis}}"
                                                       Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Action buttons -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                Margin="12,0,0,0">
                                        <Button Content="Block" Style="{StaticResource PrimaryButtonStyle}"
                                                Padding="14,5" FontSize="11"
                                                Command="{Binding DataContext.BlockUrlCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,0,4"/>
                                        <Button Content="Allow" Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="14,5" FontSize="11"
                                                Command="{Binding DataContext.AllowUrlCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                    <!-- Empty state -->
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" Margin="0,40">
                                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="36"
                                                               Foreground="{StaticResource SuccessBrush}"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,12"/>
                                                    <TextBlock Text="No browser threats detected."
                                                               Foreground="{StaticResource SuccessBrush}"
                                                               FontSize="16" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,8"/>
                                                    <TextBlock Text="Browser protection is actively monitoring for malicious URLs, phishing, hijacking, and suspicious extensions."
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="12"
                                                               HorizontalAlignment="Center"
                                                               TextWrapping="Wrap"
                                                               MaxWidth="500"/>
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ── Diagnostics Output ──────────────────────────────── -->
        <Border Grid.Row="8" Style="{StaticResource SurfaceBorderStyle}" Margin="0,12,0,0"
                MaxHeight="200">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding ScanDiagnostics}" FontFamily="Consolas" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
