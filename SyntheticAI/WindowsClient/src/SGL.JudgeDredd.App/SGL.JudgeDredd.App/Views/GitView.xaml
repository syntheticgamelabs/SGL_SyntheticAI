<UserControl x:Class="SGL.JudgeDredd.App.Views.GitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SGL.JudgeDredd.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:GitViewModel}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header with repo selector and action buttons -->
            <RowDefinition Height="Auto"/>
            <!-- Status bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main content area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- HEADER: REPO SELECTOR + ACTION BUTTONS                       -->
        <!-- ============================================================ -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title and repo dropdown -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="GIT REPOSITORY MANAGER"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <!-- Repository dropdown + Clone URL -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Repository:" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="250" Height="30"
                                  ItemsSource="{Binding AvailableRepositories}"
                                  SelectedItem="{Binding SelectedRepository}"
                                  FontSize="13"/>

                        <Separator Width="1" Height="24" Margin="12,0"
                                   Background="{StaticResource BorderBrush}"/>

                        <!-- Clone URL Protocol Selector -->
                        <TextBlock Text="Clone:" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="80" Height="30" FontSize="12"
                                  SelectedItem="{Binding SelectedCloneProtocol}"
                                  VerticalAlignment="Center">
                            <ComboBoxItem Content="HTTPS" IsSelected="True"/>
                            <ComboBoxItem Content="SSH"/>
                        </ComboBox>
                        <TextBox Width="280" Height="30" FontSize="11" IsReadOnly="True"
                                 FontFamily="Consolas" Margin="6,0,0,0"
                                 Text="{Binding GeneratedCloneUrl, Mode=OneWay}"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 ToolTip="{Binding GeneratedCloneUrl}"/>
                        <Button Content="Copy" Height="30" Padding="10,0" Margin="4,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CopyCloneUrlCommand}"
                                ToolTip="Copy clone URL to clipboard"/>
                    </StackPanel>
                </Grid>

                <!-- Action buttons row -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="Clone Repository" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding OpenCloneDialogCommand}"
                            Margin="0,0,8,0" Height="32" Padding="16,0"
                            ToolTip="Clone a remote repository via HTTPS or SSH"/>
                    <Button Content="Add New Repository" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding OpenNewRepoDialogCommand}"
                            Margin="0,0,8,0" Height="32" Padding="16,0"
                            ToolTip="Initialize a new empty Git repository"/>
                    <Button Content="Local Repository" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenLocalRepositoryCommand}"
                            Margin="0,0,8,0" Height="32" Padding="16,0"
                            ToolTip="Open an existing local Git repository"/>
                    <Button Content="Host Repository" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding OpenHostDialogCommand}"
                            Margin="0,0,8,0" Height="32" Padding="16,0"
                            ToolTip="Host a Git repository from this device"/>
                    <Button Content="Stop Hosting" Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding StopHostingCommand}"
                            Margin="0,0,8,0" Height="32" Padding="16,0"
                            Visibility="{Binding IsHosting, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="Stop hosting the current repository"/>

                    <Separator Width="1" Height="24" Margin="8,0"
                               Background="{StaticResource BorderBrush}"/>

                    <!-- Branch selector (visible when repo is open) -->
                    <TextBlock Text="Branch:" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding IsRepositoryOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <ComboBox Width="180" Height="30"
                              ItemsSource="{Binding LocalBranches}"
                              SelectedItem="{Binding SelectedBranch}"
                              FontSize="13"
                              Visibility="{Binding IsRepositoryOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- STATUS BAR                                                   -->
        <!-- ============================================================ -->
        <Border Grid.Row="1" Padding="8,6" Margin="0,0,0,8"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <ProgressBar Grid.Column="1" Width="120" Height="14"
                             Minimum="0" Maximum="100"
                             Value="{Binding OperationProgress}"
                             Margin="8,0,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- MAIN CONTENT: TABBED INTERFACE                               -->
        <!-- ============================================================ -->
        <TabControl Grid.Row="2"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Background="Transparent"
                    BorderThickness="0"
                    Visibility="{Binding IsRepositoryOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

            <!-- ======================================================== -->
            <!-- TAB 1: CHANGES                                           -->
            <!-- ======================================================== -->
            <TabItem Header="Changes">
                <Border Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Action buttons -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Stage All" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding StageAllCommand}"
                                    Height="28" Padding="12,0" Margin="0,0,8,0"/>
                            <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"
                                    Height="28" Padding="12,0"
                                    Click="RefreshChanges_Click"/>
                        </StackPanel>

                        <!-- File list -->
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding PendingChanges}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Extended"
                                  Background="Transparent"
                                  RowBackground="{StaticResource CardBrush}"
                                  AlternatingRowBackground="{StaticResource SurfaceBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                  BorderThickness="0"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="File" Binding="{Binding FilePath}" Width="*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                                <DataGridTemplateColumn Header="Staged" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value=""/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStaged}" Value="True">
                                                                <Setter Property="Text" Value="Yes"/>
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Stage" FontSize="10"
                                                    Height="22" Padding="8,0"
                                                    Command="{Binding DataContext.StageFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Commit area -->
                        <Border Grid.Row="2" Margin="0,8,0,0" Padding="8"
                                Background="{StaticResource SurfaceBrush}" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" Height="60"
                                         Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         FontSize="13" Margin="0,0,8,0">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Content="Commit" Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding CommitChangesCommand}"
                                            Height="30" Width="90" Margin="0,0,0,4"/>
                                    <Button Content="Push" Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding PushCommand}"
                                            Height="30" Width="90"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ======================================================== -->
            <!-- TAB 2: FETCH / SYNC                                      -->
            <!-- ======================================================== -->
            <TabItem Header="Fetch / Sync">
                <Border Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Fetch buttons -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Fetch from Origin" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding FetchCommand}"
                                    Height="36" Padding="20,0" Margin="0,0,8,0"/>
                            <Button Content="Pull (Fetch + Merge)" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding PullCommand}"
                                    Height="36" Padding="20,0" Margin="0,0,8,0"/>
                            <Button Content="Push to Remote" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding PushCommand}"
                                    Height="36" Padding="20,0"/>
                        </StackPanel>

                        <!-- Auth credentials -->
                        <Border Grid.Row="1" Padding="8" Margin="0,0,0,8"
                                Background="{StaticResource SurfaceBrush}" CornerRadius="4">
                            <StackPanel>
                                <CheckBox Content="Requires Authentication"
                                          IsChecked="{Binding CloneNeedsAuth}"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding CloneNeedsAuth, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Username:" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="150" Height="26" Margin="0,0,12,0"
                                             Text="{Binding CloneUsername, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Password:" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <PasswordBox Width="150" Height="26" x:Name="AuthPasswordBox"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Last fetch info -->
                        <Border Grid.Row="2" Padding="8" Margin="0,0,0,8"
                                Background="{StaticResource CardBrush}" CornerRadius="4">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Last Fetch: " FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding LastFetchTime}" FontSize="12"
                                               Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding LastFetchResult}" FontSize="12"
                                           Foreground="{StaticResource SuccessBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Remote branches -->
                        <GroupBox Grid.Row="3" Header="Remote Branches"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource BorderBrush}">
                            <ListBox ItemsSource="{Binding RemoteBranches}"
                                     Background="Transparent"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderThickness="0"/>
                        </GroupBox>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ======================================================== -->
            <!-- TAB 3: HISTORY                                           -->
            <!-- ======================================================== -->
            <TabItem Header="History">
                <Border Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,8,0,0">
                    <DataGrid ItemsSource="{Binding CommitHistory}"
                              SelectedItem="{Binding SelectedCommit}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              Background="Transparent"
                              RowBackground="{StaticResource CardBrush}"
                              AlternatingRowBackground="{StaticResource SurfaceBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                              BorderThickness="0"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SHA" Binding="{Binding ShortSha}" Width="70"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                            <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="120"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateFormatted}" Width="130"/>
                            <DataGridTemplateColumn Header="Actions" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Revert" FontSize="10"
                                                    Height="22" Padding="8,0" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.RevertToCommitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Branch" FontSize="10"
                                                    Height="22" Padding="8,0"
                                                    Command="{Binding DataContext.CreateBranchFromCommitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <!-- ======================================================== -->
            <!-- TAB 4: BRANCHES                                          -->
            <!-- ======================================================== -->
            <TabItem Header="Branches">
                <Border Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Create Branch" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding CreateBranchCommand}"
                                    Height="30" Padding="14,0" Margin="0,0,8,0"/>
                            <Button Content="Merge to Main" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding MergeToMainCommand}"
                                    Height="30" Padding="14,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <GroupBox Grid.Column="0" Header="Local Branches" Margin="0,0,4,0"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      BorderBrush="{StaticResource BorderBrush}">
                                <ListBox ItemsSource="{Binding LocalBranches}"
                                         SelectedItem="{Binding SelectedBranch}"
                                         Background="Transparent"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" FontSize="13" Margin="0,2"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </GroupBox>

                            <GroupBox Grid.Column="1" Header="Remote Branches" Margin="4,0,0,0"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      BorderBrush="{StaticResource BorderBrush}">
                                <ListBox ItemsSource="{Binding RemoteBranches}"
                                         Background="Transparent"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="13" Margin="0,2"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ======================================================== -->
            <!-- TAB 5: LFS                                              -->
            <!-- ======================================================== -->
            <TabItem Header="LFS">
                <Border Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- LFS Status -->
                        <Border Grid.Row="0" Padding="8" Margin="0,0,0,8"
                                Background="{StaticResource SurfaceBrush}" CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Git LFS: " FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Not Installed"/>
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLfsEnabled}" Value="True">
                                                    <Setter Property="Text" Value="Enabled"/>
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- LFS Actions -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Initialize LFS" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding InitLfsCommand}"
                                    Height="30" Padding="14,0" Margin="0,0,8,0"
                                    ToolTip="Initialize Git LFS in the current repository"/>
                            <Button Content="Add Pattern" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding AddLfsPatternCommand}"
                                    Height="30" Padding="14,0"
                                    ToolTip="Track a new file pattern with Git LFS"/>
                        </StackPanel>

                        <!-- Tracked Patterns Header -->
                        <TextBlock Grid.Row="2" Text="TRACKED PATTERNS" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,6"/>

                        <!-- Tracked Patterns List -->
                        <GroupBox Grid.Row="3" Header="LFS File Patterns"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource BorderBrush}">
                            <ListBox ItemsSource="{Binding LfsTrackedPatterns}"
                                     Background="Transparent"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderThickness="0"
                                     FontSize="13"
                                     FontFamily="Consolas">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="13" Margin="0,2"
                                                   FontFamily="Consolas"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ======================================================== -->
            <!-- TAB 6: ACTIVITY LOG                                      -->
            <!-- ======================================================== -->
            <TabItem Header="Activity Log">
                <Border Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,8,0,0">
                    <ListBox ItemsSource="{Binding ActivityLog}"
                             Background="Transparent"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             BorderThickness="0"
                             FontSize="12"
                             FontFamily="Consolas"/>
                </Border>
            </TabItem>

            <!-- ======================================================== -->
            <!-- TAB 7: TERMINAL                                          -->
            <!-- ======================================================== -->
            <TabItem Header="Terminal">
                <Border Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Terminal Output -->
                        <TextBox Grid.Row="0"
                                 Text="{Binding TerminalOutput, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 Background="#1E1E1E"
                                 Foreground="#00FF00"
                                 BorderThickness="0"
                                 Padding="8"
                                 VerticalAlignment="Stretch"/>

                        <!-- Terminal Input -->
                        <Border Grid.Row="1" Padding="0" Margin="0,8,0,0"
                                Background="#1E1E1E" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="$" FontFamily="Consolas" FontSize="14"
                                           Foreground="#00FF00" VerticalAlignment="Center"
                                           Margin="8,0,6,0" FontWeight="Bold"/>

                                <TextBox Grid.Column="1" Height="32"
                                         Text="{Binding TerminalCommand, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Consolas" FontSize="13"
                                         Background="#2D2D2D" Foreground="#00FF00"
                                         BorderThickness="0" Padding="6,4"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Enter a git command (e.g., git status, git log --oneline)">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return"
                                                    Command="{Binding ExecuteTerminalCommandCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>

                                <Button Grid.Column="2" Content="Execute" Height="32" Padding="14,0" Margin="6,0,0,0"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ExecuteTerminalCommandCommand}"
                                        ToolTip="Execute the git command"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ======================================================== -->
            <!-- TAB 8: LIVE HOSTS                                        -->
            <!-- ======================================================== -->
            <TabItem Header="Live Hosts">
                <Border Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Host status -->
                        <Border Grid.Row="0" Padding="8" Margin="0,0,0,8"
                                Background="{StaticResource SurfaceBrush}" CornerRadius="4">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Host Status: " FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding HostStatusText}" FontSize="12"
                                               Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsHosting, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Secret Code: " FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding HostSecretCode}" FontSize="12"
                                               Foreground="{StaticResource SuccessBrush}" FontWeight="Bold"
                                               FontFamily="Consolas"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Hosted repos list -->
                        <TextBlock Grid.Row="1" Text="HOSTED REPOSITORIES" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,6"/>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding LiveHostedRepos}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  Background="Transparent"
                                  RowBackground="{StaticResource CardBrush}"
                                  AlternatingRowBackground="{StaticResource SurfaceBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                  BorderThickness="0"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*"/>
                                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="60"/>
                                <DataGridTemplateColumn Header="Private" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="No"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPrivate}" Value="True">
                                                                <Setter Property="Text" Value="Yes"/>
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Secret Code" Binding="{Binding SecretCode}" Width="200"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Secret code entry for accessing private hosted repos -->
                        <Border Grid.Row="3" Padding="8" Margin="0,8,0,0"
                                Background="{StaticResource SurfaceBrush}" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="ACCESS PRIVATE REPOSITORY" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Secret Code:" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="300" Height="28" FontSize="13"
                                             FontFamily="Consolas" Margin="0,0,8,0"
                                             Text="{Binding SecretCodeEntry, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Content="Validate" Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding AccessPrivateRepoCommand}"
                                            Height="28" Padding="16,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ============================================================ -->
        <!-- CLONE DIALOG OVERLAY                                         -->
        <!-- ============================================================ -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Background="#CC000000"
                Visibility="{Binding IsCloneDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="100">
            <Border Width="500" Height="380"
                    Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="24"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="CLONE REPOSITORY" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="Repository URL (HTTPS or SSH):" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding CloneUrl, UpdateSourceTrigger=PropertyChanged}"
                             Height="28" FontSize="13" Margin="0,0,0,12"/>

                    <TextBlock Text="Local folder name (optional):" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding CloneLocalName, UpdateSourceTrigger=PropertyChanged}"
                             Height="28" FontSize="13" Margin="0,0,0,12"/>

                    <CheckBox Content="Private repository (requires authentication)"
                              IsChecked="{Binding CloneNeedsAuth}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,0,0,8"/>

                    <StackPanel Visibility="{Binding CloneNeedsAuth, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Username:" Width="80" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding CloneUsername, UpdateSourceTrigger=PropertyChanged}"
                                     Width="200" Height="26"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Password:" Width="80" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="ClonePasswordBox" Width="200" Height="26"
                                         PasswordChanged="ClonePasswordBox_PasswordChanged"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                                Height="32" Padding="20,0" Margin="0,0,8,0"
                                Click="CancelCloneDialog_Click"/>
                        <Button Content="Clone" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ExecuteCloneCommand}"
                                Height="32" Padding="20,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ============================================================ -->
        <!-- NEW REPO DIALOG OVERLAY                                      -->
        <!-- ============================================================ -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Background="#CC000000"
                Visibility="{Binding IsNewRepoDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="100">
            <Border Width="400" Height="200"
                    Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="24"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="NEW REPOSITORY" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="Repository name:" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewRepoName, UpdateSourceTrigger=PropertyChanged}"
                             Height="28" FontSize="13" Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                                Height="32" Padding="20,0" Margin="0,0,8,0"
                                Click="CancelNewRepoDialog_Click"/>
                        <Button Content="Create" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ExecuteNewRepoCommand}"
                                Height="32" Padding="20,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ============================================================ -->
        <!-- HOST DIALOG OVERLAY                                          -->
        <!-- ============================================================ -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Background="#CC000000"
                Visibility="{Binding IsHostDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="100">
            <Border Width="520" Height="420"
                    Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="24"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="HOST REPOSITORY" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="Folder to host:" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Height="28" FontSize="13"
                                 Text="{Binding HostFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Browse..."
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding SelectHostFolderCommand}"
                                Height="28" Padding="12,0"/>
                    </Grid>

                    <TextBlock Text="Repository name:" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding HostRepoName, UpdateSourceTrigger=PropertyChanged}"
                             Height="28" FontSize="13" Margin="0,0,0,12"/>

                    <TextBlock Text="Port:" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding HostPort, UpdateSourceTrigger=PropertyChanged}"
                             Width="100" Height="28" FontSize="13" Margin="0,0,0,12"
                             HorizontalAlignment="Left"/>

                    <CheckBox Content="Private repository (generates secret code)"
                              IsChecked="{Binding HostIsPrivate}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelHostDialogCommand}"
                                Height="32" Padding="20,0" Margin="0,0,8,0"/>
                        <Button Content="Start Hosting" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding StartHostingCommand}"
                                Height="32" Padding="20,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
