<UserControl x:Class="SGL.JudgeDredd.App.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                MaxWidth="500" MaxHeight="700" Padding="40"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <!-- Header -->
                <TextBlock Text="Create Account" FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="SGL SyntheticAI Security" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <!-- Error Message -->
                <Border Background="#44FF4444" CornerRadius="4" Padding="10" Margin="0,0,0,12"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                </Border>

                <!-- Username -->
                <TextBlock Text="Username (min 3 characters)" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" Padding="10,8" Margin="0,0,0,12"
                         Background="{StaticResource CardBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         CaretBrush="{StaticResource TextPrimaryBrush}"/>

                <!-- Email -->
                <TextBlock Text="Email Address" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" Padding="10,8" Margin="0,0,0,12"
                         Background="{StaticResource CardBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         CaretBrush="{StaticResource TextPrimaryBrush}"/>

                <!-- Password -->
                <TextBlock Text="Password (min 4 characters)" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" Margin="0,0,0,6"/>
                <PasswordBox x:Name="PasswordBox" FontSize="14" Padding="10,8" Margin="0,0,0,12"
                             Background="{StaticResource CardBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             PasswordChanged="PasswordBox_PasswordChanged"/>

                <!-- Confirm Password -->
                <TextBlock Text="Confirm Password" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" Margin="0,0,0,6"/>
                <PasswordBox x:Name="ConfirmPasswordBox" FontSize="14" Padding="10,8" Margin="0,0,0,16"
                             Background="{StaticResource CardBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>

                <!-- EULA Mini Agreement -->
                <Border Background="{StaticResource CardBrush}" CornerRadius="4"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Padding="10" Margin="0,0,0,12" MaxHeight="120">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock TextWrapping="Wrap" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}" LineHeight="16">
                            By creating an account you agree to the SGL-AI JD End-User License Agreement.
                            This software requires administrator privileges and will access system files,
                            monitor processes, modify firewall rules, and may quarantine files identified
                            as threats. The AI analysis is probabilistic and NOT infallible.
                            The developer is NOT liable for any data loss, system damage, or security
                            breaches. Your account information will be stored locally and your username
                            and email will be sent to the administrator for account management.
                        </TextBlock>
                    </ScrollViewer>
                </Border>

                <CheckBox IsChecked="{Binding HasAcceptedTerms, Mode=TwoWay}"
                          Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,20">
                    <TextBlock Text="I agree to the EULA and Terms of Service" TextWrapping="Wrap"/>
                </CheckBox>

                <!-- Register Button -->
                <Button Content="Create Account" Height="42" FontSize="15"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="{Binding HasAcceptedTerms}"
                        Command="{Binding RegisterCommand}"
                        Margin="0,0,0,16"/>

                <!-- Back to Login -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Already have an account? "
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock FontSize="12" Cursor="Hand" MouseLeftButtonUp="BackToLogin_Click">
                        <Underline><Run Text="Log In" Foreground="{StaticResource PrimaryBrush}"/></Underline>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
