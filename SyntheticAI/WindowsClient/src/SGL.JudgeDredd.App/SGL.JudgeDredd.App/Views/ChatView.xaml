<UserControl x:Class="SGL.JudgeDredd.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:enums="clr-namespace:SGL.JudgeDredd.Core.Enums;assembly=SGL.JudgeDredd.Core"
             xmlns:loc="clr-namespace:SGL.JudgeDredd.Shared.Localization;assembly=SGL.JudgeDredd.Shared"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Page title and toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- SyntheticAI Avatar Face -->
                <Border Width="40" Height="40" CornerRadius="20"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="2" Margin="0,0,12,0">
                    <Grid>
                        <!-- Helmet visor shape -->
                        <Border CornerRadius="20" Background="{StaticResource CardBrush}">
                            <Canvas Width="40" Height="40">
                                <!-- Helmet top -->
                                <Border Canvas.Left="4" Canvas.Top="2" Width="32" Height="12"
                                        Background="{StaticResource PrimaryBrush}" CornerRadius="8,8,0,0"/>
                                <!-- Visor -->
                                <Border Canvas.Left="6" Canvas.Top="13" Width="28" Height="8"
                                        CornerRadius="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FF1A1A2E"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsModelLoaded}" Value="True">
                                                    <Setter Property="Background" Value="#FF00C853"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsModelLoading}" Value="True">
                                                    <Setter Property="Background" Value="#FFFFD600"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                                    <Setter Property="Background" Value="#FF2196F3"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <!-- Mouth guard -->
                                <Border Canvas.Left="10" Canvas.Top="24" Width="20" Height="10"
                                        Background="{StaticResource SurfaceBrush}" CornerRadius="0,0,4,4">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                VerticalAlignment="Center" Margin="2">
                                        <Border Width="3" Height="5" Background="{StaticResource BorderBrush}" Margin="1,0"/>
                                        <Border Width="3" Height="5" Background="{StaticResource BorderBrush}" Margin="1,0"/>
                                        <Border Width="3" Height="5" Background="{StaticResource BorderBrush}" Margin="1,0"/>
                                    </StackPanel>
                                </Border>
                            </Canvas>
                        </Border>
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SyntheticAI" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock FontSize="10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                <Setter Property="Text" Value="OFFLINE"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModelLoaded}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        <Setter Property="Text" Value="ONLINE - Ready"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsModelLoading}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                        <Setter Property="Text" Value="LOADING..."/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="Text" Value="THINKING..."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[chat.clear]}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ClearChatCommand}"
                        Padding="12,6" FontSize="12"
                        Margin="0,0,8,0"/>
                <Button Content="/scan"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ScanSystemCommand}"
                        Padding="12,6" FontSize="12"
                        Margin="0,0,8,0"
                        ToolTip="Run a quick system scan"/>
                <Button Content="/security"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CheckSecurityCommand}"
                        Padding="12,6" FontSize="12"
                        Margin="0,0,8,0"
                        ToolTip="Check security status"/>
                <Button Content="/code"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding GenerateCodeCommand}"
                        Padding="12,6" FontSize="12"
                        Margin="0,0,8,0"
                        ToolTip="Generate security utility code"/>
                <Button Content="/analyze"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding AnalyzeDeviceCommand}"
                        Padding="12,6" FontSize="12"
                        Margin="0,0,8,0"
                        ToolTip="Analyze this device with real system data"/>
                <Button Content="/image"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding GenerateImageCommand}"
                        Padding="12,6" FontSize="12"
                        ToolTip="Generate an image from description"/>
            </StackPanel>
        </Grid>

        <!-- Loading progress bar with timer - visible only while loading -->
        <Border Grid.Row="1" Margin="0,0,0,8"
                Visibility="{Binding IsModelLoading, Converter={StaticResource BoolToVis}}">
            <Border Padding="12,8" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="{StaticResource DefaultCornerRadius}"
                    BorderBrush="{StaticResource WarningBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="{Binding ModelLoadProgress}"
                                   Foreground="{StaticResource WarningBrush}"
                                   FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LoadingElapsedText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <ProgressBar Grid.Row="1" Height="6"
                                 Value="{Binding LoadingProgressPercent}"
                                 Minimum="0" Maximum="100"
                                 Background="{StaticResource CardBrush}"
                                 Foreground="{StaticResource WarningBrush}"
                                 BorderThickness="0"/>
                </Grid>
            </Border>
        </Border>

        <!-- Model status bar (compact when not loading) -->
        <Border Grid.Row="2" Padding="8,4" Margin="0,0,0,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsModelLoading}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModelLoaded}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontSize="11" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                <Setter Property="Text" Value="Model not loaded - Click 'Load Model' to start"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModelLoaded}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        <Setter Property="Text" Value="Model loaded - AI fully operational"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[chat.loadModel]}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding LoadModelCommand}"
                        HorizontalAlignment="Right"
                        Padding="16,4" FontSize="11"
                        Height="28"/>
            </Grid>
        </Border>

        <!-- Messages area -->
        <Border Grid.Row="3"
                Style="{StaticResource SurfaceBorderStyle}"
                Padding="0">
            <ScrollViewer x:Name="ChatScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Padding="12">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <!-- User message -->
                                <Border Padding="12,8"
                                        CornerRadius="{StaticResource LargeCornerRadius}"
                                        Margin="120,0,0,0"
                                        HorizontalAlignment="Right">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="{x:Static enums:ChatRole.User}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBox Text="{Binding Content, Mode=OneWay}"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 TextWrapping="Wrap" FontSize="13"
                                                 IsReadOnly="True" BorderThickness="0"
                                                 Background="Transparent" Padding="0"/>
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                                   Foreground="#80FFFFFF"
                                                   FontSize="10" HorizontalAlignment="Right"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Assistant message with SyntheticAI avatar -->
                                <Border Padding="0"
                                        Margin="0,0,80,0"
                                        HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="{x:Static enums:ChatRole.Assistant}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                        <!-- Mini avatar -->
                                        <Border Width="28" Height="28" CornerRadius="14"
                                                Background="{StaticResource PrimaryBrush}"
                                                Margin="0,0,8,0" VerticalAlignment="Top">
                                            <TextBlock Text="JD" FontSize="10" FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Padding="12,8"
                                                CornerRadius="{StaticResource LargeCornerRadius}"
                                                Background="{StaticResource CardBrush}">
                                            <StackPanel>
                                                <TextBlock Text="SyntheticAI"
                                                           Foreground="{StaticResource SecondaryBrush}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Margin="0,0,0,4"/>
                                                <!-- Collapsible thinking section with summary -->
                                                <Expander Margin="0,0,0,6"
                                                          IsExpanded="{Binding IsThinkingExpanded, Mode=TwoWay}"
                                                          Foreground="{StaticResource TextSecondaryBrush}"
                                                          FontSize="10"
                                                          Visibility="{Binding HasThinking, Converter={StaticResource BoolToVis}}">
                                                    <Expander.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#x1F4AD; "
                                                                       FontSize="11"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock FontStyle="Italic"
                                                                       FontSize="11"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[chat.showThinking]}"/>
                                                                        <Setter Property="Foreground" Value="#88AAAAAA"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                                                                <Setter Property="Text" Value="Thinking..."/>
                                                                                <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding ThinkingSummary, Mode=OneWay}"
                                                                       FontStyle="Italic"
                                                                       Foreground="#88888888"
                                                                       FontSize="11"
                                                                       MaxWidth="350"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"
                                                                       Margin="6,0,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <Border Background="{StaticResource CardBrush}"
                                                            CornerRadius="6" Padding="10,8" Margin="0,4,0,0"
                                                            MaxHeight="220"
                                                            BorderBrush="#20AAAAAA" BorderThickness="1">
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                            <TextBlock Text="{Binding ThinkingContent, Mode=OneWay}"
                                                                       Foreground="#AAAAAA"
                                                                       FontSize="11.5" FontStyle="Italic"
                                                                       TextWrapping="Wrap"
                                                                       LineHeight="18"/>
                                                        </ScrollViewer>
                                                    </Border>
                                                </Expander>
                                                <!-- Answer text (without thinking tags) -->
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                              MaxHeight="400">
                                                    <TextBox Text="{Binding DisplayText, Mode=OneWay}"
                                                             Foreground="{StaticResource TextPrimaryBrush}"
                                                             TextWrapping="NoWrap" FontSize="13"
                                                             IsReadOnly="True" BorderThickness="0"
                                                             Background="Transparent" Padding="0"/>
                                                </ScrollViewer>
                                                <!-- Inline image display for generated images -->
                                                <Image Source="{Binding ImagePath}" MaxWidth="400" MaxHeight="400"
                                                       Margin="0,8,0,0" Stretch="Uniform"
                                                       Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="10"/>
                                                    <TextBlock Text=" ..."
                                                               Foreground="{StaticResource SecondaryBrush}"
                                                               FontSize="10"
                                                               Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVis}}"/>
                                                    <!-- TTS Speak button for assistant messages -->
                                                    <Button Content="&#xE767;"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            FontSize="12"
                                                            Margin="8,0,0,0"
                                                            Padding="4,2"
                                                            Background="Transparent"
                                                            Foreground="{StaticResource SecondaryBrush}"
                                                            BorderThickness="0"
                                                            ToolTip="Speak this message"
                                                            Cursor="Hand"
                                                            Visibility="{Binding DataContext.IsTtsAvailable, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.SpeakMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- TTS Controls (visible when TTS server is available) -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,4"
                    Visibility="{Binding IsTtsAvailable, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Voice:" Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="4,0,6,0" FontSize="12"/>
            <ComboBox ItemsSource="{Binding AvailableVoices}"
                      SelectedItem="{Binding SelectedVoice}"
                      MinWidth="100" FontSize="12" Padding="4,3"
                      Background="{StaticResource SurfaceBrush}"
                      Foreground="{StaticResource TextPrimaryBrush}"/>
            <Button Content="Stop Speaking" Margin="8,0,0,0" Padding="8,3"
                    FontSize="12" Cursor="Hand"
                    Visibility="{Binding IsSpeaking, Converter={StaticResource BoolToVis}}"
                    Command="{Binding StopSpeakingCommand}"
                    Background="{StaticResource DangerBrush}"
                    Foreground="White"/>
        </StackPanel>

        <!-- Image Generation Panel (collapsible) -->
        <Expander Grid.Row="5" Margin="0,4,0,0"
                  IsExpanded="{Binding IsImageGenPanelOpen}"
                  Foreground="{StaticResource TextPrimaryBrush}">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets"
                               FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource SecondaryBrush}"/>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[chat.imageGen]}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Margin="10,0,0,0" FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="{Binding ImageGenStatusText}"/>
                </StackPanel>
            </Expander.Header>
            <Border Background="{StaticResource SurfaceBrush}"
                    CornerRadius="{StaticResource DefaultCornerRadius}"
                    Padding="12" Margin="0,6,0,0"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Controls -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <!-- Prompt -->
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[chat.prompt]}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ImagePrompt, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource CardBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 FontSize="12" Padding="8,6"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 MinHeight="50" MaxHeight="80"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="Describe the image you want to generate"/>

                        <!-- Negative Prompt -->
                        <TextBlock Text="Negative Prompt" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding ImageNegativePrompt, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource CardBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 FontSize="12" Padding="8,6"
                                 TextWrapping="Wrap" MaxHeight="50"
                                 ToolTip="Describe what you do NOT want in the image"/>

                        <!-- Settings Row -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Resolution -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Resolution" FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <ComboBox SelectedItem="{Binding ImageResolution}"
                                          ItemsSource="{Binding ImageResolutions}"
                                          MinWidth="110" FontSize="11" Padding="6,4"
                                          Background="{StaticResource CardBrush}"
                                          Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <!-- Steps Slider -->
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Steps: " FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding ImageSteps}" FontSize="10"
                                               Foreground="{StaticResource SecondaryBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <Slider Value="{Binding ImageSteps}" Minimum="10" Maximum="100"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- CFG Scale Slider -->
                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="CFG Scale: " FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding ImageCfgScale, StringFormat={}{0:F1}}" FontSize="10"
                                               Foreground="{StaticResource SecondaryBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <Slider Value="{Binding ImageCfgScale}" Minimum="1" Maximum="20"
                                        TickFrequency="0.5" IsSnapToTickEnabled="True"
                                        Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[chat.generate]}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding GenerateImagePanelCommand}"
                                    Padding="16,6" FontSize="12"
                                    Margin="0,0,8,0"
                                    ToolTip="Generate image from prompt"/>
                            <Button Content="Regenerate"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RegenerateImageCommand}"
                                    Padding="12,6" FontSize="12"
                                    Margin="0,0,8,0"
                                    ToolTip="Regenerate with same settings but new seed"/>
                            <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[common.download]}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding DownloadGeneratedImageCommand}"
                                    Padding="12,6" FontSize="12"
                                    IsEnabled="{Binding HasGeneratedImage}"
                                    ToolTip="Save the generated image to disk"/>
                        </StackPanel>

                        <!-- Status Text -->
                        <TextBlock Text="{Binding ImageGenProgress}"
                                   FontSize="11" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Right: Image Preview -->
                    <Border Grid.Column="1" MinWidth="200" MinHeight="200"
                            MaxWidth="300" MaxHeight="300"
                            Background="{StaticResource CardBrush}"
                            CornerRadius="{StaticResource DefaultCornerRadius}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            VerticalAlignment="Top">
                        <Grid>
                            <!-- Placeholder when no image -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasNoGeneratedImage, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="36" HorizontalAlignment="Center"
                                           Foreground="{StaticResource BorderBrush}"/>
                                <TextBlock Text="No image generated" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                            <!-- Generated image display -->
                            <Image Source="{Binding GeneratedImageSource}"
                                   Stretch="Uniform" Margin="4"
                                   Visibility="{Binding HasGeneratedImage, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Expander>

        <!-- Input area -->
        <Border Grid.Row="6"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="{StaticResource DefaultCornerRadius}"
                Padding="4" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         Background="{StaticResource SurfaceBrush}"
                         BorderThickness="0"
                         FontSize="14"
                         Padding="12,10"
                         VerticalAlignment="Center"
                         AcceptsReturn="False"/>

                <Button Grid.Column="1"
                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[chat.send]}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SendMessageCommand}"
                        Padding="20,10"
                        Margin="4"
                        VerticalAlignment="Center"/>

                <Button Grid.Column="2"
                        Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[scan.stop]}"
                        Padding="16,10"
                        Margin="4"
                        VerticalAlignment="Center"
                        Command="{Binding StopGenerationCommand}"
                        Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
