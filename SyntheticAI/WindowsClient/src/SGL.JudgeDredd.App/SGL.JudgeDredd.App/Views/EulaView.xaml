<UserControl x:Class="SGL.JudgeDredd.App.Views.EulaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10">
            <TextBlock Text="SGL-AI JD" FontSize="36" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="SyntheticAI Security Suite" FontSize="16"
                       Foreground="{StaticResource SecondaryBrush}" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Warning Banner -->
        <Border Grid.Row="1" Background="#44FF4444" BorderBrush="{StaticResource DangerBrush}"
                BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="IMPORTANT - PLEASE READ CAREFULLY" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" LineHeight="20">
                    This software requires ADMINISTRATOR PRIVILEGES and will access your system files,
                    monitor processes, modify firewall rules, and may quarantine or delete files identified as threats.
                    The AI analysis is probabilistic and NOT infallible. False positives may occur.
                    We are NOT responsible for any data loss, system damage, or security breaches.
                    Please read the full End-User License Agreement below before proceeding.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- EULA Scroll Area -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Visible" Padding="16"
                          x:Name="EulaScrollViewer" ScrollChanged="EulaScrollViewer_ScrollChanged">
                <TextBlock Text="{Binding EulaText}" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                           FontFamily="Consolas" LineHeight="20"/>
            </ScrollViewer>
        </Border>

        <!-- Scroll Indicator -->
        <TextBlock Grid.Row="3" x:Name="ScrollHintText"
                   Text="Please scroll to the bottom to read the entire agreement"
                   Foreground="{StaticResource WarningBrush}" FontSize="11"
                   HorizontalAlignment="Center" Margin="0,0,0,8"/>

        <!-- Accept Checkbox and Buttons -->
        <StackPanel Grid.Row="4" HorizontalAlignment="Center">
            <CheckBox x:Name="AcceptCheckBox" Margin="0,0,0,16"
                      IsEnabled="{Binding HasScrolledToBottom}"
                      IsChecked="{Binding HasAcceptedEula, Mode=TwoWay}"
                      Foreground="{StaticResource TextPrimaryBrush}" FontSize="13">
                <TextBlock TextWrapping="Wrap" MaxWidth="500">
                    I have read, understood, and agree to the End-User License Agreement.
                    I acknowledge the warnings and accept all risks.
                </TextBlock>
            </CheckBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Decline &amp; Exit" Width="150" Height="40" Margin="0,0,16,0"
                        Style="{StaticResource DangerButtonStyle}"
                        Command="{Binding DeclineCommand}"/>
                <Button Content="I Agree - Continue" Width="180" Height="40"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="{Binding HasAcceptedEula}"
                        Command="{Binding AcceptCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
