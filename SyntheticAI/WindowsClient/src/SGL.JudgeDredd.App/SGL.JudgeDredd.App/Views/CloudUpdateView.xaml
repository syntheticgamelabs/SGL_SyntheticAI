<UserControl x:Class="SGL.JudgeDredd.App.Views.CloudUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="950"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>

            <!-- ══════════════════════════════════════════════════════════
                 HEADER
                 ══════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cloud icon -->
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                            Background="{StaticResource PrimaryBrush}" Margin="0,0,14,0">
                        <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title and status -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Signature Updates" Style="{StaticResource HeadingTextStyle}"/>
                        <TextBlock Text="{Binding UpdateStatusText}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Import button -->
                    <Button Grid.Column="2" Content="Import Signatures"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ImportSignaturesCommand}"
                            Padding="14,8" FontSize="12" Margin="0,0,8,0"
                            VerticalAlignment="Center"/>

                    <!-- Check Now button -->
                    <Button Grid.Column="3" Content="Check Now"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CheckForUpdatesCommand}"
                            Padding="16,8" FontSize="12" Margin="0,0,8,0"
                            VerticalAlignment="Center"/>

                    <!-- Checking spinner text -->
                    <TextBlock Grid.Column="4" Text="Checking..."
                               FontSize="11" FontStyle="Italic"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 STATS CARDS ROW
                 ══════════════════════════════════════════════════════════ -->
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,16">
                <!-- Current Version -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                    <StackPanel HorizontalAlignment="Center" Margin="10">
                        <TextBlock Text="CURRENT VERSION" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentVersion}" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Total Signatures -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="4,0">
                    <StackPanel HorizontalAlignment="Center" Margin="10">
                        <TextBlock Text="TOTAL SIGNATURES" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalSignatures, StringFormat='{}{0:N0}'}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Last Updated -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="4,0">
                    <StackPanel HorizontalAlignment="Center" Margin="10">
                        <TextBlock Text="LAST CHECK" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding LastCheckTime}" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center">
                            <Run Text="Next: "/><Run Text="{Binding NextCheckTime, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- DB Size -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
                    <StackPanel HorizontalAlignment="Center" Margin="10">
                        <TextBlock Text="DB SIZE" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding DatabaseSizeText}" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource WarningBrush}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding NewSignatures24h, StringFormat='+{0} today'}"
                                   FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ══════════════════════════════════════════════════════════
                 UPDATE AVAILABLE BANNER
                 ══════════════════════════════════════════════════════════ -->
            <Border Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                    CornerRadius="{StaticResource DefaultCornerRadius}"
                    Padding="18,14" Margin="0,0,0,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1A4CAF50" Offset="0"/>
                        <GradientStop Color="#1A2196F3" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="#4CAF50" Opacity="0.4"/>
                </Border.BorderBrush>
                <Border.BorderThickness>1</Border.BorderThickness>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Update icon -->
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                            Background="{StaticResource SuccessBrush}" Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Update info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Update Available: " FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding LatestVersion}" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PendingUpdates, StringFormat='{}{0} package(s) pending'}"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Download & Apply button -->
                    <Button Grid.Column="2" Content="Download &amp; Apply"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ApplyUpdateCommand}"
                            Padding="18,10" FontSize="13" FontWeight="SemiBold"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Download progress bar (visible during update) -->
            <Border Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}"
                    Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="{Binding UpdateStatusText}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding UpdateProgress, StringFormat='{}{0:F0}%'}"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontSize="12" FontWeight="SemiBold"/>
                    </Grid>
                    <ProgressBar Value="{Binding UpdateProgress}" Maximum="100" Height="12"
                                 Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 AUTO-UPDATE SETTINGS
                 ══════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="&#xE895;" FontFamily="Segoe MDL2 Assets"
                               FontSize="18" Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Automatic Updates" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Automatically check and apply signature updates"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="Interval (min):" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="3"
                             Text="{Binding AutoUpdateInterval, UpdateSourceTrigger=PropertyChanged}"
                             Width="50" Padding="6,4" FontSize="12"
                             HorizontalContentAlignment="Center"
                             Background="{StaticResource CardBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource SurfaceBrush}"
                             VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <ToggleButton Grid.Column="4" Content="{Binding AutoUpdateEnabled}"
                                  IsChecked="{Binding AutoUpdateEnabled}"
                                  Command="{Binding ToggleAutoUpdateCommand}"
                                  VerticalAlignment="Center" Padding="10,6" MinWidth="60">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Content" Value="OFF"/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Content" Value="ON"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 SIGNATURE SOURCES
                 ══════════════════════════════════════════════════════════ -->
            <TextBlock Text="Signature Sources" Style="{StaticResource SubheadingTextStyle}" Margin="0,0,0,10"/>

            <ItemsControl ItemsSource="{Binding Sources}" Margin="0,0,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}"
                                CornerRadius="{StaticResource DefaultCornerRadius}"
                                Padding="14,10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Status dot -->
                                <Ellipse Grid.Column="0" Width="10" Height="10"
                                         VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Disabled">
                                                    <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <!-- Source info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Url}" FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="Last check: "/><Run Text="{Binding LastCheckFormatted, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Signatures count -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                            HorizontalAlignment="Right" Margin="8,0,16,0">
                                    <TextBlock Text="{Binding SignaturesProvided, StringFormat='{}{0:N0}'}"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Text="signatures" FontSize="9"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>

                                <!-- Status badge -->
                                <Border Grid.Column="3" CornerRadius="4" Padding="8,3"
                                        VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#2000C853"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Disabled">
                                                    <Setter Property="Background" Value="#20808080"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                                    <Setter Property="Background" Value="#20FF1744"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Disabled">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- Enable/Disable toggle -->
                                <CheckBox Grid.Column="4" IsChecked="{Binding IsEnabled}"
                                          VerticalAlignment="Center"
                                          Command="{Binding DataContext.ToggleSourceCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ══════════════════════════════════════════════════════════
                 UPDATE HISTORY
                 ══════════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,10">
                <TextBlock Text="Update History" Style="{StaticResource SubheadingTextStyle}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Rollback Last" Padding="12,6" FontSize="11" Margin="0,0,8,0"
                            Command="{Binding RollbackLastUpdateCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Clear History" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ClearHistoryCommand}"
                            Padding="12,6" FontSize="11"/>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16" MaxHeight="280">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding UpdateHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}"
                                        CornerRadius="{StaticResource DefaultCornerRadius}"
                                        Padding="14,8" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Version -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Version}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding TimestampFormatted}" FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <!-- Signatures delta -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SignaturesAdded, StringFormat='+{0}'}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource SuccessBrush}"/>
                                                <TextBlock Text=" / " FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding SignaturesRemoved, StringFormat='-{0}'}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource DangerBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="signatures" FontSize="9"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <!-- Source -->
                                        <TextBlock Grid.Column="2" Text="{Binding Source}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Size -->
                                        <TextBlock Grid.Column="3" Text="{Binding SizeFormatted}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                        <!-- Status badge -->
                                        <Border Grid.Column="4" CornerRadius="4" Padding="8,3"
                                                VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="72"
                                                HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#2000C853"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                            <Setter Property="Background" Value="#20FF1744"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Rolled Back">
                                                            <Setter Property="Background" Value="#20FFC107"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Rolled Back">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 UPDATE LOG
                 ══════════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,8">
                <TextBlock Text="Update Log" Style="{StaticResource SubheadingTextStyle}"
                           VerticalAlignment="Center"/>
                <Button Content="Refresh Stats" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding RefreshStatsCommand}"
                        HorizontalAlignment="Right"
                        Padding="12,4" FontSize="11"/>
            </Grid>

            <Border Background="{StaticResource SurfaceBrush}"
                    CornerRadius="{StaticResource DefaultCornerRadius}"
                    Margin="0,0,0,8" Height="180">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ListBox ItemsSource="{Binding UpdateLog}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="8,1" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Focusable" Value="False"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
