<Window x:Class="SGL.JudgeDredd.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SGL.JudgeDredd.App.ViewModels"
        xmlns:views="clr-namespace:SGL.JudgeDredd.App.Views"
        xmlns:loc="clr-namespace:SGL.JudgeDredd.Shared.Localization;assembly=SGL.JudgeDredd.Shared"
        mc:Ignorable="d"
        Title="SGL SyntheticAI"
        Icon="Assets/Cover.png"
        Height="800" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding NavigateByIndexCommand}" CommandParameter="0"/>
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding NavigateByIndexCommand}" CommandParameter="1"/>
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding NavigateByIndexCommand}" CommandParameter="2"/>
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding NavigateByIndexCommand}" CommandParameter="3"/>
        <KeyBinding Key="D5" Modifiers="Ctrl" Command="{Binding NavigateByIndexCommand}" CommandParameter="4"/>
        <KeyBinding Key="D6" Modifiers="Ctrl" Command="{Binding NavigateByIndexCommand}" CommandParameter="5"/>
        <KeyBinding Key="D7" Modifiers="Ctrl" Command="{Binding NavigateByIndexCommand}" CommandParameter="6"/>
        <KeyBinding Key="D8" Modifiers="Ctrl" Command="{Binding NavigateByIndexCommand}" CommandParameter="7"/>
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding NavigateToSettingsCommand}"/>
        <KeyBinding Key="F1" Command="{Binding NavigateToHelpCommand}"/>
        <KeyBinding Key="Q" Modifiers="Ctrl+Shift" Command="{Binding QuickScanCommand}"/>
        <KeyBinding Key="F" Modifiers="Ctrl+Shift" Command="{Binding FullScanCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelScanCommand}"/>
        <KeyBinding Key="M" Modifiers="Ctrl+Shift" Command="{Binding MinimizeToTrayCommand}"/>
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding ClearChatCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- DataTemplates: map each ViewModel to its View -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScanViewModel}">
            <views:ScanView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FirewallViewModel}">
            <views:FirewallView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SecurityMonitorViewModel}">
            <views:SecurityMonitorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemCleanerViewModel}">
            <views:SystemCleanerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChatViewModel}">
            <views:ChatView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminPanelViewModel}">
            <views:AdminPanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProcessesViewModel}">
            <views:ProcessesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VpnViewModel}">
            <views:VpnView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UIEditorViewModel}">
            <views:UIEditorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HelpReadMeViewModel}">
            <views:HelpReadMeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TrackerViewModel}">
            <views:TrackerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DataLeakViewModel}">
            <views:DataLeakView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AiActivityViewModel}">
            <views:AiActivityView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmailScanViewModel}">
            <views:EmailScanView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BrowserProtectionViewModel}">
            <views:BrowserProtectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WebcamMicViewModel}">
            <views:WebcamMicView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuarantineVaultViewModel}">
            <views:QuarantineVaultView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScheduledScanViewModel}">
            <views:ScheduledScanView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FileIntegrityViewModel}">
            <views:FileIntegrityView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkIntrusionViewModel}">
            <views:NetworkIntrusionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:YaraRuleViewModel}">
            <views:YaraRuleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CloudUpdateViewModel}">
            <views:CloudUpdateView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GitViewModel}">
            <views:GitView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TestSpeedViewModel}">
            <views:TestSpeedView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShareViewModel}">
            <views:ShareView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FaqViewModel}">
            <views:FaqView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServerDashboardViewModel}">
            <views:ServerDashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EndpointMonitorViewModel}">
            <views:EndpointMonitorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkMonitorViewModel}">
            <views:NetworkMonitorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PersistenceScannerViewModel}">
            <views:PersistenceScannerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BehavioralAnomalyViewModel}">
            <views:BehavioralAnomalyView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ThreatReputationViewModel}">
            <views:ThreatReputationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IncidentReportViewModel}">
            <views:IncidentReportView/>
        </DataTemplate>
        <!-- V1.1.11 — Composite ViewModels (tab consolidation) -->
        <DataTemplate DataType="{x:Type vm:NetworkSecurityViewModel}">
            <views:NetworkSecurityView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemMonitorViewModel}">
            <views:SystemMonitorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ThreatIntelViewModel}">
            <views:ThreatIntelView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrivacyViewModel}">
            <views:PrivacyView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToolsViewModel}">
            <views:ToolsView/>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Title bar -->
                <RowDefinition Height="40"/>
                <!-- Content -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============================================================ -->
            <!-- CUSTOM TITLE BAR                                              -->
            <!-- ============================================================ -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="4,4,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="SGL"
                                   Style="{StaticResource NeonTitleStyle}"
                                   FontSize="15"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" SyntheticAI"
                                   Style="{StaticResource NeonTitleStyle}"
                                   FontWeight="SemiBold" FontSize="15"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Status text centered -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <!-- Window buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,4,0">
                        <!-- Language selector -->
                        <ComboBox ItemsSource="{Binding SettingsVm.SupportedLanguages}"
                                  SelectedItem="{Binding SettingsVm.SelectedLanguage}"
                                  Width="110" Height="28" FontSize="11"
                                  Margin="0,0,8,0" VerticalContentAlignment="Center"
                                  ToolTip="Select language"
                                  Background="{StaticResource CardBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource BorderBrush}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding FlagEmoji}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <!-- Minimize -->
                        <Button Style="{StaticResource IconButtonStyle}"
                                Click="MinimizeButton_Click"
                                ToolTip="Minimize"
                                Width="36" Height="36">
                            <TextBlock Text="&#x2500;" FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <!-- Maximize/Restore -->
                        <Button Style="{StaticResource IconButtonStyle}"
                                Click="MaximizeButton_Click"
                                ToolTip="Maximize"
                                Width="36" Height="36">
                            <TextBlock x:Name="MaximizeIcon" Text="&#x25A1;" FontSize="16"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <!-- Close -->
                        <Button Click="CloseButton_Click"
                                ToolTip="Close"
                                Width="36" Height="36">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#x2715;" FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- MAIN CONTENT AREA (SIDEBAR + CONTENT)                         -->
            <!-- ============================================================ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Sidebar -->
                    <ColumnDefinition Width="200"/>
                    <!-- Content -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ======================================================== -->
                <!-- LEFT SIDEBAR                                              -->
                <!-- ======================================================== -->
                <Border Grid.Column="0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <DockPanel>
                        <!-- Avatar area at top of sidebar -->
                        <Border DockPanel.Dock="Top"
                                Margin="12,16,12,8"
                                Padding="8"
                                Style="{StaticResource CardBorderStyle}">
                            <StackPanel HorizontalAlignment="Center">
                                <!-- Avatar placeholder -->
                                <Border Width="64" Height="64"
                                        CornerRadius="32"
                                        Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource PrimaryBrush}"
                                        BorderThickness="2"
                                        Margin="0,0,0,8">
                                    <Border.OpacityMask>
                                        <VisualBrush>
                                            <VisualBrush.Visual>
                                                <Border CornerRadius="32" Width="64" Height="64" Background="White"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Border.OpacityMask>
                                    <Image Source="{Binding LogoImageSource}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <!-- Speech bubble -->
                                <TextBlock Text="{Binding AvatarVm.SpeechBubbleText}"
                                           Foreground="{StaticResource SecondaryBrush}"
                                           FontSize="11" TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           MaxWidth="160"
                                           Visibility="{Binding AvatarVm.IsSpeechBubbleVisible,
                                               Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Protection status -->
                        <Border DockPanel.Dock="Top" Margin="12,0,12,12" Padding="8,6"
                                Cursor="Hand">
                            <Border.ToolTip>
                                <ToolTip MaxWidth="280">
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold" Margin="0,0,0,4">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="System Protected"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProtectionActive}" Value="False">
                                                            <Setter Property="Text" Value="System Unprotected"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Real-time protection is active. Your system is being monitored for threats, malware, and suspicious activity. All security guards are running."/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProtectionActive}" Value="False">
                                                            <Setter Property="Text" Value="Real-time protection is currently disabled. Your system is not being actively monitored. Go to Settings to enable real-time protection, or run a manual scan to check for threats."/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </ToolTip>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProtectionActive}" Value="False">
                                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="11" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            <Setter Property="Text" Value="Protected"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProtectionActive}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                    <Setter Property="Text" Value="Unprotected"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Server On/Off Toggle (Admin Only) -->
                        <Border DockPanel.Dock="Top" Margin="12,0,12,8" Padding="8,6"
                                Visibility="{Binding IsAdminUser, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="SERVER CONTROL" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                <Setter Property="Text" Value="Offline"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        <Setter Property="Text" Value="Online"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Command="{Binding ToggleServerCommand}"
                                            Padding="10,3" FontSize="10" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Setter Property="Content" Value="Start"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                                        <Setter Property="Content" Value="Stop"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Navigation List -->
                        <ListBox DockPanel.Dock="Top"
                                 ItemsSource="{Binding NavigationItems}"
                                 SelectedItem="{Binding SelectedNavigationItem}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Margin="8,0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="6,4"
                                                ToolTip="{Binding Description}"
                                                ToolTipService.InitialShowDelay="800"
                                                ToolTipService.ShowDuration="10000">
                                        <Ellipse Width="6" Height="6" Margin="0,0,10,0"
                                                 VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource PrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- User info and logout -->
                        <Border DockPanel.Dock="Bottom" Margin="12,4,12,12" Padding="8,6"
                                Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                    <TextBlock Text="User: " FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CurrentUserName}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[nav.admin]}" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource WarningBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,6"
                                           Visibility="{Binding IsAdminUser,
                                               Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <Button Content="Logout" Height="28" FontSize="11"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding LogoutCommand}"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>

                        <!-- Threat level indicator at bottom -->
                        <Border DockPanel.Dock="Bottom" Margin="12,0,12,4" Padding="8,6">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[dashboard.threatlevel]}" FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding ThreatLevel}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- ======================================================== -->
                <!-- CONTENT AREA                                              -->
                <!-- ======================================================== -->
                <Grid Grid.Column="1">
                    <ContentControl Content="{Binding CurrentView}"
                                    Margin="0"/>

                    <!-- Resize grip -->
                    <ResizeGrip HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Width="16" Height="16"
                                Cursor="SizeNWSE"
                                Opacity="0.4"/>
                </Grid>
            </Grid>

            <!-- ============================================================ -->
            <!-- TOAST NOTIFICATION OVERLAY                                    -->
            <!-- ============================================================ -->
            <Border Grid.Row="0" Grid.RowSpan="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,50,24,0"
                    Padding="16,10"
                    CornerRadius="6"
                    Background="#E0228B22"
                    BorderBrush="#4000FF00"
                    BorderThickness="1"
                    MaxWidth="350"
                    Visibility="{Binding IsNotificationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding NotificationText}"
                           Foreground="#FFFFFF"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- ============================================================ -->
            <!-- DDOS ALERT OVERLAY - Admin Only                               -->
            <!-- ============================================================ -->
            <Border x:Name="DdosAlertOverlay" Grid.Row="0" Grid.RowSpan="2"
                    IsHitTestVisible="False" Panel.ZIndex="999">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDdosAlertActive}" Value="True">
                                <Setter Property="Background" Value="#44FF0000"/>
                                <Setter Property="Visibility" Value="Visible"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                From="0" To="0.4" Duration="0:0:0.5" AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- Version stamp -->
            <TextBlock Grid.Row="1"
                       Text="SGL SyntheticAI v1.1.36"
                       FontSize="10"
                       Foreground="#A89880"
                       Opacity="0.6"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,8,4"
                       IsHitTestVisible="False"/>
        </Grid>
    </Border>
</Window>
