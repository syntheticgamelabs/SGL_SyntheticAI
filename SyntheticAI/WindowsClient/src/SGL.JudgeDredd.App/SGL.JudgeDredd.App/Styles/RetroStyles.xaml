                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource NeonCyanColor}" />
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="{StaticResource NeonCyanColor}"
                                                      BlurRadius="12"
                                                      ShadowDepth="0"
                                                      Opacity="0.8" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================== -->
    <!-- RETRO NEON BORDER (glowing border for panels)                       -->
    <!-- ================================================================== -->
    <Style x:Key="NeonBorderStyle" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource CrtBlackBrush}" />
        <Setter Property="BorderBrush"      Value="{StaticResource NeonCyanBrush}" />
        <Setter Property="BorderThickness"  Value="2" />
        <Setter Property="CornerRadius"     Value="0" />
        <Setter Property="Padding"          Value="16" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource NeonCyanColor}"
                                  BlurRadius="15"
                                  ShadowDepth="0"
                                  Opacity="0.5" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NeonRedBorderStyle" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource CrtBlackBrush}" />
        <Setter Property="BorderBrush"      Value="{StaticResource NeonRedBrush}" />
        <Setter Property="BorderThickness"  Value="2" />
        <Setter Property="CornerRadius"     Value="0" />
        <Setter Property="Padding"          Value="16" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource NeonRedColor}"
                                  BlurRadius="15"
                                  ShadowDepth="0"
                                  Opacity="0.5" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================== -->
    <!-- RETRO BUTTON (arcade-style, sharp corners, neon border)             -->
    <!-- ================================================================== -->
    <Style x:Key="RetroButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="Foreground"       Value="{StaticResource NeonGreenBrush}" />
        <Setter Property="BorderBrush"      Value="{StaticResource NeonGreenBrush}" />
        <Setter Property="BorderThickness"  Value="2" />
        <Setter Property="FontFamily"       Value="{StaticResource RetroFont}" />
        <Setter Property="FontSize"         Value="16" />
        <Setter Property="FontWeight"       Value="Bold" />
        <Setter Property="Padding"          Value="24,10" />
        <Setter Property="Cursor"           Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource NeonGreenColor}"
                                              BlurRadius="10"
                                              ShadowDepth="0"
                                              Opacity="0.4" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#2039FF14" />
                            <Setter TargetName="border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource NeonGreenColor}"
                                                      BlurRadius="20"
                                                      ShadowDepth="0"
                                                      Opacity="0.7" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#4039FF14" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Retro button in magenta -->
    <Style x:Key="RetroMagentaButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="Foreground"       Value="{StaticResource NeonMagentaBrush}" />
        <Setter Property="BorderBrush"      Value="{StaticResource NeonMagentaBrush}" />
        <Setter Property="BorderThickness"  Value="2" />
        <Setter Property="FontFamily"       Value="{StaticResource RetroFont}" />
