<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================== -->
    <!-- RETRO 80s ARCADE / CRT STYLES                                       -->
    <!-- Splash screen neon aesthetic for SyntheticAI                        -->
    <!-- ================================================================== -->

    <!-- ================================================================== -->
    <!-- NEON COLORS                                                         -->
    <!-- ================================================================== -->
    <Color x:Key="NeonGreenColor">#FFD700</Color>
    <Color x:Key="NeonCyanColor">#FF8C00</Color>
    <Color x:Key="NeonMagentaColor">#D4A017</Color>
    <Color x:Key="NeonYellowColor">#FFFF00</Color>
    <Color x:Key="NeonRedColor">#FF073A</Color>
    <Color x:Key="CrtBlackColor">#0A0A0A</Color>
    <Color x:Key="CrtDarkColor">#111111</Color>

    <SolidColorBrush x:Key="NeonGreenBrush"   Color="{StaticResource NeonGreenColor}" />
    <SolidColorBrush x:Key="NeonCyanBrush"    Color="{StaticResource NeonCyanColor}" />
    <SolidColorBrush x:Key="NeonMagentaBrush" Color="{StaticResource NeonMagentaColor}" />
    <SolidColorBrush x:Key="NeonYellowBrush"  Color="{StaticResource NeonYellowColor}" />
    <SolidColorBrush x:Key="NeonRedBrush"     Color="{StaticResource NeonRedColor}" />
    <SolidColorBrush x:Key="CrtBlackBrush"    Color="{StaticResource CrtBlackColor}" />
    <SolidColorBrush x:Key="CrtDarkBrush"     Color="{StaticResource CrtDarkColor}" />

    <!-- ================================================================== -->
    <!-- RETRO FONT FAMILIES                                                 -->
    <!-- ================================================================== -->
    <FontFamily x:Key="RetroFont">Consolas, Courier New, Lucida Console</FontFamily>
    <FontFamily x:Key="RetroDisplayFont">Consolas, Courier New</FontFamily>

    <!-- ================================================================== -->
    <!-- CRT SCANLINE BRUSH                                                  -->
    <!-- Tiled horizontal lines simulating a CRT monitor effect              -->
    <!-- ================================================================== -->
    <DrawingBrush x:Key="ScanlineBrush"
                  TileMode="Tile"
                  Viewport="0,0,1,4"
                  ViewportUnits="Absolute"
                  Viewbox="0,0,1,4"
                  ViewboxUnits="Absolute"
                  Opacity="0.15">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,1,2" />
                </GeometryDrawing.Geometry>
                <GeometryDrawing.Brush>
                    <SolidColorBrush Color="#000000" />
                </GeometryDrawing.Brush>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Dense scanline variant for stronger CRT effect -->
    <DrawingBrush x:Key="ScanlineBrushDense"
                  TileMode="Tile"
                  Viewport="0,0,1,3"
                  ViewportUnits="Absolute"
                  Viewbox="0,0,1,3"
                  ViewboxUnits="Absolute"
                  Opacity="0.25">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,1,1" />
                </GeometryDrawing.Geometry>
                <GeometryDrawing.Brush>
                    <SolidColorBrush Color="#000000" />
                </GeometryDrawing.Brush>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ================================================================== -->
    <!-- CRT VIGNETTE GRADIENT (dark edges, lighter center)                  -->
    <!-- ================================================================== -->
    <RadialGradientBrush x:Key="CrtVignetteBrush" Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
        <GradientStop Color="#00000000" Offset="0.0" />
        <GradientStop Color="#00000000" Offset="0.5" />
        <GradientStop Color="#80000000" Offset="0.85" />
        <GradientStop Color="#CC000000" Offset="1.0" />
    </RadialGradientBrush>

    <!-- ================================================================== -->
    <!-- NEON TEXT STYLES                                                     -->
    <!-- ================================================================== -->

    <!-- Main title neon text: large 72pt with green glow -->
    <Style x:Key="NeonTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"    Value="{StaticResource RetroFont}" />
        <Setter Property="FontSize"      Value="72" />
        <Setter Property="FontWeight"    Value="Bold" />
        <Setter Property="Foreground"    Value="{StaticResource NeonGreenBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource NeonGreenColor}"
                                  BlurRadius="30"
                                  ShadowDepth="0"
                                  Opacity="0.9"
                                  Direction="0" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Neon text in cyan -->
    <Style x:Key="NeonCyanTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"    Value="{StaticResource RetroFont}" />
        <Setter Property="FontSize"      Value="72" />
        <Setter Property="FontWeight"    Value="Bold" />
