    </Style>

    <!-- ================================================================== -->
    <!-- NEON SUBTITLE STYLES (smaller, 36pt)                                -->
    <!-- ================================================================== -->
    <Style x:Key="NeonSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"    Value="{StaticResource RetroFont}" />
        <Setter Property="FontSize"      Value="36" />
        <Setter Property="FontWeight"    Value="Bold" />
        <Setter Property="Foreground"    Value="{StaticResource NeonCyanBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource NeonCyanColor}"
                                  BlurRadius="20"
                                  ShadowDepth="0"
                                  Opacity="0.8"
                                  Direction="0" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================== -->
    <!-- RETRO BODY TEXT (smaller neon, 18pt, lighter glow)                   -->
    <!-- ================================================================== -->
    <Style x:Key="RetroBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"    Value="{StaticResource RetroFont}" />
        <Setter Property="FontSize"      Value="18" />
        <Setter Property="FontWeight"    Value="Normal" />
        <Setter Property="Foreground"    Value="{StaticResource NeonGreenBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource NeonGreenColor}"
                                  BlurRadius="10"
                                  ShadowDepth="0"
                                  Opacity="0.6"
                                  Direction="0" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================== -->
    <!-- RETRO STATUS TEXT (14pt, for loading messages)                       -->
    <!-- ================================================================== -->
    <Style x:Key="RetroStatusTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"    Value="{StaticResource RetroFont}" />
        <Setter Property="FontSize"      Value="14" />
        <Setter Property="FontWeight"    Value="Normal" />
        <Setter Property="Foreground"    Value="{StaticResource NeonCyanBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Opacity"       Value="0.85" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource NeonCyanColor}"
                                  BlurRadius="8"
                                  ShadowDepth="0"
                                  Opacity="0.5"
                                  Direction="0" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================== -->
    <!-- BLINKING CURSOR / "PRESS START" TEXT                                -->
    <!-- ================================================================== -->
    <Style x:Key="BlinkingTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"    Value="{StaticResource RetroFont}" />
        <Setter Property="FontSize"      Value="20" />
        <Setter Property="FontWeight"    Value="Bold" />
        <Setter Property="Foreground"    Value="{StaticResource NeonYellowBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{StaticResource NeonYellowColor}"
                                  BlurRadius="15"
                                  ShadowDepth="0"
                                  Opacity="0.8"
                                  Direction="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="1.0" To="0.0"
                                         Duration="0:0:0.6"
                                         AutoReverse="True" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================== -->
    <!-- RETRO NEON PROGRESSBAR (green glow bar on black track)              -->
    <!-- ================================================================== -->
    <Style x:Key="RetroProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Background"      Value="#1A1A1A" />
        <Setter Property="Foreground"       Value="{StaticResource NeonGreenBrush}" />
        <Setter Property="BorderBrush"      Value="{StaticResource NeonGreenBrush}" />
        <Setter Property="BorderThickness"  Value="1" />
        <Setter Property="Height"           Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource NeonGreenColor}" />
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="{StaticResource NeonGreenColor}"
                                                      BlurRadius="12"
                                                      ShadowDepth="0"
                                                      Opacity="0.8" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Retro progress bar in cyan -->
    <Style x:Key="RetroCyanProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Background"      Value="#1A1A1A" />
        <Setter Property="Foreground"       Value="{StaticResource NeonCyanBrush}" />
        <Setter Property="BorderBrush"      Value="{StaticResource NeonCyanBrush}" />
        <Setter Property="BorderThickness"  Value="1" />
        <Setter Property="Height"           Value="12" />
        <Setter Property="Template">
