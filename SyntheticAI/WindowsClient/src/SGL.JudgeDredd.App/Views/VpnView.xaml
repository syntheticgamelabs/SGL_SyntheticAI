<UserControl x:Class="SGL.JudgeDredd.App.Views.VpnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="1200" d:DesignWidth="900"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">

            <!-- Header -->
            <TextBlock Text="VPN" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,4"/>
            <TextBlock Text="Secure your connection with multi-hop routing and identity masking"
                       Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,20"/>

            <!-- Connection Status Card -->
            <Border Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Connection Status" Style="{StaticResource SubheadingTextStyle}" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Ellipse Width="48" Height="48" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="#FF27AE60"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="Public IP: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PublicIpAddress}" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="14" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RefreshIpCommand}" Padding="10,3" FontSize="11"/>
                    </StackPanel>

                    <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="16,10" Margin="0,0,0,16">
                        <UniformGrid Columns="3">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Sent" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding BytesSent}" Foreground="{StaticResource PrimaryBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Received" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding BytesReceived}" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Duration" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ConnectionDuration}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <Button Content="Connect" Command="{Binding ConnectCommand}" Padding="28,10" FontSize="14">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Disconnect" Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding DisconnectCommand}" Padding="28,10" FontSize="14"
                                Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Server Selection -->
            <Border Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Select Server" Style="{StaticResource SubheadingTextStyle}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Refresh Servers" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RefreshServersCommand}" Padding="10,6" FontSize="12" Margin="0,0,8,0"/>
                            <Button Content="Add to Route" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding AddToHopRouteCommand}" Padding="10,6" FontSize="12" Margin="0,0,8,0"/>
                            <Button Content="Ping All" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding PingServersCommand}" Padding="14,6" FontSize="12"/>
                        </StackPanel>
                    </Grid>

                    <ListBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}"
                             Background="Transparent" BorderThickness="0" MaxHeight="220"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBrush}"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#FF27AE60"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding Country}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="8,0">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} ms">
                                                <Binding Path="Latency"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Multi-Hop Route Card -->
            <Border Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Multi-Hop Route" Style="{StaticResource SubheadingTextStyle}" VerticalAlignment="Center"/>
                            <CheckBox IsChecked="{Binding MultiHopEnabled}" Content="Enable" Margin="16,0,0,0"
                                      Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="Clear Route" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ClearHopRouteCommand}" HorizontalAlignment="Right" Padding="10,4" FontSize="11"/>
                    </Grid>

                    <TextBlock Text="{Binding MultiHopStatus}" Foreground="{StaticResource AccentBrush}"
                               FontSize="13" FontWeight="Medium" Margin="0,0,0,8"/>

                    <ItemsControl ItemsSource="{Binding SelectedHops}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}" CornerRadius="4" Padding="10,6" Margin="0,2">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x2192; " Foreground="{StaticResource PrimaryBrush}" FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Text=" (" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Country}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text=")" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Content="X" HorizontalAlignment="Right" Padding="6,2" FontSize="10"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Command="{Binding DataContext.RemoveFromHopRouteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Select servers from the list above and click 'Add to Route' (max 3 hops)."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,8,0,0" FontStyle="Italic"/>
                </StackPanel>
            </Border>

            <!-- Identity Masking Card -->
            <Border Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Identity Masking" Style="{StaticResource SubheadingTextStyle}" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- IP Masking -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="IP Address Masking" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                            <TextBlock Text="{Binding PublicIpAddress}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                            <CheckBox IsChecked="{Binding IpMaskingEnabled}" Content="Mask IP Address"
                                      Command="{Binding ToggleIpMaskingCommand}"
                                      Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                            <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,2,0,0"
                                       FontFamily="Consolas" Text="{Binding MaskedIpAddress}"/>
                        </StackPanel>

                        <!-- Hardware ID Masking -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="Hardware ID (Machine GUID)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                            <TextBlock Text="{Binding RealHardwareId}" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="10" FontFamily="Consolas" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                            <CheckBox IsChecked="{Binding HardwareIdMaskingEnabled}" Content="Mask Hardware ID"
                                      Command="{Binding ToggleHardwareIdMaskingCommand}"
                                      Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                            <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="10" Margin="0,2,0,0"
                                       FontFamily="Consolas" Text="{Binding MaskedHardwareId}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Firmware ID Masking -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="Firmware ID (BIOS Serial)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                            <TextBlock Text="{Binding RealFirmwareId}" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="10" FontFamily="Consolas" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                            <CheckBox IsChecked="{Binding FirmwareIdMaskingEnabled}" Content="Mask Firmware ID"
                                      Command="{Binding ToggleFirmwareIdMaskingCommand}"
                                      Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                            <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="10" Margin="0,2,0,0"
                                       FontFamily="Consolas" Text="{Binding MaskedFirmwareId}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"
                               FontStyle="Italic"
                               Text="Spoofed IDs are stored in application registry (HKCU\SOFTWARE\SGL-SAI) to intercept identification queries."/>
                </StackPanel>
            </Border>

            <!-- Settings Card -->
            <Border Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Settings" Style="{StaticResource SubheadingTextStyle}" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Protocol" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,0,12"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableProtocols}" SelectedItem="{Binding VpnProtocol}"
                                  Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Padding="8,6" Margin="0,0,0,12"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="DNS Server" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DnsServer, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource CardBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" FontSize="13" Padding="8,6" Margin="0,0,0,12"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Kill Switch" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,0,12"/>
                        <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding KillSwitchEnabled}" Command="{Binding ToggleKillSwitchCommand}"
                                  Content="Block traffic if VPN drops" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,12"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="DNS Leak Protection" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,0,4"/>
                        <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding DnsLeakProtectionEnabled}" Command="{Binding ToggleDnsLeakProtectionCommand}"
                                  Content="Route DNS through tunnel" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Connection Log -->
            <Border Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Connection Log" Style="{StaticResource SubheadingTextStyle}" Margin="0,0,0,12"/>
                    <ListBox ItemsSource="{Binding ConnectionLog}" Background="Transparent"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                             Height="180" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,2"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Focusable" Value="False"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
