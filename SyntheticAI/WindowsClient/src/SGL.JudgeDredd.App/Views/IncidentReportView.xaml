<UserControl x:Class="SGL.JudgeDredd.App.Views.IncidentReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="INCIDENT REPORT GENERATOR" FontSize="18" FontWeight="Bold" Foreground="#F0E6D0"/>
            <TextBlock Text="Generate comprehensive security incident reports with system analysis" Foreground="#A89880" Margin="0,4,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Generate Full Report" Command="{Binding GenerateFullReportCommand}" Background="#4A3D2A" Foreground="#F0E6D0" BorderBrush="#5A4D3A" Padding="15,8" Margin="0,0,10,0"/>
                <Button Content="Refresh List" Command="{Binding RefreshReportsCommand}" Background="#4A3D2A" Foreground="#F0E6D0" BorderBrush="#5A4D3A" Padding="15,8" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding ReportStatus}" Foreground="#a6e3a1" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,15">
            <Border Background="#3A3020" CornerRadius="8" Padding="15,10" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Total Reports" Foreground="#A89880" FontSize="11"/><TextBlock Text="{Binding TotalReports}" FontSize="20" Foreground="#FFD700"/></StackPanel>
            </Border>
            <Border Background="#3A3020" CornerRadius="8" Padding="15,10" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Last Report" Foreground="#A89880" FontSize="11"/><TextBlock Text="{Binding LastReportTime}" FontSize="14" Foreground="#E0B030"/></StackPanel>
            </Border>
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Report List -->
            <Border Grid.Column="0" Background="#3A3020" CornerRadius="8" Margin="0,0,10,0" Padding="5">
                <ListBox ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}" Background="Transparent" Foreground="#F0E6D0" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5,4">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#F0E6D0" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding GeneratedAt, StringFormat=yyyy-MM-dd HH:mm}" Foreground="#A89880" FontSize="11"/>
                                    <TextBlock Text=" | " Foreground="#5A4D3A" FontSize="11"/>
                                    <TextBlock Text="{Binding Severity}" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#a6e3a1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="High"><Setter Property="Foreground" Value="#FFB347"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Critical"><Setter Property="Foreground" Value="#f38ba8"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text=" | " Foreground="#5A4D3A" FontSize="11"/>
                                    <TextBlock Text="{Binding ThreatCount, StringFormat={}{0} threats}" Foreground="#f9e2af" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Report Content -->
            <Border Grid.Column="1" Background="#3A3020" CornerRadius="8" Padding="10">
                <TextBox Text="{Binding SelectedReportContent, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         Background="Transparent" Foreground="#F0E6D0" BorderThickness="0" FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
