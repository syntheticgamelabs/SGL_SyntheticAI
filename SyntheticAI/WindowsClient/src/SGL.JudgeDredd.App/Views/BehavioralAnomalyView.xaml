<UserControl x:Class="SGL.JudgeDredd.App.Views.BehavioralAnomalyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="BEHAVIORAL ANOMALY DETECTOR" FontSize="18" FontWeight="Bold" Foreground="#F0E6D0"/>
            <TextBlock Text="Detect CPU spikes, memory anomalies, suspicious process spawning, rapid file operations" Foreground="#A89880" Margin="0,4,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Toggle Monitoring" Command="{Binding ToggleMonitoringCommand}" Background="#4A3D2A" Foreground="#F0E6D0" BorderBrush="#5A4D3A" Padding="15,8" Margin="0,0,10,0"/>
                <Button Content="Check Now" Command="{Binding CheckNowCommand}" Background="#4A3D2A" Foreground="#F0E6D0" BorderBrush="#5A4D3A" Padding="15,8" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding MonitoringStatus}" Foreground="#a6e3a1" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,15">
            <Border Background="#3A3020" CornerRadius="8" Padding="15,10" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Anomalies" Foreground="#A89880" FontSize="11"/><TextBlock Text="{Binding TotalAnomalies}" FontSize="20" Foreground="#f9e2af"/></StackPanel>
            </Border>
            <Border Background="#3A3020" CornerRadius="8" Padding="15,10" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Critical" Foreground="#A89880" FontSize="11"/><TextBlock Text="{Binding CriticalAnomalies}" FontSize="20" Foreground="#f38ba8"/></StackPanel>
            </Border>
            <Border Background="#3A3020" CornerRadius="8" Padding="15,10" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="CPU %" Foreground="#A89880" FontSize="11"/><TextBlock Text="{Binding SystemCpuPercent, StringFormat=F1}" FontSize="20" Foreground="#FFD700"/></StackPanel>
            </Border>
            <Border Background="#3A3020" CornerRadius="8" Padding="15,10" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Memory %" Foreground="#A89880" FontSize="11"/><TextBlock Text="{Binding SystemMemoryPercent, StringFormat=F1}" FontSize="20" Foreground="#E0B030"/></StackPanel>
            </Border>
        </WrapPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Anomalies}" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#1A1610" Foreground="#F0E6D0" BorderBrush="#3A3020" RowBackground="#1A1610" AlternatingRowBackground="#151210"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3A3020">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#3A3020"/><Setter Property="Foreground" Value="#F0E6D0"/>
                    <Setter Property="Padding" Value="8,6"/><Setter Property="BorderBrush" Value="#4A3D2A"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="180"/>
                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="60"/>
                <DataGridTextColumn Header="Anomaly Type" Binding="{Binding AnomalyType}" Width="140"/>
                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Detected" Binding="{Binding DetectedAt, StringFormat=HH:mm:ss}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
