<UserControl x:Class="SGL.JudgeDredd.App.Views.ScheduledScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource PrimaryBrush}" Margin="0,0,12,0">
                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Scheduled Scanning" Style="{StaticResource HeadingTextStyle}"/>
                        <TextBlock Text="{Binding SchedulerStatus}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Stats -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="3" Margin="0,0,0,16">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                <StackPanel HorizontalAlignment="Center" Margin="8">
                    <TextBlock Text="ACTIVE SCHEDULES" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ActiveSchedules}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="4,0">
                <StackPanel HorizontalAlignment="Center" Margin="8">
                    <TextBlock Text="COMPLETED SCANS" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding CompletedScans}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
                <StackPanel HorizontalAlignment="Center" Margin="8">
                    <TextBlock Text="THREATS FOUND" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ThreatsFoundBySchedule}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Add New Schedule Form -->
        <Border Grid.Row="2" Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Create New Schedule" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" Margin="0,0,8,0" FontSize="12"
                             Background="{StaticResource CardBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource SurfaceBrush}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ScanTypes}" SelectedItem="{Binding NewScanType}"
                              Margin="0,0,8,0" Padding="6,4" FontSize="12"/>
                    <TextBox Grid.Column="2" Text="{Binding NewHour, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,6" FontSize="12" HorizontalContentAlignment="Center"
                             Background="{StaticResource CardBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource SurfaceBrush}"/>
                    <TextBlock Grid.Column="3" Text=":" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBox Grid.Column="4" Text="{Binding NewMinute, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,6" Margin="0,0,8,0" FontSize="12" HorizontalContentAlignment="Center"
                             Background="{StaticResource CardBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource SurfaceBrush}"/>
                    <ComboBox Grid.Column="5" ItemsSource="{Binding Frequencies}" SelectedItem="{Binding NewFrequency}"
                              Margin="0,0,8,0" Padding="6,4" FontSize="12"/>
                    <Button Grid.Column="6" Content="Add Schedule" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding AddScheduleCommand}" Padding="14,6"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Schedules List -->
        <Border Grid.Row="3" Style="{StaticResource SurfaceBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Schedules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}" CornerRadius="{StaticResource DefaultCornerRadius}"
                                    Padding="14,10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,12,0"
                                              Command="{Binding DataContext.ToggleScheduleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="{Binding ScanType, Mode=OneWay}"/>
                                                <Run Text=" | "/>
                                                <Run Text="{Binding Frequency, Mode=OneWay}"/>
                                                <Run Text=" at "/>
                                                <Run Text="{Binding ScheduledTimeFormatted, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="Last: "/><Run Text="{Binding LastRunFormatted, Mode=OneWay}"/>
                                            <Run Text=" | Next: "/><Run Text="{Binding NextRunFormatted, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="0,0,12,0"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Run Now" Style="{StaticResource PrimaryButtonStyle}"
                                                Padding="10,4" FontSize="11" Margin="0,0,4,0"
                                                Command="{Binding DataContext.RunNowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Remove" Padding="10,4" FontSize="11"
                                                Command="{Binding DataContext.RemoveScheduleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Scan Log -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource DefaultCornerRadius}" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Scan Log" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="12,8,0,4"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding ScanLog}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="4,1"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Focusable" Value="False"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
