<UserControl x:Class="SGL.JudgeDredd.App.Views.FileIntegrityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolToVis"/></UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource PrimaryBrush}" Margin="0,0,12,0">
                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="File Integrity Monitor (FIM)" Style="{StaticResource HeadingTextStyle}"/>
                        <TextBlock Text="{Binding FimStatus}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Start Monitoring" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding StartMonitoringCommand}" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="Stop" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding StopMonitoringCommand}" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="Check Now" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RunIntegrityCheckCommand}" Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Stats -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,16">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                <StackPanel HorizontalAlignment="Center" Margin="8">
                    <TextBlock Text="MONITORED FILES" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding MonitoredFiles}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="4,0">
                <StackPanel HorizontalAlignment="Center" Margin="8">
                    <TextBlock Text="CHANGES" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ChangeDetections}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="4,0">
                <StackPanel HorizontalAlignment="Center" Margin="8">
                    <TextBlock Text="CRITICAL" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding CriticalAlerts}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
                <StackPanel HorizontalAlignment="Center" Margin="8">
                    <TextBlock Text="PATHS" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding MonitoredPaths.Count}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Add Path -->
        <Border Grid.Row="2" Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding NewWatchPath, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="12"
                         Background="{StaticResource CardBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource SurfaceBrush}" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="Add Watch Path" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AddWatchPathCommand}" Padding="12,6"/>
            </Grid>
        </Border>

        <!-- Monitored Paths + Alerts -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <ItemsControl ItemsSource="{Binding MonitoredPaths}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="{StaticResource DefaultCornerRadius}"
                                Padding="10,6" Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Run Text="("/><Run Text="{Binding FileCount, Mode=OneWay}"/><Run Text=" files)"/>
                                </TextBlock>
                                <Button Content="X" Padding="4,1" FontSize="9" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding DataContext.RemoveWatchPathCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Alerts list -->
        <Border Grid.Row="4" Style="{StaticResource SurfaceBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Alerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}" CornerRadius="{StaticResource DefaultCornerRadius}"
                                    Padding="12,8" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="6" CornerRadius="3" Margin="0,0,10,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Medium">
                                                        <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
                                            <Run Text="{Binding ChangeType, Mode=OneWay}"/><Run Text=" - "/><Run Text="{Binding Severity, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="{Binding DetectedAt, Mode=OneWay, StringFormat='{}{0:HH:mm:ss}'}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="ACK" Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="8,3" FontSize="10" VerticalAlignment="Center"
                                            Command="{Binding DataContext.AcknowledgeAlertCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30">
                                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                                               Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                    <TextBlock Text="No integrity alerts" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Start monitoring to establish baselines and detect file system changes."
                                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Log -->
        <Border Grid.Row="5" Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource DefaultCornerRadius}" Margin="0,12,0,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="FIM Log" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="12,8,0,4"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding FimLog}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,1"/></DataTemplate></ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Focusable" Value="False"/></Style></ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
