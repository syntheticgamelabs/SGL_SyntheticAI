<UserControl x:Class="SGL.JudgeDredd.App.Views.PersistenceScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="PERSISTENCE SCANNER" FontSize="18" FontWeight="Bold" Foreground="#F0E6D0"/>
            <TextBlock Text="Detect persistence mechanisms: registry keys, startup items, scheduled tasks, WMI, browser extensions" Foreground="#A89880" Margin="0,4,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Scan Persistence" Command="{Binding ScanPersistenceCommand}" Background="#4A3D2A" Foreground="#F0E6D0" BorderBrush="#5A4D3A" Padding="15,8" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding ScanStatus}" Foreground="#a6e3a1" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,15">
            <Border Background="#3A3020" CornerRadius="8" Padding="15,10" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Total Entries" Foreground="#A89880" FontSize="11"/><TextBlock Text="{Binding TotalEntries}" FontSize="20" Foreground="#FFD700"/></StackPanel>
            </Border>
            <Border Background="#3A3020" CornerRadius="8" Padding="15,10" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Suspicious" Foreground="#A89880" FontSize="11"/><TextBlock Text="{Binding SuspiciousEntries}" FontSize="20" Foreground="#f38ba8"/></StackPanel>
            </Border>
            <Border Background="#3A3020" CornerRadius="8" Padding="15,10" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Last Scan" Foreground="#A89880" FontSize="11"/><TextBlock Text="{Binding LastScanTime}" FontSize="14" Foreground="#E0B030"/></StackPanel>
            </Border>
        </WrapPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#1A1610" Foreground="#F0E6D0" BorderBrush="#3A3020" RowBackground="#1A1610" AlternatingRowBackground="#151210"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3A3020">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#3A3020"/><Setter Property="Foreground" Value="#F0E6D0"/>
                    <Setter Property="Padding" Value="8,6"/><Setter Property="BorderBrush" Value="#4A3D2A"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/>
                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="200"/>
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                <DataGridCheckBoxColumn Header="Sus." Binding="{Binding IsSuspicious}" Width="50"/>
                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
