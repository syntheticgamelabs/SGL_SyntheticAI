<UserControl x:Class="SGL.JudgeDredd.App.Views.UIEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">

            <!-- ======== HEADER ======== -->
            <TextBlock Text="UI Editor"
                       Style="{StaticResource HeadingTextStyle}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Customize the application appearance (Admin only)"
                       Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,0,0,24"/>

            <!-- ======== FONT SETTINGS ======== -->
            <Border Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Text="Font Settings"
                               Style="{StaticResource SubheadingTextStyle}"
                               Margin="0,0,0,16"/>

                    <!-- Font Family -->
                    <TextBlock Text="Font Family"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding AvailableFonts}"
                              SelectedItem="{Binding SelectedFontFamily}"
                              Width="300" HorizontalAlignment="Left"
                              Margin="0,0,0,16"/>

                    <!-- Font Size -->
                    <TextBlock Text="Font Size"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0"
                                Value="{Binding SelectedFontSize}"
                                Minimum="{Binding MinFontSize}"
                                Maximum="{Binding MaxFontSize}"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedFontSize, StringFormat='{}{0:F0} pt'}"
                                   Foreground="{StaticResource SecondaryBrush}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ======== COLOR SETTINGS ======== -->
            <Border Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Text="Color Settings"
                               Style="{StaticResource SubheadingTextStyle}"
                               Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Background Color -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,16">
                            <TextBlock Text="Background Color"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding SelectedBackgroundColor, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"/>
                                <Border Grid.Column="1" Width="28" Height="28" Margin="4,0,0,0"
                                        CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{StaticResource BorderBrush}">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding SelectedBackgroundColor}"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- Row 0: Surface Color -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,16">
                            <TextBlock Text="Surface Color"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding SelectedSurfaceColor, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"/>
                                <Border Grid.Column="1" Width="28" Height="28" Margin="4,0,0,0"
                                        CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{StaticResource BorderBrush}">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding SelectedSurfaceColor}"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- Row 1: Primary/Accent Color -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,16">
                            <TextBlock Text="Primary / Accent Color"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding SelectedPrimaryColor, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"/>
                                <Border Grid.Column="1" Width="28" Height="28" Margin="4,0,0,0"
                                        CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{StaticResource BorderBrush}">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding SelectedPrimaryColor}"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- Row 1: Accent Color -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,16">
                            <TextBlock Text="Accent Color"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding SelectedAccentColor, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"/>
                                <Border Grid.Column="1" Width="28" Height="28" Margin="4,0,0,0"
                                        CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{StaticResource BorderBrush}">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding SelectedAccentColor}"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- Row 2: Font Color -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,16">
                            <TextBlock Text="Font Color"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding SelectedFontColor, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"/>
                                <Border Grid.Column="1" Width="28" Height="28" Margin="4,0,0,0"
                                        CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{StaticResource BorderBrush}">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding SelectedFontColor}"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- Row 2: Danger Color -->
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,0,0,16">
                            <TextBlock Text="Danger Color"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding SelectedDangerColor, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"/>
                                <Border Grid.Column="1" Width="28" Height="28" Margin="4,0,0,0"
                                        CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{StaticResource BorderBrush}">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding SelectedDangerColor}"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- Row 3: Warning Color -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Warning Color"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding SelectedWarningColor, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"/>
                                <Border Grid.Column="1" Width="28" Height="28" Margin="4,0,0,0"
                                        CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{StaticResource BorderBrush}">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding SelectedWarningColor}"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ======== IMAGES SECTION ======== -->
            <Border Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Text="Images &amp; AI Personality"
                               Style="{StaticResource SubheadingTextStyle}"
                               Margin="0,0,0,16"/>

                    <!-- Background Image -->
                    <TextBlock Text="Background Image"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding BackgroundImagePath, Mode=TwoWay}"
                                 IsReadOnly="True"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="Browse..."
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding BrowseBackgroundCommand}"
                                Margin="8,0,0,0"
                                Padding="16,6"/>
                    </Grid>

                    <!-- LLM Personality Customization -->
                    <TextBlock Text="AI Personality Name"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,16,0,6"/>
                    <TextBox Text="{Binding LlmPersonalityName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,12"/>

                    <TextBlock Text="AI System Prompt"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,6"/>
                    <TextBox Text="{Binding LlmSystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="120"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,4"/>
                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"
                               TextWrapping="Wrap" Margin="0,0,0,12">
                        <Run FontWeight="SemiBold">Tips:</Run>
                        <Run> Set the personality to change how the AI responds.</Run>
                        <LineBreak/>
                        <Run>- For security focus: "You are a strict cybersecurity expert..."</Run>
                        <LineBreak/>
                        <Run>- For friendly chat: "You are a friendly AI companion..."</Run>
                        <LineBreak/>
                        <Run>- For coding help: "You are a senior software developer..."</Run>
                        <LineBreak/>
                        <Run>- For roleplay: Describe the character and personality in detail.</Run>
                        <LineBreak/>
                        <Run>- The AI will remember things you tell it in chat (use /remember).</Run>
                    </TextBlock>

                    <TextBlock Text="Chat AI Avatar Image"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding ChatAvatarImagePath, Mode=TwoWay}"
                                 IsReadOnly="True"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="Browse..."
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding BrowseChatAvatarCommand}"
                                Margin="8,0,0,0"
                                Padding="16,6"/>
                    </Grid>

                    <Button Content="Save AI Personality"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SaveLlmPersonalityCommand}"
                            Padding="16,6"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- ======== ACTIONS BAR ======== -->
            <Border Style="{StaticResource SurfaceBorderStyle}" Padding="20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Load Settings"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding LoadSettingsCommand}"
                            Margin="0,0,12,0"
                            Padding="20,8"/>
                    <Button Content="Reset Defaults"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ResetToDefaultCommand}"
                            Margin="0,0,12,0"
                            Padding="20,8"/>
                    <Button Content="Apply Theme"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ApplyThemeCommand}"
                            Margin="0,0,12,0"
                            Padding="20,8"/>
                    <Button Content="Save Settings"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SaveSettingsCommand}"
                            Padding="20,8"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
