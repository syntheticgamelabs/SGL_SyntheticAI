<UserControl x:Class="SGL.JudgeDredd.App.Views.QuarantineVaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:SGL.JudgeDredd.Shared.Localization;assembly=SGL.JudgeDredd.Shared"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource WarningBrush}" Margin="0,0,12,0">
                        <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[quarantine.title]}" Style="{StaticResource HeadingTextStyle}"/>
                        <TextBlock Text="{Binding VaultStatus}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[common.refresh]}" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshVaultCommand}" Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[quarantine.clearAll]}" Padding="12,6"
                            Command="{Binding ClearAllCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Stats -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,16">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                <StackPanel HorizontalAlignment="Center" Margin="8">
                    <TextBlock Text="QUARANTINED" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalQuarantined}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="4,0">
                <StackPanel HorizontalAlignment="Center" Margin="8">
                    <TextBlock Text="RESTORED" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalRestored}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="4,0">
                <StackPanel HorizontalAlignment="Center" Margin="8">
                    <TextBlock Text="DELETED" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalDeleted}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
                <StackPanel HorizontalAlignment="Center" Margin="8">
                    <TextBlock Text="VAULT SIZE" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding VaultSize}" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Info -->
        <Border Grid.Row="2" Padding="10,6" Background="{StaticResource SurfaceBrush}"
                CornerRadius="{StaticResource DefaultCornerRadius}" Margin="0,0,0,12"
                BorderBrush="{StaticResource WarningBrush}" BorderThickness="1">
            <TextBlock Text="Quarantined files are encrypted and isolated. Restore returns a file to its original location. Delete permanently removes the file."
                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </Border>

        <!-- Items list -->
        <Border Grid.Row="3" Style="{StaticResource SurfaceBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding QuarantinedItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}" CornerRadius="{StaticResource DefaultCornerRadius}"
                                    Padding="14,10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Margin="0,0,12,0"
                                            Background="#44FF8800" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock FontSize="11" Foreground="{StaticResource DangerBrush}">
                                            <Run Text="Threat: "/><Run Text="{Binding ThreatName, Mode=OneWay}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                        <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="Path: "/><Run Text="{Binding OriginalPath, Mode=OneWay}"/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="Size: "/><Run Text="{Binding FileSizeFormatted, Mode=OneWay}"/>
                                                <Run Text=" | Quarantined: "/><Run Text="{Binding QuarantinedAt, Mode=OneWay, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[quarantine.restore]}" Style="{StaticResource PrimaryButtonStyle}"
                                                Padding="10,5" FontSize="11" Margin="0,0,6,0"
                                                Command="{Binding DataContext.RestoreFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[common.delete]}" Padding="10,5" FontSize="11"
                                                Command="{Binding DataContext.DeletePermanentlyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40">
                                                    <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                                                               Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                                    <TextBlock Text="Quarantine Vault is empty" FontSize="16" FontWeight="SemiBold"
                                                               Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Threats detected during scanning will appear here for isolation and review."
                                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Activity Log -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" CornerRadius="{StaticResource DefaultCornerRadius}" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Activity Log" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="12,8,0,4"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding ActivityLog}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="4,1"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
