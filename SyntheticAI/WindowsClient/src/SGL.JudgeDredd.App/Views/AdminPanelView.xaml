<UserControl x:Class="SGL.JudgeDredd.App.Views.AdminPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SGL.JudgeDredd.App.ViewModels"
             xmlns:views="clr-namespace:SGL.JudgeDredd.App.Views"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Admin Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                Padding="20,12" Margin="0,0,0,16">
            <DockPanel>
                <TextBlock Text="ADMIN PANEL" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource DangerBrush}" DockPanel.Dock="Left"/>
                <TextBlock Text="{Binding CurrentAdminName, StringFormat='Logged in as: {0}'}"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                           VerticalAlignment="Center" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <!-- Tab Control -->
        <TabControl Grid.Row="1" Background="Transparent" BorderBrush="{StaticResource BorderBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    SelectedIndex="{Binding SelectedTabIndex}">

            <!-- Server & Cloudflare Tab (FIRST) -->
            <TabItem Header="Server &amp; Cloudflare" Foreground="{StaticResource TextPrimaryBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <!-- Server Status Section -->
                        <TextBlock Text="SERVER STATUS" FontWeight="Bold" FontSize="14" Foreground="#F0E6D0" Margin="0,0,0,8"/>
                        <Border Background="#1A1610" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                    <TextBlock Text="Listen Address" Foreground="#A89880" FontSize="11"/>
                                    <TextBlock Text="{Binding ServerListenAddress}" Foreground="#a6e3a1" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock Text="Server Bind" Foreground="#A89880" FontSize="11"/>
                                    <TextBlock Text="{Binding ServerBindStatus}" FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#f38ba8"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsServerListening}" Value="True">
                                                        <Setter Property="Foreground" Value="#a6e3a1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                    <TextBlock Text="Response Time" Foreground="#A89880" FontSize="11"/>
                                    <TextBlock Text="{Binding ServerResponseTime}" Foreground="#FFD700" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock Text="Requests/sec" Foreground="#A89880" FontSize="11"/>
                                    <TextBlock Text="{Binding RequestsPerSecond, StringFormat='{}{0:F1}'}" Foreground="#FFD700" FontSize="13"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Cloudflare Tunnel Section -->
                        <TextBlock Text="CLOUDFLARE TUNNEL" FontWeight="Bold" FontSize="14" Foreground="#F0E6D0" Margin="0,0,0,8"/>
                        <Border Background="#1A1610" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Tunnel Name" Foreground="#A89880" FontSize="11"/>
                                        <TextBlock Text="{Binding TunnelName}" Foreground="#F0E6D0" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                        <TextBlock Text="Cloudflared Service" Foreground="#A89880" FontSize="11"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#a6e3a1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCloudflaredRunning}" Value="False">
                                                                <Setter Property="Fill" Value="#f38ba8"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding CloudflaredStatus}" Foreground="#F0E6D0" FontSize="13"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Domain" Foreground="#A89880" FontSize="11"/>
                                        <TextBlock Text="{Binding TunnelDomain}" Foreground="#f9e2af" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                        <TextBlock Text="Service URL" Foreground="#A89880" FontSize="11"/>
                                        <TextBlock Text="{Binding TunnelServiceUrl}" Foreground="#F0E6D0" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="NS1" Foreground="#A89880" FontSize="11"/>
                                        <TextBlock Text="{Binding DnsNameServer1}" Foreground="#E0B030" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                                        <TextBlock Text="NS2" Foreground="#A89880" FontSize="11"/>
                                        <TextBlock Text="{Binding DnsNameServer2}" Foreground="#E0B030" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Public IPv4" Foreground="#A89880" FontSize="11"/>
                                        <TextBlock Text="{Binding PublicIpv4}" Foreground="#F0E6D0" FontSize="13"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Start Tunnel" Command="{Binding StartCloudflaredServiceCommand}" Margin="0,0,8,0" Padding="12,6" Background="#4A3D2A" Foreground="#F0E6D0" BorderBrush="#5A4D3A"/>
                                    <Button Content="Stop Tunnel" Command="{Binding StopCloudflaredServiceCommand}" Margin="0,0,8,0" Padding="12,6" Background="#4A3D2A" Foreground="#F0E6D0" BorderBrush="#5A4D3A"/>
                                    <Button Content="Test Speed" Command="{Binding MeasureServerResponseTimeCommand}" Padding="12,6" Background="#4A3D2A" Foreground="#F0E6D0" BorderBrush="#5A4D3A"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Tunnel Configuration Section -->
                        <TextBlock Text="TUNNEL CONFIGURATION" FontWeight="Bold" FontSize="14" Foreground="#F0E6D0" Margin="0,0,0,8"/>
                        <Border Background="#1A1610" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <!-- Tunnel Token Input -->
                                <TextBlock Text="Tunnel Token" Foreground="#A89880" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding TunnelTokenInput, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12" Padding="8,6"
                                         Background="#3A3020" Foreground="#F0E6D0"
                                         BorderBrush="#5A4D3A" BorderThickness="1"
                                         CaretBrush="#F0E6D0"
                                         Margin="0,0,0,12"/>

                                <!-- Action Buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button Content="Install Tunnel Service"
                                            Command="{Binding InstallTunnelServiceCommand}"
                                            Margin="0,0,8,0" Padding="12,6"
                                            Background="#4A3D2A" Foreground="#F0E6D0" BorderBrush="#5A4D3A"/>
                                    <Button Content="Test Connectivity"
                                            Command="{Binding TestTunnelConnectivityCommand}"
                                            Padding="12,6"
                                            Background="#4A3D2A" Foreground="#F0E6D0" BorderBrush="#5A4D3A"/>
                                </StackPanel>

                                <!-- Install Status -->
                                <TextBlock Text="{Binding TunnelInstallStatus}"
                                           Foreground="#a6e3a1" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <!-- Zone & Account IDs -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Zone ID" Foreground="#A89880" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding ZoneId, Mode=OneWay}" IsReadOnly="True"
                                                 FontSize="12" Padding="8,6"
                                                 Background="#3A3020" Foreground="#E0B030"
                                                 BorderBrush="#5A4D3A" BorderThickness="1"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Account ID" Foreground="#A89880" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding AccountId, Mode=OneWay}" IsReadOnly="True"
                                                 FontSize="12" Padding="8,6"
                                                 Background="#3A3020" Foreground="#E0B030"
                                                 BorderBrush="#5A4D3A" BorderThickness="1"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- DDoS Status Section -->
                        <TextBlock Text="DDOS PROTECTION" FontWeight="Bold" FontSize="14" Foreground="#F0E6D0" Margin="0,0,0,8"/>
                        <Border CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#1A1610"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDdosDetected}" Value="True">
                                            <Setter Property="Background" Value="#7f1d1d"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding DdosStatusText}" Foreground="#F0E6D0" FontSize="14" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Error Rate: " Foreground="#A89880"/>
                                    <TextBlock Text="{Binding ErrorRatePercent, StringFormat='{}{0:F1}%'}" Foreground="#F0E6D0"/>
                                    <TextBlock Text="  |  Requests/sec: " Foreground="#A89880" Margin="16,0,0,0"/>
                                    <TextBlock Text="{Binding RequestsPerSecond, StringFormat='{}{0:F1}'}" Foreground="#F0E6D0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Cloudflare Login Tab -->
            <TabItem Header="Cloudflare Login" Foreground="{StaticResource TextPrimaryBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="CLOUDFLARE API AUTHENTICATION" FontWeight="Bold" FontSize="14"
                                   Foreground="#F0E6D0" Margin="0,0,0,8"/>
                        <TextBlock Text="Connect to your Cloudflare account to manage tunnels, zones, and DNS."
                                   Foreground="#A89880" FontSize="12" Margin="0,0,0,16"/>

                        <!-- Auth Method Selector -->
                        <Border Background="#1A1610" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Authentication Method" Foreground="#A89880" FontSize="11" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <RadioButton Content="API Token (Recommended)" IsChecked="{Binding CfUseToken}"
                                                 Foreground="#F0E6D0" Margin="0,0,20,0"/>
                                    <RadioButton Content="Email + Global API Key"
                                                 Foreground="#F0E6D0">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton">
                                                <Setter Property="IsChecked" Value="False"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CfUseToken}" Value="False">
                                                        <Setter Property="IsChecked" Value="True"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                </StackPanel>

                                <!-- API Token Input (visible when token mode selected) -->
                                <StackPanel Visibility="{Binding CfUseToken, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="API Token" Foreground="#A89880" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding CfApiToken, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#3A3020" Foreground="#F0E6D0" BorderBrush="#4A3D2A"
                                             Padding="8,6" FontSize="13" Margin="0,0,0,6"/>
                                    <TextBlock Text="Create a token at dash.cloudflare.com > My Profile > API Tokens"
                                               Foreground="#5A4D3A" FontSize="10" FontStyle="Italic"/>
                                </StackPanel>

                                <!-- Email + Key Inputs (visible when key mode selected) -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CfUseToken}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Email Address" Foreground="#A89880" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding CfEmail, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#3A3020" Foreground="#F0E6D0" BorderBrush="#4A3D2A"
                                             Padding="8,6" FontSize="13" Margin="0,0,0,8"/>
                                    <TextBlock Text="Global API Key" Foreground="#A89880" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding CfApiKey, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#3A3020" Foreground="#F0E6D0" BorderBrush="#4A3D2A"
                                             Padding="8,6" FontSize="13" Margin="0,0,0,8"/>
                                    <TextBlock Text="Origin CA Key (optional)" Foreground="#A89880" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding CfOriginCaKey, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#3A3020" Foreground="#F0E6D0" BorderBrush="#4A3D2A"
                                             Padding="8,6" FontSize="13" Margin="0,0,0,6"/>
                                    <TextBlock Text="Find your Global API Key at dash.cloudflare.com > My Profile > API Tokens > Global API Key. Origin CA Key is under SSL/TLS > Origin Server."
                                               Foreground="#5A4D3A" FontSize="10" FontStyle="Italic"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Login/Logout Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="Login to Cloudflare" Command="{Binding CfLoginCommand}"
                                    Padding="16,8" FontSize="13" Cursor="Hand" Margin="0,0,8,0"
                                    Background="#FFD700" Foreground="#1A1610" FontWeight="Bold"
                                    BorderThickness="0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CfIsAuthenticated}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Logout" Command="{Binding CfLogoutCommand}"
                                    Padding="16,8" FontSize="13" Cursor="Hand"
                                    Background="#f38ba8" Foreground="#1A1610" FontWeight="Bold"
                                    BorderThickness="0"
                                    Visibility="{Binding CfIsAuthenticated, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="Connecting..." Foreground="#f9e2af" FontSize="12"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       Visibility="{Binding CfIsLoggingIn, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <!-- Login Status -->
                        <Border Padding="8,6" Margin="0,0,0,16" CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CfLoginHasError}" Value="True">
                                            <Setter Property="Background" Value="#302020"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CfIsAuthenticated}" Value="True">
                                            <Setter Property="Background" Value="#203020"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding CfLoginStatus}" FontSize="12" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#F0E6D0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CfLoginHasError}" Value="True">
                                                <Setter Property="Foreground" Value="#f38ba8"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CfIsAuthenticated}" Value="True">
                                                <Setter Property="Foreground" Value="#a6e3a1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- Account Info (visible after login) -->
                        <Border Background="#1A1610" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                                Visibility="{Binding CfIsAuthenticated, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="ACCOUNT INFORMATION" FontWeight="Bold" FontSize="13"
                                           Foreground="#FFD700" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Account:" Foreground="#A89880" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CfAccountName}" Foreground="#a6e3a1" FontSize="12"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Email:" Foreground="#A89880" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CfAccountEmail}" Foreground="#F0E6D0" FontSize="12"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Account ID:" Foreground="#A89880" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AccountId}" Foreground="#F0E6D0" FontSize="12"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Zone ID:" Foreground="#A89880" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ZoneId}" Foreground="#F0E6D0" FontSize="12"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Zones (visible after login) -->
                        <Border Background="#1A1610" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                                Visibility="{Binding CfIsAuthenticated, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="ZONES" FontWeight="Bold" FontSize="13"
                                           Foreground="#FFD700" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding CfZoneInfo}" Foreground="#F0E6D0" FontSize="12"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Tunnels (visible after login) -->
                        <Border Background="#1A1610" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                                Visibility="{Binding CfIsAuthenticated, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="TUNNELS" FontWeight="Bold" FontSize="13"
                                           Foreground="#FFD700" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding CfTunnelInfo}" Foreground="#F0E6D0" FontSize="12"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Users Tab -->
            <TabItem Header="Users" Foreground="{StaticResource TextPrimaryBrush}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Registered Users" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button Content="Refresh" Margin="16,0,0,0" Width="80"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RefreshUsersCommand}"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionMode="Single" SelectedItem="{Binding SelectedUser}"
                              Background="{StaticResource SurfaceBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              RowBackground="{StaticResource CardBrush}"
                              AlternatingRowBackground="{StaticResource SurfaceBrush}"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                              BorderBrush="{StaticResource BorderBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="170"/>
                            <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="110"/>
                            <DataGridTextColumn Header="Version" Binding="{Binding ClientVersion}" Width="80"/>
                            <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="90"/>
                            <DataGridCheckBoxColumn Header="Admin" Binding="{Binding IsAdmin}" Width="50"/>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="50"/>
                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="130"/>
                            <DataGridTextColumn Header="Last Login" Binding="{Binding LastLoginAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="130"/>
                            <DataGridCheckBoxColumn Header="EULA" Binding="{Binding HasAcceptedEula}" Width="50"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <!-- User action buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Deactivate User" Width="130"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding DeactivateUserCommand}" Margin="0,0,8,0"/>
                            <Button Content="Activate User" Width="130"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ActivateUserCommand}" Margin="0,0,8,0"/>
                            <Button Content="Ban User" Width="100"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding BanUserCommand}" Margin="0,0,8,0"/>
                            <Button Content="Unban User" Width="100"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding UnbanUserCommand}" Margin="0,0,8,0"/>
                            <Button Content="Promote to Admin" Width="130"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding PromoteUserCommand}" Margin="0,0,8,0"/>
                            <Button Content="Demote" Width="80"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding DemoteUserCommand}" Margin="0,0,8,0"/>
                            <Button Content="Delete User" Width="110"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding DeleteUserCommand}"/>
                        </StackPanel>

                        <!-- Direct Message Section -->
                        <Border Background="{StaticResource CardBrush}" CornerRadius="6"
                                Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Send Direct Message" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedUser.Username, StringFormat='To: {0}',
                                           FallbackValue='Select a user above'}"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                           Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding DmMessageText, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12" Padding="6,4"
                                             Background="{StaticResource SurfaceBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderBrush="{StaticResource BorderBrush}"/>
                                    <Button Grid.Column="2" Content="Send DM" Width="90"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding SendDmToUserCommand}"/>
                                </Grid>
                                <TextBlock Text="{Binding DmStatus}" FontSize="11"
                                           Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Password Change Section -->
                        <Border Background="{StaticResource CardBrush}" CornerRadius="6"
                                Padding="16">
                            <StackPanel>
                                <TextBlock Text="Change Password" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Select a user above, then enter a new password."
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                           Margin="0,0,0,10"/>

                                <TextBlock Text="{Binding SelectedUser.Username, StringFormat='Changing password for: {0}',
                                           FallbackValue='No user selected'}"
                                           Foreground="{StaticResource AccentBrush}" FontSize="12"
                                           FontWeight="SemiBold" Margin="0,0,0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="New Password:" FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <PasswordBox Grid.Column="1" x:Name="NewPasswordBox"
                                                 FontSize="12" Padding="6,4"
                                                 Background="{StaticResource SurfaceBrush}"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 BorderBrush="{StaticResource BorderBrush}"/>

                                    <TextBlock Grid.Column="3" Text="Confirm:" FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <PasswordBox Grid.Column="4" x:Name="ConfirmPasswordBox"
                                                 FontSize="12" Padding="6,4"
                                                 Background="{StaticResource SurfaceBrush}"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 BorderBrush="{StaticResource BorderBrush}"/>

                                    <Button Grid.Column="6" Content="Change Password" Width="130"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="OnChangePasswordClick"/>
                                </Grid>

                                <!-- Status message -->
                                <TextBlock Text="{Binding ChangePasswordStatus}" FontSize="12"
                                           Margin="0,8,0,0" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ChangePasswordHasError}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ChangePasswordSuccess}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Server Users Section -->
                        <Border Background="{StaticResource CardBrush}" CornerRadius="6"
                                Padding="12" Margin="0,12,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Server Users (Remote)" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                    <Button Content="Load Server Users" Margin="16,0,0,0" Width="140"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding LoadServerUsersCommand}"/>
                                    <TextBlock Text="{Binding ServerUserStatus}" FontSize="11"
                                               Foreground="{StaticResource AccentBrush}"
                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>

                                <DataGrid ItemsSource="{Binding ServerUsers}" AutoGenerateColumns="False"
                                          IsReadOnly="True" SelectionMode="Single" SelectedItem="{Binding SelectedServerUser}"
                                          Height="180"
                                          Background="{StaticResource SurfaceBrush}"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          RowBackground="{StaticResource CardBrush}"
                                          AlternatingRowBackground="{StaticResource SurfaceBrush}"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                          BorderBrush="{StaticResource BorderBrush}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="140"/>
                                        <DataGridCheckBoxColumn Header="Admin" Binding="{Binding IsAdmin}" Width="55"/>
                                        <DataGridCheckBoxColumn Header="Banned" Binding="{Binding IsBanned}" Width="60"/>
                                        <DataGridTextColumn Header="Registered" Binding="{Binding RegisteredAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140"/>
                                        <DataGridTextColumn Header="Last Login" Binding="{Binding LastLoginAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Ban" Width="70"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Command="{Binding BanServerUserCommand}" Margin="0,0,6,0"/>
                                    <Button Content="Unban" Width="70"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding UnbanServerUserCommand}" Margin="0,0,6,0"/>
                                    <Button Content="Promote" Width="80"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding PromoteServerUserCommand}" Margin="0,0,6,0"/>
                                    <Button Content="Demote" Width="80"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding DemoteServerUserCommand}" Margin="0,0,6,0"/>
                                    <Button Content="Delete" Width="70"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Command="{Binding DeleteServerUserCommand}" Margin="0,0,16,0"/>
                                </StackPanel>

                                <!-- Server User DM -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding ServerDmText, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12" Padding="6,4"
                                             Background="{StaticResource SurfaceBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderBrush="{StaticResource BorderBrush}"/>
                                    <Button Grid.Column="2" Content="Send DM" Width="90"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding SendDmToServerUserCommand}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Reports Tab -->
            <TabItem Header="Reports" Foreground="{StaticResource TextPrimaryBrush}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="System Reports" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button Content="Generate Report" Margin="16,0,0,0" Width="120"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding GenerateReportCommand}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding ReportText}" IsReadOnly="True"
                                 Background="{StaticResource CardBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 FontFamily="Consolas" FontSize="12"
                                 TextWrapping="Wrap" Padding="12"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 AcceptsReturn="True"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Diagnostics Tab -->
            <TabItem Header="Diagnostics" Foreground="{StaticResource TextPrimaryBrush}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="System Diagnostics" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button Content="Run Diagnostics" Margin="16,0,0,0" Width="130"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding RunDiagnosticsCommand}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- System Info Cards -->
                            <Border Background="{StaticResource CardBrush}" CornerRadius="6"
                                    Padding="16" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="System Information" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding DiagOsVersion, StringFormat='OS: {0}'}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding DiagMachineName, StringFormat='Machine: {0}'}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding DiagProcessorCount, StringFormat='Processors: {0}'}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding DiagMemoryMb, StringFormat='Available Memory: {0} MB'}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding DiagUptime, StringFormat='System Uptime: {0}'}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource CardBrush}" CornerRadius="6"
                                    Padding="16" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Application Status" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding DiagModelLoaded, StringFormat='LLM Model Loaded: {0}'}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding DiagDbSize, StringFormat='Database Size: {0}'}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding DiagThreatCount, StringFormat='Threat Signatures: {0}'}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding DiagUserCount, StringFormat='Registered Users: {0}'}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <!-- Client Connection Info -->
                            <Border Background="{StaticResource CardBrush}" CornerRadius="6"
                                    Padding="16" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Client Connection Info" FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding LocalIpAddress, StringFormat='Local IP: {0}'}"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding PublicIpAddress, StringFormat='Public IP: {0}'}"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding CurrentIpAddress}" Foreground="{StaticResource SecondaryBrush}"
                                                   FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="Refresh IP" VerticalAlignment="Top"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="12,6"
                                            Command="{Binding RefreshIpCommand}"/>
                                </Grid>
                            </Border>

                            <!-- Detailed Log -->
                            <Border Background="{StaticResource CardBrush}" CornerRadius="6"
                                    Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Diagnostic Log" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding DiagLog}" IsReadOnly="True"
                                             Background="{StaticResource SurfaceBrush}"
                                             Foreground="{StaticResource TextSecondaryBrush}"
                                             FontFamily="Consolas" FontSize="11"
                                             TextWrapping="Wrap" Padding="8" MaxHeight="300"
                                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                             BorderBrush="{StaticResource BorderBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Remote Assist Tab -->
            <TabItem Header="Remote Assist" Foreground="{StaticResource TextPrimaryBrush}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Client Remote Assistance" FontSize="16"
                               FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,12"/>

                    <Border Grid.Row="1" Background="#44FF8800" CornerRadius="4"
                            Padding="12" Margin="0,0,0,12">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" FontSize="12">
                            Remote assistance allows you to view and assist a client's desktop.
                            This feature requires the client's explicit consent and an active
                            network connection to their device. Currently supports local network only.
                        </TextBlock>
                    </Border>

                    <!-- Remote View Area -->
                    <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="6"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <!-- Connection Status -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding IsNotConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Not Connected" FontSize="24" FontWeight="Light"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <TextBlock Text="Client IP:" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding RemoteClientIp, UpdateSourceTrigger=PropertyChanged}"
                                             Width="200" FontSize="13" Padding="8,6"
                                             Background="{StaticResource SurfaceBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             CaretBrush="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <Button Content="Connect" Width="140" Height="36"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ConnectRemoteCommand}"/>
                            </StackPanel>

                            <!-- Connected View (Screenshot display) -->
                            <Grid Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Image Source="{Binding RemoteScreenshot}" Stretch="Uniform"/>
                                <TextBlock Text="{Binding RemoteStatusText}"
                                           Foreground="{StaticResource SuccessBrush}" FontSize="11"
                                           VerticalAlignment="Top" HorizontalAlignment="Right"
                                           Margin="0,8,8,0" Background="#88000000" Padding="6,3"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Remote Controls -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Refresh Screen" Width="120"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RefreshScreenCommand}" Margin="0,0,8,0"/>
                        <Button Content="Disconnect" Width="100"
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding DisconnectCommand}"/>
                        <TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Broadcast Notification Tab -->
            <TabItem Header="Broadcast" Foreground="{StaticResource TextPrimaryBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="BROADCAST NOTIFICATION WITH COUNTDOWN" FontWeight="Bold" FontSize="14"
                                   Foreground="#F0E6D0" Margin="0,0,0,8"/>
                        <TextBlock Text="Send a timed notification to all connected clients. The countdown timer will be displayed on every client's dashboard."
                                   Foreground="#A89880" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Message Input -->
                        <Border Background="#1A1610" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Notification Message" Foreground="#A89880" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding BroadcastMessageText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource CardBrush}"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         BorderBrush="{StaticResource SurfaceBrush}"
                                         Padding="10,8" FontSize="14"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="60" MaxHeight="120"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>

                        <!-- Countdown Timer Inputs -->
                        <TextBlock Text="COUNTDOWN TIMER" FontWeight="Bold" FontSize="14"
                                   Foreground="#F0E6D0" Margin="0,0,0,8"/>
                        <Border Background="#1A1610" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Days -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Days" Foreground="#A89880" FontSize="11"
                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding BroadcastDays, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{StaticResource CardBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderBrush="{StaticResource SurfaceBrush}"
                                             Padding="8,6" FontSize="18" FontWeight="Bold"
                                             TextAlignment="Center"/>
                                </StackPanel>

                                <!-- Hours -->
                                <StackPanel Grid.Column="1" Margin="4,0">
                                    <TextBlock Text="Hours" Foreground="#A89880" FontSize="11"
                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding BroadcastHours, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{StaticResource CardBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderBrush="{StaticResource SurfaceBrush}"
                                             Padding="8,6" FontSize="18" FontWeight="Bold"
                                             TextAlignment="Center"/>
                                </StackPanel>

                                <!-- Minutes -->
                                <StackPanel Grid.Column="2" Margin="4,0">
                                    <TextBlock Text="Minutes" Foreground="#A89880" FontSize="11"
                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding BroadcastMinutes, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{StaticResource CardBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderBrush="{StaticResource SurfaceBrush}"
                                             Padding="8,6" FontSize="18" FontWeight="Bold"
                                             TextAlignment="Center"/>
                                </StackPanel>

                                <!-- Seconds -->
                                <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                    <TextBlock Text="Seconds" Foreground="#A89880" FontSize="11"
                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding BroadcastSeconds, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{StaticResource CardBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderBrush="{StaticResource SurfaceBrush}"
                                             Padding="8,6" FontSize="18" FontWeight="Bold"
                                             TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <Button Content="Send Broadcast Notification"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SendBroadcastNotificationCommand}"
                                    Padding="16,8" FontSize="13" Margin="0,0,8,0"/>
                            <Button Content="Clear Active Notification"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding ClearBroadcastNotificationCommand}"
                                    Padding="16,8" FontSize="13"/>
                        </StackPanel>

                        <!-- Status Message -->
                        <TextBlock Text="{Binding BroadcastNotificationStatus}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#a6e3a1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BroadcastNotificationHasError}" Value="True">
                                            <Setter Property="Foreground" Value="#f38ba8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Info box -->
                        <Border Background="#1A1610" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="HOW IT WORKS" Foreground="#A89880" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Foreground="#A89880" FontSize="12" TextWrapping="Wrap">
                                    When you send a broadcast notification, all connected clients will see a prominent
                                    banner on their Dashboard with your message and a live countdown timer. The notification
                                    automatically disappears when the countdown reaches zero. You can also manually clear
                                    it at any time using the Clear button.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Hardware Monitor Tab -->
            <TabItem Header="Hardware" Foreground="{StaticResource TextPrimaryBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="HARDWARE MONITOR" FontWeight="Bold" FontSize="14"
                                   Foreground="#F0E6D0" Margin="0,0,0,8"/>
                        <TextBlock Text="Real-time hardware resource utilization snapshot from the server."
                                   Foreground="#A89880" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- CPU / RAM / GPU Progress Bars -->
                        <Border Background="#1A1610" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <!-- CPU -->
                                <TextBlock Text="CPU USAGE" Foreground="#A89880" FontSize="11" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,12">
                                    <ProgressBar Value="{Binding HwCpuUsage}" Minimum="0" Maximum="100"
                                                 Height="22" Background="#3A3020" Foreground="#FFD700"
                                                 BorderBrush="#4A3D2A" BorderThickness="1"/>
                                    <TextBlock Text="{Binding HwCpuUsage, StringFormat='{}{0:F1}%'}"
                                               Foreground="#F0E6D0" FontSize="12" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- RAM -->
                                <TextBlock Text="RAM USAGE" Foreground="#A89880" FontSize="11" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,12">
                                    <ProgressBar Value="{Binding HwRamUsage}" Minimum="0" Maximum="100"
                                                 Height="22" Background="#3A3020" Foreground="#a6e3a1"
                                                 BorderBrush="#4A3D2A" BorderThickness="1"/>
                                    <TextBlock Text="{Binding HwRamUsage, StringFormat='{}{0:F1}%'}"
                                               Foreground="#F0E6D0" FontSize="12" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- GPU -->
                                <TextBlock Text="GPU USAGE" Foreground="#A89880" FontSize="11" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,12">
                                    <ProgressBar Value="{Binding HwGpuUsage}" Minimum="0" Maximum="100"
                                                 Height="22" Background="#3A3020" Foreground="#f9e2af"
                                                 BorderBrush="#4A3D2A" BorderThickness="1"/>
                                    <TextBlock Text="{Binding HwGpuUsage, StringFormat='{}{0:F1}%'}"
                                               Foreground="#F0E6D0" FontSize="12" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Temperature / Fan / Disk -->
                        <Border Background="#1A1610" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                    <TextBlock Text="Temperature" Foreground="#A89880" FontSize="11"/>
                                    <TextBlock Text="{Binding HwTemperature, StringFormat='{}{0:F0} °C'}"
                                               Foreground="#f38ba8" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock Text="Fan Speed" Foreground="#A89880" FontSize="11"/>
                                    <TextBlock Text="{Binding HwFanSpeed, StringFormat='{}{0} RPM'}"
                                               Foreground="#E0B030" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Disk Usage -->
                        <TextBlock Text="DISK USAGE" FontWeight="Bold" FontSize="14"
                                   Foreground="#F0E6D0" Margin="0,0,0,8"/>
                        <Border Background="#1A1610" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <ItemsControl ItemsSource="{Binding HwDiskUsage}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding}" Foreground="#F0E6D0" FontSize="12"
                                                       FontFamily="Consolas"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Refresh Button -->
                        <Button Content="Refresh Hardware"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding RefreshHardwareCommand}"
                                Padding="16,8" FontSize="13" HorizontalAlignment="Left"/>

                        <!-- Status -->
                        <TextBlock Text="{Binding HwStatus}" Foreground="#A89880" FontSize="12"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Multi-LLM Control Tab -->
            <TabItem Header="Multi-LLM" Foreground="{StaticResource TextPrimaryBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="MULTI-LLM CONTROL" FontWeight="Bold" FontSize="14"
                                   Foreground="#F0E6D0" Margin="0,0,0,4"/>
                        <TextBlock Text="Manage up to 4 LLM model slots. Assign roles and abilities to each mounted model."
                                   Foreground="#A89880" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- 2x2 Slot Grid -->
                        <ItemsControl ItemsSource="{Binding LlmSlots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1A1610" CornerRadius="8" Padding="14" Margin="4">
                                        <StackPanel>
                                            <!-- Slot header with colored status indicator -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Ellipse Width="12" Height="12" Margin="0,0,8,0"
                                                         VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#5A4D3A"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMounted}" Value="True">
                                                                    <Setter Property="Fill" Value="#a6e3a1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding SlotIndex, StringFormat='Slot {0}'}"
                                                           Foreground="#FFD700" FontSize="14" FontWeight="Bold"
                                                           VerticalAlignment="Center"/>
                                                <!-- Mounted status label -->
                                                <TextBlock Margin="10,0,0,0" FontSize="11" FontWeight="SemiBold"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Empty"/>
                                                            <Setter Property="Foreground" Value="#5A4D3A"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMounted}" Value="True">
                                                                    <Setter Property="Text" Value="Mounted"/>
                                                                    <Setter Property="Foreground" Value="#a6e3a1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Current Model Name (shown when mounted) -->
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"
                                                       Visibility="{Binding IsMounted, Converter={StaticResource BoolToVis}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding ModelName}"/>
                                                        <Setter Property="Foreground" Value="#a6e3a1"/>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Model Selection ComboBox -->
                                            <TextBlock Text="Select Model" Foreground="#A89880" FontSize="11" Margin="0,0,0,2"/>
                                            <ComboBox SelectedItem="{Binding SelectedCatalogModel}" Margin="0,0,0,8"
                                                      ItemsSource="{Binding DataContext.LlmCatalogModels, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      Background="#3A3020" Foreground="#F0E6D0"
                                                      BorderBrush="#4A3D2A" Padding="6,4" FontSize="12"/>

                                            <!-- Role ComboBox -->
                                            <TextBlock Text="Role" Foreground="#A89880" FontSize="11" Margin="0,0,0,2"/>
                                            <ComboBox SelectedItem="{Binding Role}" Margin="0,0,0,8"
                                                      Background="#3A3020" Foreground="#F0E6D0"
                                                      BorderBrush="#4A3D2A" Padding="6,4" FontSize="12">
                                                <sys:String>Unassigned</sys:String>
                                                <sys:String>MainEngine</sys:String>
                                                <sys:String>PromptCleanup</sys:String>
                                                <sys:String>TtsEngine</sys:String>
                                                <sys:String>AiChat</sys:String>
                                            </ComboBox>

                                            <!-- Ability ComboBox -->
                                            <TextBlock Text="Ability" Foreground="#A89880" FontSize="11" Margin="0,0,0,2"/>
                                            <ComboBox SelectedItem="{Binding Ability}" Margin="0,0,0,8"
                                                      Background="#3A3020" Foreground="#F0E6D0"
                                                      BorderBrush="#4A3D2A" Padding="6,4" FontSize="12">
                                                <sys:String>None</sys:String>
                                                <sys:String>Agent</sys:String>
                                                <sys:String>Monitor</sys:String>
                                                <sys:String>DualPowerMain</sys:String>
                                                <sys:String>TextToSpeech</sys:String>
                                                <sys:String>ImageGeneration</sys:String>
                                                <sys:String>PromptCleanUp</sys:String>
                                            </ComboBox>

                                            <!-- Mount / Unmount Button -->
                                            <Button Padding="10,6" FontSize="12"
                                                    HorizontalAlignment="Stretch"
                                                    Command="{Binding DataContext.MountOrUnmountSlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding SlotIndex}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content" Value="Mount"/>
                                                        <Setter Property="Background" Value="#4A3D2A"/>
                                                        <Setter Property="Foreground" Value="#a6e3a1"/>
                                                        <Setter Property="BorderBrush" Value="#5A4D3A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMounted}" Value="True">
                                                                <Setter Property="Content" Value="Unmount"/>
                                                                <Setter Property="Foreground" Value="#f38ba8"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Catalog -->
                        <TextBlock Text="MODEL CATALOG" FontWeight="Bold" FontSize="14"
                                   Foreground="#F0E6D0" Margin="0,16,0,8"/>
                        <Border Background="#1A1610" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Available models from the server catalog:"
                                           Foreground="#A89880" FontSize="11" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding LlmCatalogModels}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <Ellipse Width="6" Height="6" Fill="#FFD700" Margin="0,0,6,0"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding}" Foreground="#F0E6D0" FontSize="12"
                                                           FontFamily="Consolas"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Legacy catalog (raw names) -->
                        <Border Background="#1A1610" CornerRadius="8" Padding="12" Margin="0,0,0,16"
                                Visibility="{Binding LlmCatalog.Count, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding LlmCatalog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#A89880" FontSize="11"
                                                   FontFamily="Consolas" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Refresh Slots"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding RefreshLlmSlotsCommand}"
                                    Padding="16,8" FontSize="13" Margin="0,0,8,0"/>
                            <Button Content="Reload Catalog"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding LoadLlmCatalogCommand}"
                                    Padding="16,8" FontSize="13"/>
                        </StackPanel>

                        <TextBlock Text="{Binding LlmStatus}" Foreground="#A89880" FontSize="12"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Website Metrics Tab -->
            <TabItem Header="Web Metrics" Foreground="{StaticResource TextPrimaryBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="WEBSITE METRICS" FontWeight="Bold" FontSize="14"
                                   Foreground="#F0E6D0" Margin="0,0,0,8"/>
                        <TextBlock Text="Visitor analytics and download statistics for the public website."
                                   Foreground="#A89880" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Visitor Stats -->
                        <Border Background="#1A1610" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                    <TextBlock Text="Total Visitors" Foreground="#A89880" FontSize="11"/>
                                    <TextBlock Text="{Binding WmTotalVisitors, StringFormat='{}{0:N0}'}"
                                               Foreground="#FFD700" FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                    <TextBlock Text="Active Now" Foreground="#A89880" FontSize="11"/>
                                    <TextBlock Text="{Binding WmActiveVisitors}"
                                               Foreground="#a6e3a1" FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                    <TextBlock Text="Avg Session Duration" Foreground="#A89880" FontSize="11"/>
                                    <TextBlock Text="{Binding WmAvgDuration}"
                                               Foreground="#f9e2af" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock Text="Total Downloads" Foreground="#A89880" FontSize="11"/>
                                    <TextBlock Text="{Binding WmTotalDownloads, StringFormat='{}{0:N0}'}"
                                               Foreground="#E0B030" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Downloads by Platform -->
                        <TextBlock Text="DOWNLOADS BY PLATFORM" FontWeight="Bold" FontSize="14"
                                   Foreground="#F0E6D0" Margin="0,0,0,8"/>
                        <Border Background="#1A1610" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <ItemsControl ItemsSource="{Binding WmDownloadsByPlatform}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Key}"
                                                       Foreground="#FFD700" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value, StringFormat='{}{0:N0}'}"
                                                       Foreground="#F0E6D0" FontSize="13"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Top Countries -->
                        <TextBlock Text="TOP VISITOR COUNTRIES" FontWeight="Bold" FontSize="14"
                                   Foreground="#F0E6D0" Margin="0,0,0,8"/>
                        <Border Background="#1A1610" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <ItemsControl ItemsSource="{Binding WmTopCountries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Key}"
                                                       Foreground="#f9e2af" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value, StringFormat='{}{0:N0} visits'}"
                                                       Foreground="#F0E6D0" FontSize="13"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Refresh Button -->
                        <Button Content="Refresh Metrics"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding RefreshWebMetricsCommand}"
                                Padding="16,8" FontSize="13" HorizontalAlignment="Left"/>

                        <TextBlock Text="{Binding WmStatus}" Foreground="#A89880" FontSize="12"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Website Editor Tab -->
            <TabItem Header="Website Editor" Foreground="{StaticResource TextPrimaryBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="WEBSITE CONTENT EDITOR" FontWeight="Bold" FontSize="14"
                                   Foreground="#F0E6D0" Margin="0,0,0,8"/>
                        <TextBlock Text="Edit the public-facing website content. Changes are saved to the server and reflected on the live site."
                                   Foreground="#A89880" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- Hero Section -->
                        <Border Background="#1A1610" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="HERO SECTION" FontWeight="Bold" FontSize="13"
                                           Foreground="#FFD700" Margin="0,0,0,12"/>

                                <TextBlock Text="Hero Title" Foreground="#A89880" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding WeHeroTitle, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#3A3020" Foreground="#F0E6D0" BorderBrush="#4A3D2A"
                                         Padding="8,6" FontSize="13" Margin="0,0,0,12"/>

                                <TextBlock Text="Hero Subtitle" Foreground="#A89880" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding WeHeroSubtitle, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#3A3020" Foreground="#F0E6D0" BorderBrush="#4A3D2A"
                                         Padding="8,6" FontSize="13" TextWrapping="Wrap"
                                         AcceptsReturn="True" MinHeight="60" Margin="0,0,0,4"/>
                            </StackPanel>
                        </Border>

                        <!-- Announcement Banner -->
                        <Border Background="#1A1610" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="ANNOUNCEMENT BANNER" FontWeight="Bold" FontSize="13"
                                           Foreground="#FFD700" Margin="0,0,0,12"/>

                                <TextBlock Text="Banner Text" Foreground="#A89880" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding WeAnnouncementBanner, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#3A3020" Foreground="#F0E6D0" BorderBrush="#4A3D2A"
                                         Padding="8,6" FontSize="13" TextWrapping="Wrap"
                                         AcceptsReturn="True" MinHeight="40" Margin="0,0,0,12"/>

                                <CheckBox IsChecked="{Binding WeAnnouncementVisible}"
                                          Foreground="#F0E6D0" FontSize="13" Margin="0,0,0,4">
                                    <TextBlock Text="Show Announcement Banner" Foreground="#F0E6D0"/>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <!-- Support Info -->
                        <Border Background="#1A1610" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="SUPPORT INFORMATION" FontWeight="Bold" FontSize="13"
                                           Foreground="#FFD700" Margin="0,0,0,12"/>

                                <TextBlock Text="Support Email" Foreground="#A89880" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding WeSupportEmail, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#3A3020" Foreground="#F0E6D0" BorderBrush="#4A3D2A"
                                         Padding="8,6" FontSize="13" Margin="0,0,0,4"/>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Load Content"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding LoadWebsiteContentCommand}"
                                    Padding="16,8" FontSize="13" Margin="0,0,12,0"/>
                            <Button Content="Save Content"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveWebsiteContentCommand}"
                                    Padding="16,8" FontSize="13"/>
                        </StackPanel>

                        <TextBlock Text="{Binding WeStatus}" Foreground="#A89880" FontSize="12"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Server Dashboard Tab (visible only in Server mode) -->
            <TabItem Header="Server" Foreground="{StaticResource TextPrimaryBrush}"
                     Visibility="{Binding HasServerTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <!-- Fallback message when ServerDashboardVm is null -->
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                            Padding="24" Margin="16"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsServerDashboardUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Server Dashboard Unavailable"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource WarningBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding ServerDashboardUnavailableMessage}"
                                       FontSize="13" TextWrapping="Wrap" MaxWidth="500"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Actual server dashboard content when available -->
                    <ContentControl Content="{Binding ServerDashboardVm}" Margin="0">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type vm:ServerDashboardViewModel}">
                                <views:ServerDashboardView/>
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
