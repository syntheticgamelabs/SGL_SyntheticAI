<UserControl x:Class="SGL.JudgeDredd.App.Views.EndpointMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="ENDPOINT MONITORING ENGINE" FontSize="18" FontWeight="Bold" Foreground="#F0E6D0"/>
            <TextBlock Text="Monitor system services, ports, drivers, startup programs, and scheduled tasks" Foreground="#A89880" Margin="0,4,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Scan Endpoints" Command="{Binding ScanEndpointsCommand}" Background="#4A3D2A" Foreground="#F0E6D0" BorderBrush="#5A4D3A" Padding="15,8" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding ScanStatus}" Foreground="#a6e3a1" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Stats Cards -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,15">
            <Border Background="#3A3020" CornerRadius="8" Padding="15,10" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Services" Foreground="#A89880" FontSize="11"/><TextBlock FontSize="20" Foreground="#FFD700"><Run Text="{Binding RunningServices, Mode=OneWay}"/><Run Text="/" Foreground="#5A4D3A"/><Run Text="{Binding TotalServices, Mode=OneWay}"/></TextBlock></StackPanel>
            </Border>
            <Border Background="#3A3020" CornerRadius="8" Padding="15,10" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Open Ports" Foreground="#A89880" FontSize="11"/><TextBlock Text="{Binding OpenPorts}" FontSize="20" Foreground="#f9e2af"/></StackPanel>
            </Border>
            <Border Background="#3A3020" CornerRadius="8" Padding="15,10" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Drivers" Foreground="#A89880" FontSize="11"/><TextBlock Text="{Binding InstalledDrivers}" FontSize="20" Foreground="#E0B030"/></StackPanel>
            </Border>
            <Border Background="#3A3020" CornerRadius="8" Padding="15,10" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Startup" Foreground="#A89880" FontSize="11"/><TextBlock Text="{Binding StartupPrograms}" FontSize="20" Foreground="#FF8C00"/></StackPanel>
            </Border>
            <Border Background="#3A3020" CornerRadius="8" Padding="15,10" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Tasks" Foreground="#A89880" FontSize="11"/><TextBlock Text="{Binding ScheduledTasks}" FontSize="20" Foreground="#FFB347"/></StackPanel>
            </Border>
            <Border Background="#3A3020" CornerRadius="8" Padding="15,10" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Suspicious" Foreground="#A89880" FontSize="11"/><TextBlock Text="{Binding SuspiciousCount}" FontSize="20" Foreground="#f38ba8"/></StackPanel>
            </Border>
        </WrapPanel>

        <!-- Results DataGrid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Endpoints}" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#1A1610" Foreground="#F0E6D0" BorderBrush="#3A3020" RowBackground="#1A1610" AlternatingRowBackground="#151210"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3A3020" CanUserSortColumns="True">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#3A3020"/>
                    <Setter Property="Foreground" Value="#F0E6D0"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="BorderBrush" Value="#4A3D2A"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
                <DataGridCheckBoxColumn Header="Sus." Binding="{Binding IsSuspicious}" Width="50"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
