<UserControl x:Class="SGL.JudgeDredd.App.Views.SecurityMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:SGL.JudgeDredd.Shared.Localization;assembly=SGL.JudgeDredd.Shared"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page title -->
        <TextBlock Grid.Row="0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[security.title]}"
                   Style="{StaticResource HeadingTextStyle}"
                   Margin="0,0,0,20"/>

        <!-- Monitor toggle switches -->
        <Border Grid.Row="1" Style="{StaticResource SurfaceBorderStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[security.activeMonitors]}"
                           Style="{StaticResource SubheadingTextStyle}"
                           Margin="0,0,0,16"/>

                <UniformGrid Rows="1" Columns="4">
                    <!-- Remote Access Monitor -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Remote Access"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <CheckBox IsChecked="{Binding IsRemoteAccessMonitorActive}"
                                      Content="Enabled"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Bad USB Monitor -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Bad USB"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <CheckBox IsChecked="{Binding IsBadUsbMonitorActive}"
                                      Content="Enabled"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- AI Detection -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="AI Detection"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <CheckBox IsChecked="{Binding IsAiDetectionActive}"
                                      Content="Enabled"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Registry Watcher -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Registry Watcher"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <CheckBox IsChecked="{Binding IsRegistryWatcherActive}"
                                      Content="Enabled"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Alerts label -->
        <TextBlock Grid.Row="2" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[security.alerts]}"
                   Style="{StaticResource SubheadingTextStyle}"
                   Margin="0,0,0,8"/>

        <!-- Alerts list -->
        <Border Grid.Row="3" Style="{StaticResource SurfaceBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Alerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}"
                                    CornerRadius="{StaticResource DefaultCornerRadius}"
                                    Padding="16,12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Severity indicator -->
                                    <Border Grid.Column="0" Width="4" CornerRadius="2"
                                            Background="{StaticResource DangerBrush}"
                                            Margin="0,0,16,0"/>

                                    <StackPanel Grid.Column="1">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold" FontSize="14"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Severity}"
                                                       Foreground="{StaticResource WarningBrush}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Category}"
                                                       Style="{StaticResource SecondaryTextStyle}"
                                                       Margin="0,0,16,0"/>
                                            <TextBlock Text="{Binding DetectedAt, StringFormat='Detected: {0:yyyy-MM-dd HH:mm:ss}'}"
                                                       Style="{StaticResource SecondaryTextStyle}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Action buttons -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[security.acknowledge]}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="10,4" FontSize="11"
                                                Command="{Binding DataContext.AcknowledgeAlertCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,0,4"/>
                                        <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[security.dismiss]}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Padding="10,4" FontSize="11"
                                                Command="{Binding DataContext.DismissAlertCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                    <!-- Empty state -->
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" Margin="0,40">
                                                    <TextBlock Text="No active security alerts."
                                                               Foreground="{StaticResource SuccessBrush}"
                                                               FontSize="16" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,8"/>
                                                    <TextBlock Text="All monitors are watching for threats."
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="12"
                                                               HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
