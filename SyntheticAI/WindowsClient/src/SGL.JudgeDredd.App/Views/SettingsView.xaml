<UserControl x:Class="SGL.JudgeDredd.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SGL.JudgeDredd.App.ViewModels"
             xmlns:loc="clr-namespace:SGL.JudgeDredd.Shared.Localization;assembly=SGL.JudgeDredd.Shared"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <!-- BoolToVisibility converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Page title -->
        <TextBlock Grid.Row="0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[settings.title]}"
                   Style="{StaticResource HeadingTextStyle}"
                   Margin="0,0,0,20"/>

        <!-- Tab Control -->
        <TabControl Grid.Row="1">

            <!-- ======== GENERAL TAB ======== -->
            <TabItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[settings.general]}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[settings.general]}"
                                   Style="{StaticResource SubheadingTextStyle}"
                                   Margin="0,0,0,16"/>

                        <CheckBox Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[settings.startWithWindows]}"
                                  IsChecked="{Binding StartWithWindows}"
                                  Margin="0,0,0,12"/>

                        <CheckBox Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[settings.minimizeToTray]}"
                                  IsChecked="{Binding MinimizeToTray}"
                                  Margin="0,0,0,12"/>

                        <CheckBox Content="Notification sounds"
                                  IsChecked="{Binding NotificationSounds}"
                                  Margin="0,0,0,12"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======== SCANNER TAB ======== -->
            <TabItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[settings.scanner]}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[settings.scanner]}"
                                   Style="{StaticResource SubheadingTextStyle}"
                                   Margin="0,0,0,16"/>

                        <CheckBox Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[settings.realTimeProtection]}"
                                  IsChecked="{Binding RealTimeProtection}"
                                  Margin="0,0,0,16"/>

                        <TextBlock Text="Scan Exclusions (one per line):"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,8"/>

                        <TextBox Text="{Binding ScanExclusions, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="120"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======== FIREWALL TAB ======== -->
            <TabItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[settings.firewallSettings]}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[firewall.title]}"
                                   Style="{StaticResource SubheadingTextStyle}"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="Default Action:"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,8"/>
                        <ComboBox SelectedItem="{Binding DefaultFirewallAction}"
                                  Width="200" HorizontalAlignment="Left"
                                  Margin="0,0,0,16">
                            <ComboBoxItem Content="Block"/>
                            <ComboBoxItem Content="Allow"/>
                            <ComboBoxItem Content="Prompt"/>
                        </ComboBox>

                        <TextBlock Text="Logging Verbosity:"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,8"/>
                        <ComboBox SelectedItem="{Binding LoggingVerbosity}"
                                  Width="200" HorizontalAlignment="Left">
                            <ComboBoxItem Content="Minimal"/>
                            <ComboBoxItem Content="Normal"/>
                            <ComboBoxItem Content="Verbose"/>
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======== LLM TAB ======== -->
            <TabItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[settings.llm]}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>

                        <!-- ── MODEL MANAGEMENT SECTION ── -->
                        <TextBlock Text="LLM Model Management"
                                   Style="{StaticResource SubheadingTextStyle}"
                                   Margin="0,0,0,12"/>

                        <!-- Status text -->
                        <TextBlock Text="{Binding ModelStatusText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0,0,0,12"/>

                        <!-- Active model selector and swap -->
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Active Model"
                                           Foreground="{StaticResource SecondaryBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Margin="0,0,0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding AvailableModels}"
                                              SelectedItem="{Binding SelectedModel}"
                                              Margin="0,0,8,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:LlmModelDisplayItem}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Info.DisplayName}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text=" - "
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="4,0,0,0"/>
                                                    <TextBlock Text="{Binding Info.SizeDisplay}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Text=" [ACTIVE]"
                                                               Foreground="{StaticResource SuccessBrush}"
                                                               FontWeight="Bold"
                                                               Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text=" [NOT INSTALLED]"
                                                               Foreground="{StaticResource WarningBrush}"
                                                               FontSize="11"
                                                               Margin="6,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <Button Grid.Column="1"
                                            Content="Swap Model"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding SwapModelCommand}"
                                            Padding="12,6"
                                            Margin="0,0,4,0"
                                            ToolTip="Unload current model and load the selected one"/>

                                    <Button Grid.Column="2"
                                            Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[common.refresh]}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding RefreshModelsCommand}"
                                            Padding="12,6"
                                            ToolTip="Re-scan the LLM folder"/>
                                </Grid>

                                <!-- Current model info -->
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                        <Run Text="Current: "/>
                                        <Run Text="{Binding CurrentModel.Info.DisplayName, FallbackValue='None'}"
                                             Foreground="{StaticResource SuccessBrush}"/>
                                        <Run Text=" | "/>
                                        <Run Text="{Binding CurrentModel.Info.BestFor, FallbackValue=''}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── AVAILABLE MODELS LIST ── -->
                        <TextBlock Text="All Available Models"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <ItemsControl ItemsSource="{Binding AvailableModels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LlmModelDisplayItem}">
                                    <Border Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="12"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Model info -->
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Info.DisplayName}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontWeight="SemiBold"
                                                               FontSize="14"/>

                                                    <!-- Badges -->
                                                    <Border Background="{StaticResource SuccessBrush}"
                                                            CornerRadius="3"
                                                            Padding="6,1"
                                                            Margin="8,0,0,0"
                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="ACTIVE" FontSize="10"
                                                                   Foreground="#1A1A2E" FontWeight="Bold"/>
                                                    </Border>

                                                    <Border CornerRadius="3"
                                                            Padding="6,1"
                                                            Margin="4,0,0,0"
                                                            Visibility="{Binding Info.IsDefault, Converter={StaticResource BoolToVis}}">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{StaticResource AccentColor}"/>
                                                        </Border.Background>
                                                        <TextBlock Text="DEFAULT" FontSize="10"
                                                                   Foreground="#1A1A2E" FontWeight="Bold"/>
                                                    </Border>

                                                    <Border Background="{StaticResource SecondaryBrush}"
                                                            CornerRadius="3"
                                                            Padding="6,1"
                                                            Margin="4,0,0,0"
                                                            Visibility="{Binding Info.IsEmbeddingModel, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="EMBEDDING" FontSize="10"
                                                                   Foreground="#1A1A2E" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="{Binding Info.Description}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,2"/>

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                        <Run Text="Size: "/>
                                                        <Run Text="{Binding Info.SizeDisplay, Mode=OneWay}"
                                                             Foreground="{StaticResource SecondaryBrush}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="12,0,0,0">
                                                        <Run Text="Quant: "/>
                                                        <Run Text="{Binding Info.Quantization, Mode=OneWay}"
                                                             Foreground="{StaticResource SecondaryBrush}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="12,0,0,0">
                                                        <Run Text="RAM: ~"/>
                                                        <Run Text="{Binding Info.RamRequiredMB, Mode=OneWay}"
                                                             Foreground="{StaticResource SecondaryBrush}"/>
                                                        <Run Text=" MB"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="12,0,0,0">
                                                        <Run Text="Best for: "/>
                                                        <Run Text="{Binding Info.BestFor, Mode=OneWay}"
                                                             Foreground="{StaticResource AccentBrush}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Download progress bar (shown during download) -->
                                                <StackPanel Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"
                                                            Margin="0,6,0,0">
                                                    <ProgressBar Value="{Binding DownloadProgress}"
                                                                 Maximum="100"
                                                                 Height="6"
                                                                 Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding DownloadStatusText}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="11"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Action buttons -->
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Margin="12,0,0,0">

                                                <!-- Installed indicator -->
                                                <TextBlock Text="Installed"
                                                           Foreground="{StaticResource SuccessBrush}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,4"
                                                           Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"/>

                                                <!-- Download button (only for not-installed, not-downloading) -->
                                                <Button Content="Download"
                                                        Padding="10,4"
                                                        FontSize="12"
                                                        Command="{Binding DataContext.DownloadModelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="0,0,0,4">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Cancel download button -->
                                                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[common.cancel]}"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Padding="10,4"
                                                        FontSize="12"
                                                        Command="{Binding DataContext.CancelDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"
                                                        Margin="0,0,0,4"/>

                                                <!-- Delete button (installed, not active, not embedding) -->
                                                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[common.delete]}"
                                                        Padding="10,4"
                                                        FontSize="12"
                                                        Command="{Binding DataContext.DeleteModelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsInstalled}" Value="True"/>
                                                                        <Condition Binding="{Binding IsActive}" Value="False"/>
                                                                        <Condition Binding="{Binding Info.IsEmbeddingModel}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ── SEPARATOR ── -->
                        <Separator Margin="0,16,0,8"/>

                        <!-- ── LLM SETTINGS SECTION ── -->
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[settings.llm]}"
                                   Style="{StaticResource SubheadingTextStyle}"
                                   Margin="0,8,0,16"/>

                        <TextBlock Text="Model Path:"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,8"/>
                        <TextBox Text="{Binding ModelPath, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Context Size:"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,8"/>
                                <TextBox Text="{Binding ContextSize, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="GPU Layers:"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,8"/>
                                <TextBox Text="{Binding GpuLayers, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Temperature:"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0"
                                        Value="{Binding Temperature}"
                                        Minimum="0" Maximum="2"
                                        TickFrequency="0.1"
                                        IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Temperature, StringFormat='{}{0:F1}'}"
                                           Foreground="{StaticResource SecondaryBrush}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- ── SEPARATOR ── -->
                        <Separator Margin="0,4,0,8"/>

                        <!-- ── SYSTEM PROMPT EDITOR ── -->
                        <TextBlock Text="System Prompt"
                                   Style="{StaticResource SubheadingTextStyle}"
                                   Margin="0,8,0,8"/>

                        <TextBlock Text="Customize the AI personality and instructions. Leave empty to use the default SyntheticAI persona."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <TextBox Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="160"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,8"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======== SECURITY TAB ======== -->
            <TabItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[settings.security]}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[settings.security]}"
                                   Style="{StaticResource SubheadingTextStyle}"
                                   Margin="0,0,0,16"/>

                        <CheckBox Content="Enable remote access detection"
                                  IsChecked="{Binding EnableRemoteAccessDetection}"
                                  Margin="0,0,0,12"/>

                        <CheckBox Content="Enable Bad USB detection"
                                  IsChecked="{Binding EnableBadUsbDetection}"
                                  Margin="0,0,0,12"/>

                        <CheckBox Content="Enable AI-based detection"
                                  IsChecked="{Binding EnableAiDetection}"
                                  Margin="0,0,0,12"/>

                        <CheckBox Content="Enable registry watcher"
                                  IsChecked="{Binding EnableRegistryWatcher}"
                                  Margin="0,0,0,12"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======== FAQ TAB ======== -->
            <TabItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[nav.faq]}" DataContext="{Binding FaqVm}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Frequently Asked Questions"
                                   Style="{StaticResource SubheadingTextStyle}"
                                   Margin="0,0,0,16"/>

                        <!-- Ask Question Section -->
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Ask a Question"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <TextBox Text="{Binding QuestionText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="60"
                                         Margin="0,0,0,8"/>
                                <Button Content="Submit Question"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding AskQuestionCommand}"
                                        HorizontalAlignment="Right"
                                        Padding="16,8"/>
                            </StackPanel>
                        </Border>

                        <!-- Refresh Button -->
                        <Button Content="Refresh FAQ"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding LoadFaqCommand}"
                                HorizontalAlignment="Left"
                                Padding="12,6"
                                Margin="0,0,0,16"/>

                        <!-- FAQ List -->
                        <ItemsControl ItemsSource="{Binding FaqItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Question}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontSize="15" FontWeight="Bold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding AnswerDisplay}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="14" Margin="0,6,0,0"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding MetadataDisplay}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Status -->
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom action bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Shutdown App"
                    Style="{StaticResource DangerButtonStyle}"
                    Command="{Binding ShutdownAppCommand}"
                    Margin="0,0,12,0"
                    ToolTip="Completely exit the application"/>
            <Button Content="Reset Defaults"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ResetDefaultsCommand}"
                    Margin="0,0,12,0"/>
            <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[settings.save]}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SaveSettingsCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
