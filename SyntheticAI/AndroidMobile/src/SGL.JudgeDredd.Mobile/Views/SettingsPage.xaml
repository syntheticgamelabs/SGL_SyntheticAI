<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SGL.JudgeDredd.Mobile.ViewModels"
             x:Class="SGL.JudgeDredd.Mobile.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <Label Text="SETTINGS"
                   Style="{StaticResource NeonTitleLabel}"
                   Margin="0,8,0,4" />

            <!-- Account Section -->
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Account"
                           TextColor="{StaticResource AccentColor}"
                           FontSize="16"
                           FontAttributes="Bold" />

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Logged in as"
                               Style="{StaticResource MutedLabel}" />
                        <Label Text="{Binding Username}"
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>

                    <Button Text="Logout"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource DangerButton}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Server Section -->
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Server Connection"
                           TextColor="{StaticResource AccentColor}"
                           FontSize="16"
                           FontAttributes="Bold" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Server URL"
                               Style="{StaticResource MutedLabel}" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{StaticResource SurfaceLightColor}"
                                BackgroundColor="{StaticResource BackgroundColor}"
                                Padding="12,4">
                            <Entry Text="{Binding ServerUrl}"
                                   Placeholder="https://syntheticgamelabs.dpdns.org"
                                   PlaceholderColor="{StaticResource TextMutedColor}"
                                   TextColor="{StaticResource TextColor}"
                                   BackgroundColor="Transparent"
                                   FontSize="14"
                                   Keyboard="Url" />
                        </Border>
                    </VerticalStackLayout>

                    <Button Text="Test Connection"
                            Command="{Binding TestConnectionCommand}"
                            Style="{StaticResource SecondaryButton}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                </VerticalStackLayout>
            </Frame>

            <!-- LLM Model Selection -->
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="LLM Model"
                           TextColor="{StaticResource AccentColor}"
                           FontSize="16"
                           FontAttributes="Bold" />

                    <Label Text="Select the AI model for chat and threat analysis."
                           Style="{StaticResource MutedLabel}" />

                    <Picker ItemsSource="{Binding DownloadedModels}"
                            SelectedItem="{Binding SelectedLlmModel}"
                            TextColor="{StaticResource TextColor}"
                            BackgroundColor="{StaticResource BackgroundColor}"
                            FontSize="14"
                            Title="Select a downloaded model" />

                    <Button Text="Refresh Models"
                            Command="{Binding LoadModelsCommand}"
                            Style="{StaticResource SecondaryButton}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                </VerticalStackLayout>
            </Frame>

            <!-- LLM Model Download -->
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Download LLM Model"
                           TextColor="{StaticResource AccentColor}"
                           FontSize="16"
                           FontAttributes="Bold" />

                    <Label Text="Download a model from the server. Larger models provide better analysis but use more storage and RAM."
                           Style="{StaticResource MutedLabel}" />

                    <!-- Model Picker showing DisplayName + Size -->
                    <Picker ItemsSource="{Binding AvailableModels}"
                            SelectedItem="{Binding SelectedDownloadModel}"
                            ItemDisplayBinding="{Binding PickerDisplay}"
                            TextColor="{StaticResource TextColor}"
                            BackgroundColor="{StaticResource BackgroundColor}"
                            FontSize="14"
                            Title="Select model to download" />

                    <!-- Selected Model Details -->
                    <Label Text="{Binding SelectedModelDescription}"
                           Style="{StaticResource MutedLabel}"
                           FontSize="12"
                           LineBreakMode="WordWrap"
                           IsVisible="{Binding SelectedModelDescription, Converter={StaticResource IsNotNullOrEmptyConverter}}" />

                    <!-- Download / Cancel Buttons -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Text="Download Model"
                                Command="{Binding DownloadModelCommand}"
                                Style="{StaticResource PrimaryButton}"
                                IsVisible="{Binding IsDownloading, Converter={StaticResource InvertedBoolConverter}}" />
                        <Button Grid.Column="0"
                                Text="Cancel Download"
                                Command="{Binding CancelDownloadCommand}"
                                Style="{StaticResource DangerButton}"
                                IsVisible="{Binding IsDownloading}" />
                    </Grid>

                    <!-- Download Progress -->
                    <VerticalStackLayout Spacing="4"
                                         IsVisible="{Binding IsDownloading}">
                        <ProgressBar Progress="{Binding DownloadProgress}"
                                     ProgressColor="{StaticResource AccentColor}"
                                     HeightRequest="8" />
                        <Label Text="{Binding DownloadStatus}"
                               Style="{StaticResource MutedLabel}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Download Status (when not downloading) -->
                    <Label Text="{Binding DownloadStatus}"
                           Style="{StaticResource MutedLabel}"
                           HorizontalTextAlignment="Center"
                           IsVisible="{Binding IsDownloading, Converter={StaticResource InvertedBoolConverter}}" />

                    <!-- Downloaded Models List -->
                    <VerticalStackLayout Spacing="4"
                                         IsVisible="{Binding DownloadedModels.Count, Converter={StaticResource IsNotZeroConverter}}">
                        <Label Text="Downloaded Models:"
                               TextColor="{StaticResource TextColor}"
                               FontSize="13"
                               FontAttributes="Bold" />
                        <CollectionView ItemsSource="{Binding DownloadedModels}"
                                         HeightRequest="80">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding .}"
                                           TextColor="{StaticResource GreenColor}"
                                           FontSize="12"
                                           Padding="8,2" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Preferences Section -->
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Preferences"
                           TextColor="{StaticResource AccentColor}"
                           FontSize="16"
                           FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                          RowSpacing="12">

                        <Label Grid.Row="0" Grid.Column="0"
                               Text="Push Notifications"
                               Style="{StaticResource BodyLabel}"
                               VerticalTextAlignment="Center" />
                        <Switch Grid.Row="0" Grid.Column="1"
                                IsToggled="{Binding NotificationsEnabled}"
                                VerticalOptions="Center" />

                        <Label Grid.Row="1" Grid.Column="0"
                               Text="Text-to-Speech"
                               Style="{StaticResource BodyLabel}"
                               VerticalTextAlignment="Center" />
                        <Switch Grid.Row="1" Grid.Column="1"
                                IsToggled="{Binding TtsEnabled}"
                                VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Language Selection -->
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Language"
                           TextColor="{StaticResource AccentColor}"
                           FontSize="16"
                           FontAttributes="Bold" />

                    <Label Text="Select the display language for the app."
                           Style="{StaticResource MutedLabel}" />

                    <Picker ItemsSource="{Binding SupportedLanguages}"
                            SelectedItem="{Binding SelectedLanguage}"
                            TextColor="{StaticResource TextColor}"
                            BackgroundColor="{StaticResource BackgroundColor}"
                            FontSize="14"
                            Title="Select language" />
                </VerticalStackLayout>
            </Frame>

            <!-- AI Chat Settings -->
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="AI Chat Settings"
                           TextColor="{StaticResource AccentColor}"
                           FontSize="16"
                           FontAttributes="Bold" />

                    <Label Text="Customize your AI assistant's personality and behavior."
                           Style="{StaticResource MutedLabel}" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Assistant Name"
                               Style="{StaticResource MutedLabel}" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{StaticResource SurfaceLightColor}"
                                BackgroundColor="{StaticResource BackgroundColor}"
                                Padding="12,4">
                            <Entry Text="{Binding AiAssistantName}"
                                   Placeholder="SyntheticAI"
                                   PlaceholderColor="{StaticResource TextMutedColor}"
                                   TextColor="{StaticResource TextColor}"
                                   BackgroundColor="Transparent"
                                   FontSize="14" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Custom System Prompt (optional)"
                               Style="{StaticResource MutedLabel}" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="{StaticResource SurfaceLightColor}"
                                BackgroundColor="{StaticResource BackgroundColor}"
                                Padding="12,4">
                            <Editor Text="{Binding AiSystemPrompt}"
                                    Placeholder="Leave empty for default. Set a custom role, personality, or instructions for the AI..."
                                    PlaceholderColor="{StaticResource TextMutedColor}"
                                    TextColor="{StaticResource TextColor}"
                                    BackgroundColor="Transparent"
                                    FontSize="13"
                                    HeightRequest="100"
                                    AutoSize="TextChanges" />
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Creative Mode"
                                   Style="{StaticResource BodyLabel}" />
                            <Label Text="Enables storytelling, role play, poetry, and imaginative responses"
                                   Style="{StaticResource MutedLabel}"
                                   FontSize="11" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding AiCreativeMode}"
                                VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Save Button -->
            <Button Text="Save Settings"
                    Command="{Binding SaveSettingsCommand}"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

            <!-- Status Message -->
            <Label Text="{Binding StatusMessage}"
                   TextColor="{StaticResource GreenColor}"
                   FontSize="14"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}" />

            <!-- Loading -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

            <!-- Shut Down App -->
            <Button Text="Shut Down App"
                    Command="{Binding ShutdownAppCommand}"
                    BackgroundColor="{StaticResource RedColor}"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="48"
                    Margin="0,8,0,0" />

            <!-- Help & About Section -->
            <Frame Style="{StaticResource CardFrame}"
                   Margin="0,8,0,0">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Help &amp; About"
                           TextColor="{StaticResource AccentColor}"
                           FontSize="16"
                           FontAttributes="Bold" />

                    <VerticalStackLayout Spacing="8"
                                         HorizontalOptions="Center">
                        <Label Text="SGL SyntheticAI"
                               TextColor="{StaticResource AccentColor}"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />

                        <Label Text="{Binding VersionDisplay}"
                               TextColor="{StaticResource TextColor}"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />

                        <Label Text="Security Suite Mobile Companion"
                               Style="{StaticResource MutedLabel}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource SurfaceLightColor}" Margin="0,4" />

                    <Label Text="Features"
                           TextColor="{StaticResource TextColor}"
                           FontSize="14"
                           FontAttributes="Bold" />

                    <Label TextColor="{StaticResource TextMutedColor}"
                           FontSize="12"
                           LineBreakMode="WordWrap"
                           Text="Dashboard - Real-time server status, threat alerts, and admin broadcast messages.&#10;&#10;Threat Scanner - Scan installed apps for known malware, spyware, and suspicious permissions. Kill or remove detected threats.&#10;&#10;AI Chat - Chat with your AI assistant powered by local or server LLM models. Supports general conversation, creative writing, role play, threat analysis, and slash commands (/models, /switch, /analyze, /learn, /sync).&#10;&#10;Bluetooth Scanner - Scan for nearby BLE devices, analyze signal strength and device types, connect to devices, and broadcast messages.&#10;&#10;WiFi Scanner - Discover nearby WiFi networks, test connections, check security ratings, view external IP and DNS, and run network traceroutes.&#10;&#10;Telemetry Scanner - Detect apps that collect audio, camera, location, and other telemetry data. Kill suspicious data collectors or open their settings.&#10;&#10;Device Protection - Monitor which apps have microphone and camera access. Kill apps or manage their permissions directly.&#10;&#10;QR Share - Generate QR codes with download links for the mobile APK, desktop client, and Linux client to share with other users.&#10;&#10;Git Repos - Search GitHub repositories, browse code, download repos locally, and participate in broadcast chat.&#10;&#10;Settings - Configure server connection, LLM model selection, download new models, set AI assistant personality, and manage preferences." />

                    <BoxView HeightRequest="1" Color="{StaticResource SurfaceLightColor}" Margin="0,4" />

                    <Label Text="Created By"
                           TextColor="{StaticResource TextColor}"
                           FontSize="14"
                           FontAttributes="Bold" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Synthetic Game Labs"
                               TextColor="{StaticResource TextColor}"
                               FontSize="13" />
                        <Label Text="syntheticgamelabs.dpdns.org"
                               TextColor="{StaticResource AccentColor}"
                               FontSize="12" />
                        <Label Text="SGL SyntheticAI is a comprehensive security suite designed to protect your devices from malware, spyware, telemetry abuse, and network threats using AI-powered analysis."
                               TextColor="{StaticResource TextMutedColor}"
                               FontSize="12"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource SurfaceLightColor}" Margin="0,4" />

                    <Button Text="View FAQ"
                            Command="{Binding GoToFaqCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,4" />

                    <BoxView HeightRequest="1" Color="{StaticResource SurfaceLightColor}" Margin="0,4" />

                    <Label Text="Disclaimer"
                           TextColor="{StaticResource RedColor}"
                           FontSize="14"
                           FontAttributes="Bold" />

                    <Label Text="This software is provided as-is without warranty of any kind. Synthetic Game Labs is not liable for any damages arising from the use of this software. Threat detection is based on heuristic analysis and known signatures; no security tool can guarantee 100% detection. Users are responsible for verifying scan results before taking action. Killing system processes or uninstalling apps may affect device functionality. Use at your own risk. By using this app, you acknowledge that AI-generated analysis may contain inaccuracies and should not be the sole basis for security decisions."
                           TextColor="{StaticResource TextMutedColor}"
                           FontSize="11"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Frame>

            <!-- Bottom spacing -->
            <BoxView HeightRequest="20" Color="Transparent" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
