<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SGL.JudgeDredd.Mobile.ViewModels"
             x:Class="SGL.JudgeDredd.Mobile.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="{StaticResource BackgroundColor}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="32,60,32,32"
                             VerticalOptions="Center">

            <!-- App Logo / Title -->
            <Image Source="logo.png"
                   HeightRequest="80"
                   WidthRequest="80"
                   HorizontalOptions="Center"
                   Aspect="AspectFit" />

            <Label Text="SGL-AI"
                   TextColor="{StaticResource AccentColor}"
                   FontSize="42"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />

            <Label Text="SyntheticAI"
                   TextColor="{StaticResource TextColor}"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   Margin="0,-8,0,0" />

            <!-- Version Display -->
            <Label Text="{Binding VersionDisplay}"
                   TextColor="{StaticResource AccentColor}"
                   FontSize="16"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,16" />

            <!-- Error Message -->
            <Frame BackgroundColor="#44F38BA8"
                   BorderColor="{StaticResource RedColor}"
                   CornerRadius="8"
                   Padding="12"
                   IsVisible="{Binding HasError}"
                   HasShadow="False">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource RedColor}"
                       FontSize="14"
                       HorizontalTextAlignment="Center" />
            </Frame>

            <!-- Username -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Username"
                       TextColor="{StaticResource TextMutedColor}"
                       FontSize="13" />
                <Border StrokeShape="RoundRectangle 8"
                        Stroke="{StaticResource SurfaceLightColor}"
                        BackgroundColor="{StaticResource SurfaceColor}"
                        Padding="12,4">
                    <Entry Text="{Binding Username}"
                           Placeholder="Enter username"
                           PlaceholderColor="{StaticResource TextMutedColor}"
                           TextColor="{StaticResource TextColor}"
                           BackgroundColor="Transparent"
                           FontSize="16"
                           Keyboard="Default" />
                </Border>
            </VerticalStackLayout>

            <!-- Password -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Password"
                       TextColor="{StaticResource TextMutedColor}"
                       FontSize="13" />
                <Border StrokeShape="RoundRectangle 8"
                        Stroke="{StaticResource SurfaceLightColor}"
                        BackgroundColor="{StaticResource SurfaceColor}"
                        Padding="12,4">
                    <Entry Text="{Binding Password}"
                           Placeholder="Enter password"
                           PlaceholderColor="{StaticResource TextMutedColor}"
                           TextColor="{StaticResource TextColor}"
                           BackgroundColor="Transparent"
                           FontSize="16"
                           IsPassword="True" />
                </Border>
            </VerticalStackLayout>

            <!-- Remember Me -->
            <HorizontalStackLayout Spacing="8" Margin="4,0,0,0">
                <CheckBox IsChecked="{Binding RememberMe}"
                          Color="{StaticResource AccentColor}" />
                <Label Text="Remember me"
                       TextColor="{StaticResource TextMutedColor}"
                       FontSize="14"
                       VerticalTextAlignment="Center" />
            </HorizontalStackLayout>

            <!-- Login Button -->
            <Button Text="Login"
                    Command="{Binding LoginCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,8,0,0"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

            <!-- Register Button -->
            <Button Text="Register New Account"
                    Command="{Binding RegisterCommand}"
                    Style="{StaticResource SecondaryButton}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource AccentColor}"
                               HeightRequest="32"
                               WidthRequest="32"
                               HorizontalOptions="Center" />

            <!-- Server URL -->
            <VerticalStackLayout Spacing="4" Margin="0,16,0,0">
                <Label Text="Server URL"
                       TextColor="{StaticResource TextMutedColor}"
                       FontSize="13" />
                <Border StrokeShape="RoundRectangle 8"
                        Stroke="{StaticResource SurfaceLightColor}"
                        BackgroundColor="{StaticResource SurfaceColor}"
                        Padding="12,4">
                    <Entry Text="{Binding ServerUrl}"
                           Placeholder="https://syntheticgamelabs.dpdns.org"
                           PlaceholderColor="{StaticResource TextMutedColor}"
                           TextColor="{StaticResource TextMutedColor}"
                           BackgroundColor="Transparent"
                           FontSize="13"
                           Keyboard="Url" />
                </Border>
            </VerticalStackLayout>

            <!-- Footer -->
            <Label Text="Synthetic Game Labs"
                   TextColor="{StaticResource TextMutedColor}"
                   FontSize="12"
                   HorizontalTextAlignment="Center"
                   Margin="0,16,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
