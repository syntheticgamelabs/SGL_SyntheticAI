<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SGL.JudgeDredd.Mobile.ViewModels"
             xmlns:models="clr-namespace:SGL.JudgeDredd.Mobile.Models"
             x:Class="SGL.JudgeDredd.Mobile.Views.ChatPage"
             x:DataType="vm:ChatViewModel"
             Title="AI Assistant"
             BackgroundColor="{StaticResource BackgroundColor}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="0">

        <!-- Header -->
        <Grid Grid.Row="0" Padding="16,12"
              BackgroundColor="{StaticResource SurfaceColor}"
              ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
            <Label Grid.Column="0"
                   Text="SyntheticAI"
                   TextColor="{StaticResource AccentColor}"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalTextAlignment="Center" />

            <!-- Server/Offline Mode Toggle -->
            <Button Grid.Column="1"
                    Text="{Binding ModeLabel}"
                    Command="{Binding ToggleOfflineModeCommand}"
                    BackgroundColor="{Binding ModeColor}"
                    TextColor="#1A1610"
                    FontSize="10"
                    FontAttributes="Bold"
                    HeightRequest="32"
                    Padding="10,0"
                    CornerRadius="16" />

            <!-- Model Picker Toggle -->
            <Button Grid.Column="2"
                    Text="Model"
                    Command="{Binding ToggleModelPickerCommand}"
                    BackgroundColor="{StaticResource SurfaceLightColor}"
                    TextColor="{StaticResource AccentColor}"
                    FontSize="12"
                    HeightRequest="32"
                    Padding="8,0"
                    CornerRadius="16" />

            <!-- Voice Picker Toggle -->
            <Button Grid.Column="3"
                    Text="{Binding SelectedVoice, StringFormat='Voice: {0}'}"
                    Command="{Binding ToggleVoicePickerCommand}"
                    BackgroundColor="{StaticResource SurfaceLightColor}"
                    TextColor="{StaticResource TextColor}"
                    FontSize="10"
                    HeightRequest="32"
                    Padding="8,0"
                    CornerRadius="16"
                    IsVisible="{Binding TtsEnabled}" />

            <!-- TTS Toggle -->
            <Button Grid.Column="4"
                    Text="{Binding TtsEnabled, Converter={StaticResource BoolToStringConverter}, ConverterParameter='TTS: On|TTS: Off'}"
                    Command="{Binding ToggleTtsCommand}"
                    BackgroundColor="{StaticResource SurfaceLightColor}"
                    TextColor="{StaticResource TextColor}"
                    FontSize="12"
                    HeightRequest="32"
                    Padding="8,0"
                    CornerRadius="16" />

            <!-- Clear Chat -->
            <Button Grid.Column="5"
                    Text="Clear"
                    Command="{Binding ClearChatCommand}"
                    BackgroundColor="{StaticResource SurfaceLightColor}"
                    TextColor="{StaticResource TextMutedColor}"
                    FontSize="12"
                    HeightRequest="32"
                    Padding="8,0"
                    CornerRadius="16" />
        </Grid>

        <!-- Model Picker Dropdown -->
        <Frame Grid.Row="1"
               IsVisible="{Binding ShowModelPicker}"
               BackgroundColor="{StaticResource SurfaceColor}"
               BorderColor="{StaticResource SurfaceLightColor}"
               CornerRadius="0"
               Padding="12,8"
               HasShadow="False">
            <VerticalStackLayout Spacing="8">
                <Label Text="Select LLM Model"
                       TextColor="{StaticResource AccentColor}"
                       FontSize="13"
                       FontAttributes="Bold" />
                <Label Text="Different models have different strengths. Larger models are more accurate but slower."
                       TextColor="{StaticResource TextMutedColor}"
                       FontSize="11" />
                <Picker ItemsSource="{Binding AvailableModels}"
                        SelectedItem="{Binding SelectedModel}"
                        TextColor="{StaticResource TextColor}"
                        BackgroundColor="{StaticResource BackgroundColor}"
                        FontSize="14"
                        Title="Choose model" />
                <Label Text="{Binding ModelInfo}"
                       TextColor="{StaticResource GreenColor}"
                       FontSize="11"
                       IsVisible="{Binding ModelInfo, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
            </VerticalStackLayout>
        </Frame>

        <!-- Voice Picker Dropdown -->
        <Frame Grid.Row="1"
               IsVisible="{Binding ShowVoicePicker}"
               BackgroundColor="{StaticResource SurfaceColor}"
               BorderColor="{StaticResource SurfaceLightColor}"
               CornerRadius="0"
               Padding="12,8"
               HasShadow="False">
            <VerticalStackLayout Spacing="8">
                <Label Text="Select TTS Voice"
                       TextColor="{StaticResource AccentColor}"
                       FontSize="13"
                       FontAttributes="Bold" />
                <Label Text="Choose a voice for SyntheticAI's speech. Requires TTS server (Qwen3-TTS)."
                       TextColor="{StaticResource TextMutedColor}"
                       FontSize="11" />
                <Picker ItemsSource="{Binding AvailableVoices}"
                        SelectedItem="{Binding SelectedVoice}"
                        TextColor="{StaticResource TextColor}"
                        BackgroundColor="{StaticResource BackgroundColor}"
                        FontSize="14"
                        Title="Choose voice" />
            </VerticalStackLayout>
        </Frame>

        <!-- Messages List -->
        <CollectionView Grid.Row="2"
                         ItemsSource="{Binding Messages}"
                         x:Name="MessagesList"
                         Margin="8,0"
                         ItemsUpdatingScrollMode="KeepLastItemInView">

            <CollectionView.EmptyView>
                <Label Text="Start a conversation..."
                       Style="{StaticResource MutedLabel}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       Margin="0,40,0,0" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ChatMessageModel">
                    <Grid Padding="8,4">
                        <!-- User Message (right-aligned) -->
                        <Frame IsVisible="{Binding IsUser}"
                               BackgroundColor="{StaticResource AccentColor}"
                               BorderColor="Transparent"
                               CornerRadius="16"
                               Padding="14,10"
                               HasShadow="False"
                               HorizontalOptions="End"
                               MaximumWidthRequest="300">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Content}"
                                       TextColor="{StaticResource OverlayColor}"
                                       FontSize="15"
                                       LineBreakMode="WordWrap" />
                                <Label Text="{Binding Timestamp, StringFormat='{0:HH:mm}'}"
                                       TextColor="#66000000"
                                       FontSize="10"
                                       HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Assistant Message (left-aligned) -->
                        <Frame IsVisible="{Binding IsAssistant}"
                               BackgroundColor="{StaticResource SurfaceColor}"
                               BorderColor="Transparent"
                               CornerRadius="16"
                               Padding="14,10"
                               HasShadow="False"
                               HorizontalOptions="Start"
                               MaximumWidthRequest="300">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="SyntheticAI"
                                       TextColor="{StaticResource AccentColor}"
                                       FontSize="11"
                                       FontAttributes="Bold" />
                                <!-- Collapsible thinking section -->
                                <Frame IsVisible="{Binding HasThinking}"
                                       BackgroundColor="{StaticResource BackgroundColor}"
                                       BorderColor="Transparent"
                                       CornerRadius="8"
                                       Padding="10,6"
                                       HasShadow="False"
                                       Margin="0,2,0,4">
                                    <VerticalStackLayout Spacing="2">
                                        <Label TextColor="{StaticResource TextMutedColor}"
                                               FontSize="11"
                                               FontAttributes="Italic">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Thinking: " FontAttributes="Bold" />
                                                    <Span Text="{Binding ThinkingSummary}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label Text="{Binding ThinkingContent}"
                                               TextColor="{StaticResource TextMutedColor}"
                                               FontSize="11"
                                               FontAttributes="Italic"
                                               LineBreakMode="WordWrap"
                                               MaxLines="8"
                                               IsVisible="{Binding IsThinkingExpanded}" />
                                    </VerticalStackLayout>
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=ToggleThinkingCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Frame.GestureRecognizers>
                                </Frame>
                                <!-- Answer text (without thinking tags) -->
                                <Label Text="{Binding DisplayText}"
                                       TextColor="{StaticResource TextColor}"
                                       FontSize="15"
                                       LineBreakMode="WordWrap" />
                                <Label Text="{Binding Timestamp, StringFormat='{0:HH:mm}'}"
                                       TextColor="{StaticResource TextMutedColor}"
                                       FontSize="10"
                                       HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Typing Indicator + TTS Status -->
        <VerticalStackLayout Grid.Row="2" VerticalOptions="End">
            <HorizontalStackLayout IsVisible="{Binding IsSending}"
                                    Padding="16,8"
                                    Spacing="4">
                <Label Text="SyntheticAI is thinking"
                       TextColor="{StaticResource TextMutedColor}"
                       FontSize="12"
                       FontAttributes="Italic" />
                <ActivityIndicator IsRunning="{Binding IsSending}"
                                   Color="{StaticResource AccentColor}"
                                   HeightRequest="16"
                                   WidthRequest="16" />
            </HorizontalStackLayout>
            <HorizontalStackLayout IsVisible="{Binding TtsStatus, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                    Padding="16,4"
                                    Spacing="4">
                <Label Text="{Binding TtsStatus}"
                       TextColor="{StaticResource AccentColor}"
                       FontSize="11"
                       FontAttributes="Italic" />
                <ActivityIndicator IsRunning="True"
                                   Color="{StaticResource AccentColor}"
                                   HeightRequest="12"
                                   WidthRequest="12" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Input Area -->
        <Grid Grid.Row="3"
              BackgroundColor="{StaticResource SurfaceColor}"
              Padding="12,8"
              RowDefinitions="Auto,Auto"
              RowSpacing="4">

            <!-- Image Generation Panel -->
            <Frame Grid.Row="0"
                   IsVisible="{Binding ShowImageGen}"
                   BackgroundColor="{StaticResource BackgroundColor}"
                   BorderColor="{StaticResource AccentColor}"
                   CornerRadius="12"
                   Padding="12"
                   HasShadow="False"
                   Margin="0,0,0,4">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="AI Image Generation"
                               TextColor="{StaticResource AccentColor}"
                               FontSize="14"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="X"
                                Command="{Binding ToggleImageGenCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource TextMutedColor}"
                                FontSize="14" WidthRequest="32" HeightRequest="32" Padding="0" />
                    </Grid>
                    <Entry Text="{Binding ImagePrompt}"
                           Placeholder="Describe the image you want to generate..."
                           PlaceholderColor="{StaticResource TextMutedColor}"
                           TextColor="{StaticResource TextColor}"
                           BackgroundColor="{StaticResource SurfaceColor}"
                           FontSize="13"
                           ReturnCommand="{Binding GenerateImageCommand}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Button Text="Generate Image"
                                Command="{Binding GenerateImageCommand}"
                                BackgroundColor="{StaticResource AccentColor}"
                                TextColor="#1A1610"
                                FontSize="13" FontAttributes="Bold"
                                HeightRequest="38" CornerRadius="8"
                                IsEnabled="{Binding IsGeneratingImage, Converter={StaticResource InvertedBoolConverter}}" />
                        <ActivityIndicator Grid.Column="1"
                                           IsRunning="{Binding IsGeneratingImage}"
                                           IsVisible="{Binding IsGeneratingImage}"
                                           Color="{StaticResource AccentColor}"
                                           HeightRequest="20" WidthRequest="20" />
                    </Grid>
                    <Label Text="{Binding ImageGenStatus}"
                           TextColor="{StaticResource TextMutedColor}"
                           FontSize="11"
                           IsVisible="{Binding ImageGenStatus, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
                    <Image Source="{Binding GeneratedImageUrl}"
                           IsVisible="{Binding HasGeneratedImage}"
                           HeightRequest="200"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>

            <!-- Message Input Row -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="8">

                <!-- Image Gen Toggle Button -->
                <Button Grid.Column="0"
                        Text="IMG"
                        Command="{Binding ToggleImageGenCommand}"
                        BackgroundColor="{StaticResource SurfaceLightColor}"
                        TextColor="{StaticResource AccentColor}"
                        FontSize="10" FontAttributes="Bold"
                        CornerRadius="20"
                        HeightRequest="44" WidthRequest="44"
                        Padding="0" />

                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 20"
                        Stroke="{StaticResource SurfaceLightColor}"
                        BackgroundColor="{StaticResource BackgroundColor}"
                        Padding="16,4">
                    <Entry Text="{Binding MessageText}"
                           Placeholder="Type a message or /help..."
                           PlaceholderColor="{StaticResource TextMutedColor}"
                           TextColor="{StaticResource TextColor}"
                           BackgroundColor="Transparent"
                           FontSize="15"
                           ReturnCommand="{Binding SendMessageCommand}"
                           ReturnType="Send" />
                </Border>

                <Button Grid.Column="2"
                        Text="Send"
                        Command="{Binding SendMessageCommand}"
                        BackgroundColor="{StaticResource AccentColor}"
                        TextColor="{StaticResource OverlayColor}"
                        FontAttributes="Bold"
                        CornerRadius="20"
                        HeightRequest="44"
                        WidthRequest="70"
                        FontSize="14"
                        IsEnabled="{Binding IsSending, Converter={StaticResource InvertedBoolConverter}}" />
            </Grid>
        </Grid>

    </Grid>

</ContentPage>
