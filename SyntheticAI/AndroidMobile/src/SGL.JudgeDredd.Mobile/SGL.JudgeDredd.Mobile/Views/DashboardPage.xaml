<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SGL.JudgeDredd.Mobile.ViewModels"
             x:Class="SGL.JudgeDredd.Mobile.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="Dashboard"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <!-- Header with NewLogo -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,8,0,0">
                <Image Source="logo.png"
                       HeightRequest="80"
                       WidthRequest="80"
                       HorizontalOptions="Center"
                       Aspect="AspectFit" />
                <Label Text="SYNTHETICAI"
                       Style="{StaticResource NeonTitleLabel}" />
                <Label Text="AI Security Suite"
                       Style="{StaticResource MutedLabel}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Admin Broadcast Banner -->
            <Frame IsVisible="{Binding HasBroadcast}"
                   BorderColor="{StaticResource AccentColor}"
                   BackgroundColor="#1AD4A017"
                   CornerRadius="8"
                   Padding="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Admin Broadcast"
                               TextColor="{StaticResource AccentColor}"
                               FontSize="12"
                               FontAttributes="Bold" />
                        <Label Text="{Binding BroadcastMessage}"
                               TextColor="{StaticResource TextColor}"
                               FontSize="14"
                               LineBreakMode="WordWrap" />
                        <Label Text="{Binding BroadcastSentBy, StringFormat='- {0}'}"
                               TextColor="{StaticResource TextMutedColor}"
                               FontSize="11" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            Text="X"
                            Command="{Binding DismissBroadcastCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource TextMutedColor}"
                            FontSize="14"
                            WidthRequest="36"
                            HeightRequest="36"
                            Padding="0"
                            VerticalOptions="Start" />
                </Grid>
            </Frame>

            <!-- Connection Status Card -->
            <Frame Style="{StaticResource CardFrame}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <!-- Status Dot -->
                    <Ellipse Grid.Column="0"
                             WidthRequest="14"
                             HeightRequest="14"
                             VerticalOptions="Center"
                             Fill="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}" />

                    <VerticalStackLayout Grid.Column="1" Spacing="2"
                                         VerticalOptions="Center">
                        <Label Text="{Binding ConnectionStatus}"
                               Style="{StaticResource BodyLabel}"
                               FontAttributes="Bold" />
                        <Label Text="{Binding ServerUrl}"
                               Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>

                    <Button Grid.Column="2"
                            Text="Refresh"
                            Command="{Binding RefreshStatusCommand}"
                            Style="{StaticResource SecondaryButton}"
                            HeightRequest="36"
                            FontSize="13"
                            Padding="12,0"
                            VerticalOptions="Center" />
                </Grid>
            </Frame>

            <!-- Server Info Card -->
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Server Information"
                           TextColor="{StaticResource AccentColor}"
                           FontSize="16"
                           FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="8" ColumnSpacing="16">

                        <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                            <Label Text="Version" Style="{StaticResource MutedLabel}" />
                            <Label Text="{Binding ServerVersion}"
                                   Style="{StaticResource BodyLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                            <Label Text="Online Clients" Style="{StaticResource MutedLabel}" />
                            <Label Text="{Binding OnlineClients}"
                                   Style="{StaticResource BodyLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                            <Label Text="Signatures" Style="{StaticResource MutedLabel}" />
                            <Label Text="{Binding SignatureVersion}"
                                   Style="{StaticResource BodyLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                            <Label Text="Sig Count" Style="{StaticResource MutedLabel}" />
                            <Label Text="{Binding SignatureCount}"
                                   Style="{StaticResource BodyLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="2" Grid.Column="0">
                            <Label Text="LLM Model" Style="{StaticResource MutedLabel}" />
                            <Label Text="{Binding LlmModelName}"
                                   Style="{StaticResource BodyLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="2" Grid.Column="1">
                            <Label Text="LLM Status" Style="{StaticResource MutedLabel}" />
                            <Label Text="{Binding LlmAvailable, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Available|Offline'}"
                                   Style="{StaticResource BodyLabel}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- LLM Local Status / Download Prompt -->
            <Frame IsVisible="{Binding ShowLlmDownloadPrompt}"
                   BorderColor="{StaticResource YellowColor}"
                   BackgroundColor="#1AE5C07B"
                   CornerRadius="8"
                   Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding LlmLocalStatus}"
                           TextColor="{StaticResource YellowColor}"
                           FontSize="13"
                           FontAttributes="Bold" />
                    <Button Text="Download LLM Model"
                            Command="{Binding GoToLlmDownloadCommand}"
                            Style="{StaticResource PrimaryButton}"
                            HeightRequest="36"
                            FontSize="13" />
                </VerticalStackLayout>
            </Frame>

            <!-- Protection Status Card -->
            <Frame Style="{StaticResource CardFrame}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="4"
                                         VerticalOptions="Center">
                        <Label Text="Real-Time Protection"
                               Style="{StaticResource BodyLabel}"
                               FontAttributes="Bold" />
                        <Label Text="{Binding ProtectionEnabled, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Protection Active|Protection Disabled'}"
                               TextColor="{Binding ProtectionEnabled, Converter={StaticResource BoolToColorConverter}}"
                               FontSize="13" />
                    </VerticalStackLayout>

                    <Switch Grid.Column="1"
                            IsToggled="{Binding ProtectionEnabled}"
                            VerticalOptions="Center" />
                </Grid>
            </Frame>

            <!-- Threat Summary Card -->
            <Frame Style="{StaticResource CardFrame}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <VerticalStackLayout Grid.Column="0" Spacing="4"
                                         HorizontalOptions="Center">
                        <Label Text="{Binding ThreatsBlocked}"
                               TextColor="{StaticResource GreenColor}"
                               FontSize="36"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Threats Blocked"
                               Style="{StaticResource MutedLabel}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="4"
                                         HorizontalOptions="Center">
                        <Label Text="{Binding LastScanTime}"
                               TextColor="{StaticResource TextColor}"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Last Scan"
                               Style="{StaticResource MutedLabel}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <!-- Quick Actions -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,8,0,0">
                <Button Grid.Column="0" Text="Quick Scan"
                        Command="{Binding QuickScanCommand}"
                        Style="{StaticResource PrimaryButton}" />
                <Button Grid.Column="1" Text="AI Chat"
                        Command="{Binding GoToChatCommand}"
                        Style="{StaticResource SecondaryButton}" />
            </Grid>

            <!-- Security Feature Icons -->
            <Frame Style="{StaticResource CardFrame}" Margin="0,4,0,0">
                <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="8">
                    <Image Grid.Row="0" Grid.Column="0" Source="scan.png" HeightRequest="36" WidthRequest="36" HorizontalOptions="Center" Aspect="AspectFit"/>
                    <Label Grid.Row="1" Grid.Column="0" Text="Scan" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" FontSize="10"/>
                    <Image Grid.Row="0" Grid.Column="1" Source="attack.png" HeightRequest="36" WidthRequest="36" HorizontalOptions="Center" Aspect="AspectFit"/>
                    <Label Grid.Row="1" Grid.Column="1" Text="Threats" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" FontSize="10"/>
                    <Image Grid.Row="0" Grid.Column="2" Source="svd.png" HeightRequest="36" WidthRequest="36" HorizontalOptions="Center" Aspect="AspectFit"/>
                    <Label Grid.Row="1" Grid.Column="2" Text="Protect" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" FontSize="10"/>
                    <Image Grid.Row="0" Grid.Column="3" Source="logo.png" HeightRequest="36" WidthRequest="36" HorizontalOptions="Center" Aspect="AspectFit"/>
                    <Label Grid.Row="1" Grid.Column="3" Text="AI" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" FontSize="10"/>
                </Grid>
            </Frame>

            <!-- Loading -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
